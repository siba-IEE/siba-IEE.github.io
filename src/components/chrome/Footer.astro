---
import { SITE, socialLinks } from '../../lib/site';
import { getLangFromUrl, useTranslations } from '../../lib/i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = 2026;
---

<footer class="border-t border-border bg-surface-2">
  <div class="shell flex flex-col gap-6 py-10 sm:flex-row sm:items-center sm:justify-between">
    <div class="space-y-1">
      <p class="font-display text-sm font-semibold">{SITE.name}</p>
    </div>

    <ul class="flex flex-wrap items-center gap-x-5 gap-y-2">
      {
        socialLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-sm text-text-muted underline-offset-4 transition-colors hover:text-text hover:underline"
              rel={link.key === 'email' ? undefined : 'me noopener'}
              target={link.key === 'email' ? undefined : '_blank'}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="border-t border-border/60">
    <div
      class="shell flex flex-col gap-2 py-4 text-xs text-text-subtle sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {SITE.name}. {t('footer.rights')}.</p>
    </div>
  </div>
</footer>
