---
/**
 * Seul élément fixe de la page : le changement de langue, posé dans le coin de la scène.
 */
import { getLangFromUrl, alternatePath, type Lang } from '../../lib/i18n';

const lang = getLangFromUrl(Astro.url);
const other: Lang = lang === 'fr' ? 'en' : 'fr';
---

<a
  href={alternatePath(Astro.url.pathname, other)}
  hreflang={other}
  aria-label={other === 'en' ? 'English' : 'Français'}
>
  {other.toUpperCase()}
</a>

<style>
  a {
    position: fixed;
    top: 1.25rem;
    right: 1.25rem;
    z-index: 40;
    display: grid;
    place-items: center;
    height: 2.1rem;
    padding-inline: 0.75rem;
    border-radius: 2rem;
    background: rgb(11 12 14 / 60%);
    backdrop-filter: blur(8px);
    color: #fff;
    font-size: 0.8rem;
    transition: background 0.2s ease;
  }

  a:hover {
    background: rgb(11 12 14 / 90%);
  }

  @media (min-width: 1024px) {
    a {
      top: 2rem;
      right: 4rem;
    }
  }
</style>
