---
/**
 * Barre du haut : le nom, les ancres de la page unique et le changement de langue.
 */
import OrcidIcon from '../ui/OrcidIcon.astro';
import LinkedInIcon from '../ui/LinkedInIcon.astro';
import { SITE, orcidUrl } from '../../lib/site';
import { getLangFromUrl, localizePath, alternatePath, type Lang } from '../../lib/i18n';

const lang = getLangFromUrl(Astro.url);
const other: Lang = lang === 'fr' ? 'en' : 'fr';
const home = localizePath('/', lang);

const items =
  lang === 'fr'
    ? [
        ['Parcours', 'parcours'],
        ['Réalisations', 'realisations'],
        ['Recherche', 'recherche'],
        ['Contact', 'contact'],
      ]
    : [
        ['Background', 'parcours'],
        ['Work', 'realisations'],
        ['Research', 'recherche'],
        ['Contact', 'contact'],
      ];
---

<header>
  <nav aria-label={lang === 'fr' ? 'Principale' : 'Main'}>
    <a href={home} class="name">{SITE.name}</a>
    <ul>
      {
        items.map(([label, id]) => (
          <li>
            <a href={`${home}#${id}`}>{label}</a>
          </li>
        ))
      }
    </ul>
    <a href={orcidUrl} target="_blank" rel="me noopener" aria-label="ORCID" class="icon"
      ><OrcidIcon class="size-5" /></a
    >
    <a href={SITE.linkedin} target="_blank" rel="me noopener" aria-label="LinkedIn" class="icon">
      <LinkedInIcon class="size-5" />
    </a>
    <a
      href={alternatePath(Astro.url.pathname, other)}
      hreflang={other}
      class="lang"
      aria-label={other === 'en' ? 'English' : 'Français'}
    >
      {other.toUpperCase()}
    </a>
  </nav>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 40;
    height: 4rem;
    background: #0b0c0e;
    color: #fff;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 100%;
    padding-inline: 1.25rem;
  }

  .name {
    margin-right: auto;
    font-family: var(--font-display);
    font-size: 1.45rem;
  }

  ul {
    display: none;
    gap: 1.75rem;
    margin: 0 1rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.88rem;
  }

  ul a {
    color: rgb(255 255 255 / 65%);
    transition: color 0.2s ease;
  }

  ul a:hover {
    color: #fff;
  }

  .icon {
    display: none;
  }

  .lang {
    display: grid;
    place-items: center;
    height: 2.1rem;
    padding-inline: 0.75rem;
    border: 1px solid rgb(255 255 255 / 25%);
    font-size: 0.82rem;
    transition: background 0.2s ease;
  }

  .lang:hover {
    background: rgb(255 255 255 / 12%);
  }

  @media (min-width: 900px) {
    nav {
      padding-inline: 4rem;
    }

    ul,
    .icon {
      display: flex;
    }
  }
</style>
