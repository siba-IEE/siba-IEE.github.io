---
import ThemeToggle from '../ui/ThemeToggle.astro';
import OrcidIcon from '../ui/OrcidIcon.astro';
import LinkedInIcon from '../ui/LinkedInIcon.astro';
import { SITE, orcidUrl } from '../../lib/site';
import {
  getLangFromUrl,
  useTranslations,
  localizePath,
  alternatePath,
  type UiKey,
  type Lang,
} from '../../lib/i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const other: Lang = lang === 'fr' ? 'en' : 'fr';
const switchHref = alternatePath(Astro.url.pathname, other);

const items: { key: UiKey; href: string }[] = [
  { key: 'nav.about', href: localizePath('/a-propos', lang) },
  { key: 'nav.research', href: localizePath('/travaux', lang) },
  { key: 'nav.projects', href: localizePath('/projets', lang) },
  { key: 'nav.contact', href: localizePath('/contact', lang) },
];

const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header
  class="sticky top-0 z-40 border-b border-border/70 bg-surface/80 backdrop-blur-md supports-[backdrop-filter]:bg-surface/60"
>
  <nav class="shell flex h-16 items-center justify-between gap-4" aria-label="Principale">
    <a href={localizePath('/', lang)} class="group inline-flex items-center gap-2.5" aria-label="Accueil">
      <span
        class="grid size-9 place-items-center rounded-lg bg-brand-700 font-display text-sm font-bold text-white transition-transform group-hover:-rotate-6"
      >
        S
      </span>
      <span class="font-display text-sm font-semibold tracking-tight">Siba Kalivogui</span>
    </a>

    <div class="hidden items-center gap-1 md:flex">
      {
        items.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'rounded-lg px-3 py-2 text-sm transition-colors hover:bg-surface-2',
              isActive(item.href) ? 'font-medium text-text' : 'text-text-muted hover:text-text',
            ]}
          >
            {t(item.key)}
          </a>
        ))
      }
    </div>

    <div class="flex items-center gap-1.5">
      <a
        href={orcidUrl}
        target="_blank"
        rel="me noopener"
        aria-label="ORCID"
        class="hidden size-9 items-center justify-center rounded-lg transition-colors hover:bg-surface-2 md:inline-flex"
      >
        <OrcidIcon class="size-5" />
      </a>
      <a
        href={SITE.linkedin}
        target="_blank"
        rel="me noopener"
        aria-label="LinkedIn"
        class="hidden size-9 items-center justify-center rounded-lg transition-colors hover:bg-surface-2 md:inline-flex"
      >
        <LinkedInIcon class="size-5" />
      </a>
      <span class="mx-0.5 hidden h-5 w-px bg-border md:block" aria-hidden="true"></span>
      <a
        href={switchHref}
        hreflang={other}
        aria-label={t('lang.switch')}
        class="inline-flex h-9 items-center justify-center rounded-lg border border-border px-3 text-sm font-medium text-text-muted transition-colors hover:bg-surface-2 hover:text-text"
      >
        {other.toUpperCase()}
      </a>
      <ThemeToggle />
      <button
        type="button"
        id="nav-toggle"
        class="inline-flex size-9 items-center justify-center rounded-lg border border-border text-text-muted hover:bg-surface-2 md:hidden"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="nav-mobile"
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </nav>

  <div id="nav-mobile" class="hidden border-t border-border px-5 py-2 md:hidden">
    {
      items.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
          class:list={[
            'block rounded-lg px-3 py-2.5 text-sm transition-colors hover:bg-surface-2',
            isActive(item.href) ? 'font-medium text-text' : 'text-text-muted hover:text-text',
          ]}
        >
          {t(item.key)}
        </a>
      ))
    }
  </div>
</header>

<script>
  // Délégation sur document : le menu survit aux transitions de page (View Transitions).
  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement | null;
    const toggle = target?.closest('#nav-toggle');
    if (toggle) {
      const panel = document.getElementById('nav-mobile');
      const open = panel?.classList.toggle('hidden') === false;
      toggle.setAttribute('aria-expanded', String(open));
      return;
    }
    if (target?.closest('#nav-mobile a')) {
      document.getElementById('nav-mobile')?.classList.add('hidden');
      document.getElementById('nav-toggle')?.setAttribute('aria-expanded', 'false');
    }
  });
</script>
