---
interface Props {
  title: string;
  lede?: string;
}

const { title, lede } = Astro.props;
---

<section class="relative overflow-hidden border-b border-border bg-surface">
  <div class="shell relative pt-14 pb-12 sm:pt-24 sm:pb-16">
    <h1 class="font-display text-5xl font-medium text-balance text-heading sm:text-8xl">{title}</h1>
    {lede && <p class="mt-5 max-w-2xl text-lg text-text-muted text-pretty">{lede}</p>}
  </div>
</section>
