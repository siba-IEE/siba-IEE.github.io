---
interface Props {
  title: string;
  lede?: string;
}

const { title, lede } = Astro.props;
---

<section class="relative overflow-hidden bg-brand-900 text-white">
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.1] [background-image:linear-gradient(rgba(255,255,255,0.7)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.7)_1px,transparent_1px)] [background-size:44px_44px] [mask-image:radial-gradient(80%_80%_at_20%_0%,black,transparent)]"
    aria-hidden="true"
  >
  </div>
  <div class="shell relative py-12 sm:py-16">
    <h1 class="font-display text-3xl font-bold tracking-tight text-balance text-white sm:text-4xl">{title}</h1>
    {lede && <p class="mt-3 max-w-2xl text-white/75 text-pretty">{lede}</p>}
  </div>
</section>
