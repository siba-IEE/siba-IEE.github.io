---
interface Props {
  title: string;
  lede?: string;
}

const { title, lede } = Astro.props;
---

<section class="relative overflow-hidden bg-brand-900 text-white">
  <div class="shell relative pt-14 pb-12 sm:pt-24 sm:pb-16">
    <h1 class="font-display text-5xl font-normal text-balance text-white sm:text-7xl">{title}</h1>
    {lede && <p class="mt-5 max-w-2xl text-lg text-white/70 text-pretty">{lede}</p>}
  </div>
</section>
