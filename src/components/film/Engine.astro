---
/**
 * Décor « moteur » : des sources à gauche, un cœur au centre, une sortie à droite. Les
 * données circulent le long des liaisons.
 */
interface Props {
  inputs: string[];
  core: string;
  output: string;
}

const { inputs, core, output } = Astro.props;
const span = 300 / inputs.length;
const rows = inputs.map((label, index) => {
  const y = 30 + span * index + span / 2;
  return { label, y, path: `M176 ${y}C240 ${y} 230 180 292 180` };
});
---

<svg class="engine" viewBox="0 0 640 360" aria-hidden="true">
  {
    rows.map((row, index) => (
      <g style={`--d:${(0.2 + index * 0.18).toFixed(2)}s`}>
        <rect x="16" y={row.y - 17} width="160" height="34" rx="17" />
        <text x="96" y={row.y + 5} text-anchor="middle">
          {row.label}
        </text>
        <path class="link" d={row.path} pathLength="1" />
        <circle r="3.5">
          <animateMotion
            dur="2.4s"
            begin={`${(1.2 + index * 0.45).toFixed(2)}s`}
            repeatCount="indefinite"
            path={row.path}
          />
        </circle>
      </g>
    ))
  }

  {/* Le cœur : trois disques empilés, en perspective isométrique. */}
  <g class="core" style="--d:1s">
    {
      [0, 1, 2].map((level) => (
        <g transform={`translate(0 ${-level * 26})`}>
          <path d="M292 190v20c0 14 96 14 96 0v-20" />
          <ellipse cx="340" cy="190" rx="48" ry="15" />
        </g>
      ))
    }
    <text x="340" y="262" text-anchor="middle">{core}</text>
  </g>

  <g style="--d:1.6s">
    <path class="link" d="M388 180H470" pathLength="1"></path>
    <circle r="3.5">
      <animateMotion dur="1.6s" begin="2.4s" repeatCount="indefinite" path="M388 180H470"
      ></animateMotion>
    </circle>
    <rect x="470" y="158" width="154" height="44" rx="6"></rect>
    <text x="547" y="185" text-anchor="middle">{output}</text>
  </g>
</svg>

<style>
  .engine {
    width: min(100%, 58rem);
    max-height: 100%;
    overflow: visible;
    fill: none;
    stroke: #fff;
    stroke-width: 1.4;
    font-family: var(--font-sans);
    font-size: 13px;
  }

  g[style] {
    animation: appear 0.7s cubic-bezier(0.22, 1, 0.36, 1) var(--d) both;
  }

  @keyframes appear {
    from {
      opacity: 0;
      translate: -12px 0;
    }
  }

  text {
    fill: #fff;
    stroke: none;
  }

  rect {
    fill: rgb(255 255 255 / 6%);
    stroke: rgb(255 255 255 / 55%);
  }

  .link {
    stroke: rgb(127 220 255 / 55%);
    stroke-dasharray: 1;
    animation: draw 1s ease-out calc(var(--d) + 0.3s) both;
  }

  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }
  }

  circle {
    fill: #7fdcff;
    stroke: none;
  }

  .core path,
  .core ellipse {
    fill: #12303a;
    stroke: #7fdcff;
  }

  .core text {
    font-family: var(--font-display);
    font-size: 20px;
  }
</style>
