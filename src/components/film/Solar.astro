---
/**
 * Décor « solaire » : le soleil suit sa course au-dessus d'un champ de modules, la courbe
 * de production se trace et la batterie se charge.
 */
const panels = [0, 1, 2].map((index) => ({ x: 150 + index * 112, y: 236 - index * 14 }));
const arc = 'M40 210C160 -20 480 -20 600 210';
---

<svg class="solar" viewBox="0 0 640 360" aria-hidden="true">
  <path class="course" d={arc}></path>
  <g class="sun">
    <circle r="18"></circle>
    <circle r="30" class="halo"></circle>
    <animateMotion
      dur="9s"
      repeatCount="indefinite"
      path={arc}
      keyPoints="0;1;0"
      keyTimes="0;0.5;1"
      calcMode="linear"></animateMotion>
  </g>

  <path class="ground" d="M60 300 320 344 600 262M110 276 380 318M200 250 470 290"></path>

  {
    panels.map((panel, index) => (
      <g
        class="panel"
        transform={`translate(${panel.x} ${panel.y})`}
        style={`--d:${(0.3 + index * 0.2).toFixed(2)}s`}
      >
        <path d="M0 0 84 -22 108 22 24 46Z" />
        <path class="cells" d="M28 -7 52 37M56 -15 80 30M8 15 92 -7M16 31 100 8" />
        <path d="M30 44v22M96 26v22" />
      </g>
    ))
  }

  <g class="battery" transform="translate(498 286)" style="--d:1.1s">
    <rect width="92" height="40" rx="5"></rect>
    <path d="M92 13h7v14h-7"></path>
    <rect class="charge" x="5" y="5" width="82" height="30" rx="2"></rect>
  </g>

  <g style="--d:1.4s">
    <path class="axis" d="M56 132V60M56 132H228"></path>
    <path class="yield" d="M56 130C100 130 108 66 142 66S184 130 228 130" pathLength="1"></path>
  </g>
</svg>

<style>
  .solar {
    width: min(100%, 58rem);
    max-height: 100%;
    overflow: visible;
    fill: none;
    stroke: #fff;
    stroke-width: 1.4;
    stroke-linejoin: round;
  }

  .course {
    stroke: rgb(255 255 255 / 22%);
    stroke-dasharray: 3 7;
  }

  .sun circle {
    fill: #ffc266;
    stroke: none;
  }

  .sun .halo {
    fill: rgb(255 194 102 / 22%);
    animation: breathe 2.6s ease-in-out infinite;
  }

  @keyframes breathe {
    50% {
      scale: 1.25;
    }
  }

  .ground {
    stroke: rgb(255 255 255 / 20%);
  }

  g[style] {
    animation: appear 0.8s cubic-bezier(0.22, 1, 0.36, 1) var(--d) both;
  }

  @keyframes appear {
    from {
      opacity: 0;
      translate: 0 14px;
    }
  }

  .panel path:first-child {
    fill: #12303a;
    stroke: #7fdcff;
  }

  .cells {
    stroke: rgb(127 220 255 / 45%);
    stroke-width: 1;
  }

  .charge {
    fill: #7fdcff;
    stroke: none;
    transform-origin: 5px 0;
    animation: charge 9s ease-in-out infinite;
  }

  @keyframes charge {
    0%,
    100% {
      scale: 0.12 1;
    }

    50%,
    70% {
      scale: 1 1;
    }
  }

  .axis {
    stroke: rgb(255 255 255 / 40%);
  }

  .yield {
    stroke: #ffc266;
    stroke-width: 2;
    stroke-dasharray: 1;
    animation: draw 2.4s ease-out 1.6s both;
  }

  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }
  }
</style>
