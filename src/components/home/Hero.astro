---
/**
 * Ouverture de l'accueil : le globe, et un parcours en cinq vues piloté par le défilement
 * (la Terre, l'Afrique de l'Ouest et ses stations, le biais du satellite, la Guinée, puis
 * les projets, épinglés là où ils sont déployés).
 * Le dessin est dans src/scripts/globe.ts. Sans WebGL ou sans JavaScript, une image fixe
 * de la région reste affichée et les légendes se lisent à la suite.
 */
import { SITE } from '../../lib/site';
import { getLangFromUrl, localizePath } from '../../lib/i18n';
import { getProfile, getProjects, statusLabels } from '../../lib/content';
import { STATIONS } from '../../data/stations';
import ProjectSheet from './ProjectSheet.astro';

const lang = getLangFromUrl(Astro.url);
const isFr = lang === 'fr';
const profile = getProfile();
const projects = getProjects().filter((project) => project.geo);

const cities = [
  { name: 'Conakry', lat: 9.51, lon: -13.71 },
  { name: 'Montréal', lat: 45.5, lon: -73.57 },
];

const captions = isFr
  ? [
      '31 stations mesurent le rayonnement solaire au sol, dans 13 pays.',
      'Le satellite surestime ce rayonnement, de plus en plus vers le sud.',
      'La correction a été appliquée à 340 localités de Guinée.',
    ]
  : [
      '31 stations measure solar radiation on the ground, in 13 countries.',
      'The satellite overestimates that radiation, more and more towards the south.',
      'The correction was applied to 340 localities in Guinea.',
    ];
const ui = isFr
  ? {
      scroll: 'Défiler',
      pick: 'Cliquer sur un projet pour l’ouvrir',
      open: 'En savoir plus',
      steps: ['Ouverture', 'Stations', 'Biais', 'Guinée', 'Projets'],
    }
  : {
      scroll: 'Scroll',
      pick: 'Click a project to open it',
      open: 'Learn more',
      steps: ['Opening', 'Stations', 'Bias', 'Guinea', 'Projects'],
    };
const more = isFr ? 'Méthode et résultats' : 'Method and results';
const alt = isFr ? 'L’Afrique de l’Ouest vue de l’espace.' : 'West Africa seen from space.';
const credit = isFr
  ? 'Images NASA Blue Marble et Black Marble'
  : 'NASA Blue Marble and Black Marble imagery';
---

<section class="journey" data-journey data-step="0">
  <div class="stage">
    <div
      class="globe"
      data-globe
      data-day="/images/terre/jour.webp"
      data-night="/images/terre/nuit.webp"
      data-detail="/images/terre/afrique-ouest.webp"
    >
      <img
        class="fallback"
        src="/images/terre/afrique-ouest.webp"
        alt={alt}
        width="4096"
        height="2779"
      />
      <canvas aria-hidden="true"></canvas>
      <svg class="markers" aria-hidden="true">
        {
          STATIONS.map((station, index) => (
            <g class="station" data-lat={station.lat} data-lon={station.lon} style={`--i:${index}`}>
              <circle r="3" />
            </g>
          ))
        }
        {
          projects.map((project) => (
            <g
              class="pin"
              data-pin={project.slug}
              data-sheet-open={project.slug}
              data-lat={project.geo!.lat}
              data-lon={project.geo!.lon}
            >
              <circle class="ring" r="11" />
              <circle r="4.5" />
            </g>
          ))
        }
        {
          cities.map((city) => (
            <g class="city" data-lat={city.lat} data-lon={city.lon}>
              <circle r="4.5" />
              <text x="-11" y="4">
                {city.name}
              </text>
            </g>
          ))
        }
      </svg>
    </div>

    <div class="title">
      <h1>{SITE.name}</h1>
      <p>{isFr ? profile.roleFr : profile.roleEn}</p>
    </div>

    <ol class="captions">
      {
        captions.map((caption, index) => (
          <li data-caption={index + 1}>
            <p>{caption}</p>
            {index === captions.length - 1 && <a href={localizePath('/travaux', lang)}>{more}</a>}
          </li>
        ))
      }
    </ol>
    {
      /* Projets : la liste en bas à gauche, la fiche du projet choisi en haut à droite, le globe entre les deux */
    }
    <div class="projects">
      <p class="hint">{ui.pick}</p>
      <ul>
        {
          projects.map((project) => (
            <li>
              <button
                type="button"
                data-project={project.slug}
                data-sheet-open={project.slug}
                data-geo={JSON.stringify(project.geo)}
              >
                {project.title}
                {project.status !== 'live' && <small>{statusLabels[project.status][lang]}</small>}
              </button>
            </li>
          ))
        }
      </ul>
      {
        projects.map((project) => (
          <button
            type="button"
            class="card"
            data-card={project.slug}
            data-sheet-open={project.slug}
          >
            {project.image && (
              <img src={project.image} alt="" width="1400" height="650" loading="lazy" />
            )}
            <span>{isFr ? project.summaryFr : project.summaryEn}</span>
            <small>
              {project.links?.[0]?.label}
              <b>{ui.open}</b>
            </small>
          </button>
        ))
      }
    </div>
    {/* Couche de repères : où l'on est dans le parcours, et l'invitation à défiler */}
    <ol class="rail">
      {
        ui.steps.map((label, index) => (
          <li>
            <button type="button" data-goto={index} aria-label={label}>
              <span>{label}</span>
            </button>
          </li>
        ))
      }
    </ol>
    <p class="cue" aria-hidden="true">{ui.scroll}</p>
    <p class="credit">{credit}</p>
  </div>

  {/* Piste de défilement : une hauteur d'écran par vue */}
  <div class="track" aria-hidden="true">
    {[0, 1, 2, 3, 4].map(() => <div />)}
  </div>
</section>

<ProjectSheet projects={projects} />

<style>
  /* L'ouverture est une photographie : elle reste sombre dans les deux thèmes. */
  .journey {
    --nav: 4rem;
    --stage: calc(100svh - var(--nav));

    position: relative;
    background: #070707;
    color: #fff;
  }

  .stage {
    position: sticky;
    top: var(--nav);
    height: var(--stage);
    overflow: hidden;
  }

  .track {
    margin-top: calc(-1 * var(--stage));
    pointer-events: none;
  }

  .track div {
    height: var(--stage);
  }

  .globe,
  .globe canvas,
  .globe .fallback,
  .markers {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .globe canvas,
  .markers {
    opacity: 0;
    transition: opacity 1.4s ease;
  }

  .globe .fallback {
    object-fit: cover;
    opacity: 0.5;
    transition: opacity 0.8s ease;
  }

  /* Dès que les images sont chargées, le globe remplace l'image fixe. */
  .globe[data-ready] canvas,
  .globe[data-ready] .markers {
    opacity: 1;
  }

  .globe[data-ready] .fallback {
    opacity: 0;
  }

  /* Repères */
  .markers circle {
    fill: #fff;
    stroke: rgb(0 0 0 / 55%);
    stroke-width: 1;
  }

  .markers .city circle {
    fill: none;
    stroke: #fff;
    stroke-width: 1.5;
  }

  .markers text {
    fill: #fff;
    font-size: 12px;
    font-weight: 500;
    text-anchor: end;
    paint-order: stroke;
    stroke: rgb(0 0 0 / 55%);
    stroke-width: 3px;
  }

  .markers .station,
  .markers .city {
    transition: opacity 0.6s ease;
  }

  .journey[data-step='0'] .station,
  .journey[data-step='4'] .station,
  .journey[data-step='4'] .city {
    opacity: 0;
  }

  /* Épingles des projets */
  .pin {
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .journey[data-step='4'] .pin {
    opacity: 1;
  }

  .markers .pin circle {
    fill: #f50;
    stroke: #fff;
    stroke-width: 1.5;
  }

  .markers .pin .ring {
    fill: none;
    stroke: #fff;
    opacity: 0;
    transform: scale(0.4);
    transition:
      opacity 0.4s ease,
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .markers .pin[data-active] .ring {
    opacity: 1;
    transform: none;
  }

  /* Nom : au centre, en négatif sur le globe */
  .title {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    padding-inline: 1.25rem;
    text-align: center;
    mix-blend-mode: difference;
    pointer-events: none;
    transition:
      opacity 0.6s ease,
      transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .journey:not([data-step='0']) .title {
    opacity: 0;
    transform: scale(1.06);
  }

  h1 {
    margin: 0;
    font-size: clamp(3.4rem, 15vw, 16rem);
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: -0.015em;
    color: #fff;
    white-space: nowrap;
  }

  .title p {
    margin: 1.25rem 0 0;
    font-size: clamp(0.9rem, 1.3vw, 1.15rem);
    color: #fff;
  }

  /* Légendes : une phrase par vue */
  .captions {
    position: absolute;
    inset: auto 1.25rem 3.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .captions li {
    position: absolute;
    bottom: 0;
    max-width: 34rem;
    opacity: 0;
    transform: translateY(1rem);
    transition:
      opacity 0.5s ease,
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
  }

  .journey[data-step='1'] [data-caption='1'],
  .journey[data-step='2'] [data-caption='2'],
  .journey[data-step='3'] [data-caption='3'] {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .captions p {
    margin: 0;
    font-size: clamp(1.4rem, 2.6vw, 2.4rem);
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.015em;
    text-shadow: 0 0 24px rgb(0 0 0 / 70%);
    text-wrap: balance;
  }

  .captions a {
    display: inline-block;
    margin-top: 1rem;
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  /* Projets */
  .projects {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s ease;
  }

  .journey[data-step='4'] .projects {
    opacity: 1;
  }

  .journey[data-step='4'] .projects button,
  .journey[data-step='4'] .projects a {
    pointer-events: auto;
  }

  .projects ul {
    position: absolute;
    inset: auto auto 3.25rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .projects li button {
    display: block;
    padding: 0.1em 0;
    font: inherit;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.5vw, 3.2rem);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -0.015em;
    color: rgb(255 255 255 / 45%);
    text-align: left;
    text-shadow: 0 0 24px rgb(0 0 0 / 70%);
    cursor: pointer;
    transition:
      color 0.3s ease,
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .projects li button:hover,
  .projects li button[aria-pressed='true'] {
    color: #fff;
    transform: translateX(0.35em);
  }

  .projects li small {
    margin-left: 0.8rem;
    font-size: 0.8rem;
    font-weight: 400;
    letter-spacing: 0;
    vertical-align: middle;
  }

  .card {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    display: grid;
    gap: 0.5rem;
    width: min(62vw, 30rem);
    padding: 0.5rem 0.5rem 0.8rem;
    background: rgb(10 10 10 / 82%);
    backdrop-filter: blur(14px);
    color: #fff;
    font-size: 0.9rem;
    line-height: 1.4;
    opacity: 0;
    transform: translateY(1rem);
    visibility: hidden;
    transition:
      opacity 0.4s ease,
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear 0.4s;
  }

  .card[data-open] {
    opacity: 1;
    transform: none;
    visibility: visible;
    transition-delay: 0s;
  }

  .card img {
    width: 100%;
    height: auto;
  }

  .card span,
  .card small {
    padding-inline: 0.4rem;
  }

  .card small {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: rgb(255 255 255 / 65%);
  }

  @media (min-width: 1024px) {
    .projects ul {
      inset: auto auto 4rem 4rem;
    }

    .card {
      top: 3rem;
      right: 4rem;
    }
  }

  .credit {
    position: absolute;
    inset: auto 1.25rem 1rem;
    margin: 0;
    font-size: 0.72rem;
    color: rgb(255 255 255 / 55%);
  }

  @media (min-width: 1024px) {
    .captions {
      inset: auto 4rem 4rem;
    }

    .credit {
      inset: auto 4rem 1.25rem;
    }
  }

  /* Sans JavaScript : pas de parcours, les légendes se lisent à la suite. */
  :global(html:not(.js)) .stage {
    position: static;
    height: auto;
    padding: 6rem 1.25rem;
  }

  :global(html:not(.js)) .title,
  :global(html:not(.js)) .captions,
  :global(html:not(.js)) .captions li,
  :global(html:not(.js)) .credit {
    position: static;
    opacity: 1;
    transform: none;
    mix-blend-mode: normal;
  }

  :global(html:not(.js)) .track {
    display: none;
  }

  /* ---------- Couche de repères ---------- */

  /* Les épingles se cliquent ; le reste des repères laisse passer le pointeur. */
  .markers {
    pointer-events: none;
  }

  .journey[data-step='4'] .pin {
    pointer-events: auto;
    cursor: pointer;
  }

  .markers .station circle {
    transform: scale(0);
    transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
    transition-delay: calc(var(--i) * 28ms);
  }

  .journey:not([data-step='0'], [data-step='4']) .station circle {
    transform: none;
  }

  /* Une onde part de chaque épingle tant qu'aucun projet n'est choisi à cet endroit. */
  .markers .pin .ring {
    opacity: 0.9;
    transform: none;
    animation: ping 2.4s cubic-bezier(0.22, 1, 0.36, 1) infinite;
  }

  .markers .pin[data-active] .ring {
    animation: none;
    stroke-width: 2;
  }

  @keyframes ping {
    from {
      opacity: 0.9;
      transform: scale(0.4);
    }

    to {
      opacity: 0;
      transform: scale(1.8);
    }
  }

  /* Rail : une graduation par vue, à droite */
  .rail {
    position: absolute;
    top: 50%;
    right: 0.5rem;
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    transform: translateY(-50%);
  }

  .rail button {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.6rem;
    width: 100%;
    padding: 0.55rem 0.5rem;
    color: #fff;
    font-size: 0.72rem;
    cursor: pointer;
  }

  .rail button::after {
    content: '';
    width: 0.9rem;
    height: 1.5px;
    background: rgb(255 255 255 / 45%);
    transition:
      width 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      background 0.2s ease;
  }

  .rail span {
    opacity: 0;
    transform: translateX(0.4rem);
    transition:
      opacity 0.25s ease,
      transform 0.3s ease;
    text-shadow: 0 0 12px rgb(0 0 0 / 80%);
  }

  .rail button:hover span,
  .rail button:focus-visible span,
  .rail button[aria-current='step'] span {
    opacity: 1;
    transform: none;
  }

  .rail button[aria-current='step']::after {
    width: 2rem;
    background: #fff;
  }

  /* Invitation à défiler, sous le nom */
  .cue {
    position: absolute;
    bottom: 2.75rem;
    left: 50%;
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    margin: 0;
    font-size: 0.72rem;
    color: #fff;
    transform: translateX(-50%);
    transition: opacity 0.4s ease;
  }

  .cue::after {
    content: '';
    width: 1.5px;
    height: 2.5rem;
    background: #fff;
    transform-origin: top;
    animation: drip 1.8s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  .journey:not([data-step='0']) .cue {
    opacity: 0;
  }

  @keyframes drip {
    0% {
      transform: scaleY(0);
    }

    50% {
      transform: scaleY(1);
      transform-origin: top;
    }

    51% {
      transform-origin: bottom;
    }

    100% {
      transform: scaleY(0);
      transform-origin: bottom;
    }
  }

  /* Le nom arrive lettre par lettre serrée, puis se détend. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .title h1 {
      animation: name-in 1.6s cubic-bezier(0.22, 1, 0.36, 1) both !important;
    }

    :global(.js) .title p {
      animation: fade-up 1s cubic-bezier(0.22, 1, 0.36, 1) 0.5s both;
    }
  }

  @keyframes name-in {
    from {
      opacity: 0;
      letter-spacing: -0.12em;
      transform: scale(1.12);
    }
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(0.8rem);
    }
  }

  /* Projets : consigne, défilement automatique et fiche */
  .hint {
    position: absolute;
    inset: auto auto 3.25rem 1.25rem;
    margin: 0;
    font-size: 0.78rem;
    color: rgb(255 255 255 / 70%);
    transform: translateY(calc(-1 * var(--list-h, 16rem) - 1rem));
  }

  .projects ul {
    display: grid;
    justify-items: start;
  }

  /* Sous le projet affiché, un trait se remplit jusqu'au passage au suivant. */
  .projects li button {
    position: relative;
  }

  .projects li button::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 2px;
    background: #f50;
    transform: scaleX(0);
    transform-origin: left;
  }

  .projects[data-auto] li button[aria-pressed='true']::after {
    animation: fill var(--auto, 5s) linear forwards;
  }

  .projects:not([data-auto]) li button[aria-pressed='true']::after {
    transform: none;
  }

  @keyframes fill {
    to {
      transform: scaleX(1);
    }
  }

  .card img {
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.1s;
  }

  .card[data-open] img {
    clip-path: inset(0);
  }

  .card {
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .card small {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .card b {
    font-family: var(--font-sans);
    font-weight: 500;
    color: #fff;
  }

  .card b::after {
    content: ' +';
  }

  @media (min-width: 1024px) {
    .rail {
      right: 1.5rem;
    }

    .hint {
      inset: auto auto 4rem 4rem;
    }
  }

  @media (max-width: 1023px) {
    .rail span {
      display: none;
    }
  }
</style>

<script>
  import { mountGlobe, VIEW_COUNT, type Globe, type Place } from '../../scripts/globe';

  let globe: Globe | null = null;
  let onScroll: (() => void) | null = null;
  let selected: string | null = null;
  let onHash: (() => void) | null = null;
  let timer = 0;

  const stop = () => {
    globe?.destroy();
    globe = null;
    if (onScroll) window.removeEventListener('scroll', onScroll);
    onScroll = null;
    selected = null;
    window.clearInterval(timer);
    if (onHash) window.removeEventListener('hashchange', onHash);
    onHash = null;
  };

  const init = () => {
    stop();
    const journey = document.querySelector<HTMLElement>('[data-journey]');
    const root = journey?.querySelector<HTMLElement>('[data-globe]');
    if (!journey || !root) return;
    globe = mountGlobe(root);

    // Rail : chaque graduation mène à sa vue.
    const rail = [...journey.querySelectorAll<HTMLButtonElement>('[data-goto]')];
    const goTo = (view: number, behavior: ScrollBehavior) => {
      // La scène se fige sous la barre de navigation : on vise ce point, pas le haut de la section.
      const stage = journey.querySelector<HTMLElement>('.stage');
      const offset = stage ? parseFloat(getComputedStyle(stage).top) || 0 : 0;
      const top = journey.getBoundingClientRect().top + window.scrollY - offset;
      window.scrollTo({ top: top + (view * journey.offsetHeight) / VIEW_COUNT, behavior });
    };
    rail.forEach((button) =>
      button.addEventListener('click', () => goTo(Number(button.dataset.goto), 'smooth')),
    );

    // Le lien « Projets » du menu (#projets) mène à la dernière vue.
    onHash = () => {
      if (location.hash === '#projets') goTo(VIEW_COUNT - 1, 'smooth');
    };
    window.addEventListener('hashchange', onHash);
    // Déjà sur l'accueil avec l'ancre en place, le lien ne change pas l'adresse : on écoute le clic.
    document
      .querySelectorAll<HTMLAnchorElement>('a[href$="#projets"]')
      .forEach((link) => link.addEventListener('click', () => goTo(VIEW_COUNT - 1, 'smooth')));
    if (location.hash === '#projets') requestAnimationFrame(() => goTo(VIEW_COUNT - 1, 'instant'));

    // Une hauteur d'écran de défilement fait passer d'une vue à la suivante.
    onScroll = () => {
      const stage = window.innerHeight - journey.getBoundingClientRect().top;
      const viewHeight = journey.offsetHeight / VIEW_COUNT;
      const progress = Math.min(
        VIEW_COUNT - 1,
        Math.max(0, (stage - window.innerHeight) / viewHeight),
      );
      globe?.setProgress(progress);
      const step = String(Math.round(progress));
      if (journey.dataset.step !== step) {
        journey.dataset.step = step;
        rail.forEach((button) => button.toggleAttribute('aria-current', false));
        rail.find((button) => button.dataset.goto === step)?.setAttribute('aria-current', 'step');
      }
    };
    // Projets : choisir un nom tourne le globe vers son pays et ouvre sa fiche.
    const buttons = [...journey.querySelectorAll<HTMLButtonElement>('[data-project]')];
    const toggle = (selector: string, key: 'card' | 'pin', slug: string | null) =>
      journey
        .querySelectorAll<HTMLElement | SVGElement>(selector)
        .forEach((el) =>
          el.toggleAttribute(
            key === 'card' ? 'data-open' : 'data-active',
            el.dataset[key] === slug,
          ),
        );
    const select = (slug: string | null) => {
      if (slug === selected) return;
      selected = slug;
      buttons.forEach((button) =>
        button.setAttribute('aria-pressed', String(button.dataset.project === slug)),
      );
      toggle('[data-card]', 'card', slug);
      toggle('[data-pin]', 'pin', slug);
      const chosen = buttons.find((button) => button.dataset.project === slug);
      globe?.focus(chosen ? (JSON.parse(chosen.dataset.geo ?? 'null') as Place | null) : null);
    };
    // Tant que le visiteur n'a rien choisi, les projets défilent d'eux-mêmes : on voit
    // tout de suite ce que fait la liste.
    const panel = journey.querySelector<HTMLElement>('.projects');
    const list = panel?.querySelector('ul');
    if (panel && list) panel.style.setProperty('--list-h', `${list.offsetHeight}px`);
    const AUTO_MS = 5000;
    panel?.style.setProperty('--auto', `${AUTO_MS}ms`);
    let auto = true;
    panel?.toggleAttribute('data-auto', true);
    const takeOver = (slug: string | null) => {
      auto = false;
      panel?.removeAttribute('data-auto');
      select(slug);
    };
    journey
      .querySelectorAll<SVGElement>('[data-pin]')
      .forEach((pin) => pin.addEventListener('click', () => takeOver(pin.dataset.pin ?? null)));
    timer = window.setInterval(() => {
      // Pas de changement de projet pendant qu'une fiche est ouverte.
      const busy = document.querySelector('dialog[open]');
      if (!auto || busy || journey.dataset.step !== String(VIEW_COUNT - 1)) return;
      const index = buttons.findIndex((button) => button.dataset.project === selected);
      select(buttons[(index + 1) % buttons.length].dataset.project ?? null);
    }, AUTO_MS);

    buttons.forEach((button) => {
      const choose = () => takeOver(button.dataset.project ?? null);
      button.addEventListener('pointerenter', choose);
      button.addEventListener('focus', choose);
      button.addEventListener('click', choose);
    });

    // En quittant la vue des projets, le globe reprend le parcours.
    const lastStep = String(VIEW_COUNT - 1);
    const follow = onScroll;
    onScroll = () => {
      follow();
      if (journey.dataset.step !== lastStep) select(null);
      else if (selected === null && auto) select(buttons[0]?.dataset.project ?? null);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  };

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', stop);
</script>
