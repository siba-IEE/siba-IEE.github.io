---
/**
 * Fiche de projet en fenêtre modale : une petite carte centrée sur ordinateur, un tiroir
 * qui monte du bas sur mobile. Elle s'ouvre depuis tout élément portant `data-sheet-open`
 * avec l'identifiant du projet, et se ferme par le bouton, la touche Échap ou un clic
 * hors de la carte. L'élément <dialog> natif gère le focus et le blocage de la page.
 */
import { getLangFromUrl } from '../../lib/i18n';
import { kindLabels, type Project } from '../../lib/content';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const isFr = lang === 'fr';
const t = isFr
  ? { close: 'Fermer', open: 'Ouvrir le projet' }
  : { close: 'Close', open: 'Open the project' };

/** Premier paragraphe de la description : la fiche dit l'essentiel, la page Projets dit le reste. */
const intro = (project: Project) => (isFr ? project.bodyFr : project.bodyEn).split('\n\n')[0];
---

<dialog class="sheet" data-sheet>
  <div class="surface">
    <button type="button" class="close" data-sheet-close aria-label={t.close}>
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 4 8 8m0-8-8 8"></path></svg>
    </button>

    {
      projects.map((project) => (
        <article data-sheet-project={project.slug} hidden>
          <p class="kind">{kindLabels[project.kind][lang]}</p>
          <h2>{project.title}</h2>
          <p class="intro">{intro(project)}</p>
          {project.image && (
            <img src={project.image} alt="" width="1400" height="650" loading="lazy" />
          )}
          <footer>
            {project.url && (
              <a class="cta" href={project.url} target="_blank" rel="noopener">
                {t.open}
                <svg viewBox="0 0 16 16" aria-hidden="true">
                  <path d="M4 12 12 4M6 4h6v6" />
                </svg>
              </a>
            )}
            <span>{project.links?.[0]?.label}</span>
          </footer>
        </article>
      ))
    }
  </div>
</dialog>

<style>
  .sheet {
    --ease: cubic-bezier(0.32, 0.72, 0, 1);

    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
    border: 0;
    background: none;
    color: var(--text);
  }

  .sheet::backdrop {
    background: rgb(0 0 0 / 0%);
    backdrop-filter: blur(0);
    transition:
      background 0.4s ease,
      backdrop-filter 0.4s ease;
  }

  .sheet[data-state='open']::backdrop {
    background: rgb(0 0 0 / 50%);
    backdrop-filter: blur(12px);
  }

  /* Mobile : un tiroir qui monte du bas, à la hauteur de son contenu */
  .surface {
    position: absolute;
    inset: auto 0 0;
    max-height: 90svh;
    padding: 1.75rem 1.25rem 1.5rem;
    overflow: hidden auto;
    overscroll-behavior: contain;
    border-radius: 1.25rem 1.25rem 0 0;
    background: var(--panel);
    transform: translateY(100%);
    transition: transform 0.5s var(--ease);
  }

  .sheet[data-state='open'] .surface {
    transform: none;
  }

  .close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--surface-2);
    color: var(--heading);
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .close:hover {
    background: var(--surface-3);
  }

  .close svg,
  .cta svg {
    width: 0.8rem;
    height: 0.8rem;
    fill: none;
    stroke: currentcolor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  article[hidden] {
    display: none;
  }

  .kind {
    margin: 0 0 0.5rem;
    font-size: 0.85rem;
    color: var(--text-subtle);
  }

  h2 {
    margin: 0;
    padding-right: 2.5rem;
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.015em;
    color: var(--heading);
  }

  .intro {
    margin: 0.9rem 0 0;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--text-muted);
    text-wrap: pretty;
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    margin-top: 1.5rem;
    object-fit: cover;
    object-position: left top;
    border: 1px solid var(--border);
    border-radius: 0.6rem;
  }

  footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--text-subtle);
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.7rem 1.15rem;
    border-radius: 2rem;
    background: var(--heading);
    color: var(--panel);
    font-family: var(--font-sans);
    font-size: 0.92rem;
    font-weight: 500;
    transition:
      background 0.25s ease,
      color 0.25s ease;
  }

  .cta:hover {
    background: var(--color-accent-400);
    color: #111;
  }

  .cta svg {
    transition: transform 0.3s var(--ease);
  }

  .cta:hover svg {
    transform: translate(2px, -2px);
  }

  /* Ordinateur : une carte étroite, centrée */
  @media (min-width: 720px) {
    .surface {
      inset: 50% auto auto 50%;
      width: 34rem;
      max-height: calc(100svh - 4rem);
      padding: 2.25rem;
      border-radius: 1.5rem;
      opacity: 0;
      transform: translate(-50%, -47%) scale(0.97);
      transition:
        transform 0.5s var(--ease),
        opacity 0.25s ease;
    }

    .sheet[data-state='open'] .surface {
      opacity: 1;
      transform: translate(-50%, -50%);
    }

    .close {
      top: 1.25rem;
      right: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .surface,
    .sheet::backdrop {
      transition: none;
    }
  }
</style>

<script>
  const CLOSE_MS = 400;

  const init = () => {
    const sheet = document.querySelector<HTMLDialogElement>('[data-sheet]');
    if (!sheet || sheet.dataset.bound) return;
    sheet.dataset.bound = 'true';
    const articles = [...sheet.querySelectorAll<HTMLElement>('[data-sheet-project]')];
    const surface = sheet.querySelector<HTMLElement>('.surface');

    const open = (slug: string) => {
      const article = articles.find((item) => item.dataset.sheetProject === slug);
      if (!article) return;
      articles.forEach((item) => (item.hidden = item !== article));
      sheet.showModal();
      if (surface) surface.scrollTop = 0;
      // L'état « ouvert » est posé à l'image suivante, pour que la transition parte de l'état fermé.
      requestAnimationFrame(() => (sheet.dataset.state = 'open'));
    };

    const close = () => {
      delete sheet.dataset.state;
      window.setTimeout(() => sheet.close(), CLOSE_MS);
    };

    document.addEventListener('click', (event) => {
      const target = event.target as Element | null;
      const trigger = target?.closest<HTMLElement | SVGElement>('[data-sheet-open]');
      if (trigger?.dataset.sheetOpen) open(trigger.dataset.sheetOpen);
      // Un clic sur le fond (le <dialog> lui-même, hors de la feuille) ferme.
      else if (target === sheet || target?.closest('[data-sheet-close]')) close();
    });
    // Échap : on joue la fermeture animée plutôt que la fermeture immédiate du navigateur.
    sheet.addEventListener('cancel', (event) => {
      event.preventDefault();
      close();
    });
  };

  document.addEventListener('astro:page-load', init);
</script>
