---
/**
 * La page d'accueil tient dans une seule scène 3D (src/scripts/stage.ts), pilotée par le
 * défilement : un couloir, puis un salon. Ce composant porte le texte et le film de chaque
 * réalisation. Sans WebGL ou sans JavaScript, tout se lit à la suite.
 */
import { SITE } from '../../lib/site';
import { getLangFromUrl } from '../../lib/i18n';
import {
  getProfile,
  getExperience,
  getEducation,
  getProjects,
  getPublications,
  statusLabels,
} from '../../lib/content';
import { films, glyphs } from '../../data/films';
import outlines from '../../data/outlines.json';
import { timeline } from '../../scripts/stage';

const lang = getLangFromUrl(Astro.url);
const isFr = lang === 'fr';
const profile = getProfile();

const since = isFr ? 'Depuis' : 'Since';
const dates = (start: string, end: string, current = false) =>
  current ? `${since} ${start}` : end ? `${start}–${end}` : start;

/* ---------- Parcours : formation et postes, dans l'ordre du temps ---------- */

const milestones = [
  ...getEducation().map((item) => ({
    year: Number(item.start),
    when: dates(item.start, item.end),
    title: isFr ? item.titleFr : item.titleEn,
    place: [item.school, isFr ? item.locationFr : item.locationEn].filter(Boolean).join(', '),
    text: '',
  })),
  ...getExperience().map((item) => ({
    year: Number(item.start) + 0.5,
    when: dates(item.start, item.end, item.current),
    title: isFr ? item.roleFr : item.roleEn,
    place: `${item.org}, ${isFr ? item.locationFr : item.locationEn}`,
    text: isFr ? item.descFr : item.descEn,
  })),
].sort((a, b) => a.year - b.year);

/* ---------- Réalisations : une chaîne par projet, un film par chaîne ---------- */

const channels = getProjects()
  .filter((project) => films[project.slug])
  .map((project) => {
    const film = films[project.slug];
    const glyph =
      film.glyph === 'gn' || film.glyph === 'ci'
        ? outlines[film.glyph]
        : { path: glyphs[film.glyph], width: 100, height: 100 };
    return {
      title: project.title,
      status: project.status === 'live' ? '' : statusLabels[project.status][lang],
      url: project.url,
      tint: film.tint,
      glyph: { path: glyph.path, width: glyph.width, height: glyph.height },
      beats: film.beats.map((beat) => ({
        line: beat.say[lang],
        notes: (beat.notes ?? []).map((note) => note[lang]),
        scene: beat.scene((fr, en) => (isFr ? fr : en)),
      })),
    };
  });

/* ---------- Recherche : un volume par publication ---------- */

const types: Record<string, { fr: string; en: string }> = {
  'journal-article': { fr: 'Article', en: 'Article' },
  preprint: { fr: 'Prépublication', en: 'Preprint' },
  'data-set': { fr: 'Jeu de données', en: 'Dataset' },
  software: { fr: 'Logiciel', en: 'Software' },
};
const cloths = ['#1f3a5f', '#7a2a2a', '#2f4a3a', '#c9a23f', '#3d3f47', '#b5532a', '#d8cdb8'];
const papers = getPublications().map((pub, index) => ({
  title: pub.title,
  mention: `${pub.year}, ${types[pub.type]?.[lang] ?? pub.type}`,
  authors: [pub.authors.join(', '), pub.venue].filter(Boolean).join('. '),
  doi: pub.doi,
  url: pub.url ?? `https://doi.org/${pub.doi}`,
  color: cloths[index % cloths.length],
}));

const T = timeline(milestones.length, papers.length);
const pad = (n: number) => String(n).padStart(2, '0');

const t = isFr
  ? {
      role: profile.roleFr,
      scroll: 'Défiler',
      pick: 'Choisissez une chaîne',
      tip: 'Cliquez sur une chaîne de l’écran',
      channel: 'Chaîne',
      change: 'Changer de chaîne',
      previous: 'Chaîne précédente',
      next: 'Chaîne suivante',
      open: 'Ouvrir le projet',
      read: 'Lire',
      step: 'Étape',
    }
  : {
      role: profile.roleEn,
      scroll: 'Scroll',
      pick: 'Pick a channel',
      tip: 'Click a channel on the screen',
      channel: 'Channel',
      change: 'Change channel',
      previous: 'Previous channel',
      next: 'Next channel',
      open: 'Open the project',
      read: 'Read',
      step: 'Step',
    };

const config = {
  avatar: '/models/avatar.glb',
  walk: '/models/walk.json',
  frames: milestones.map(({ when, title, place }) => ({ when, title, place })),
  volumes: papers.map(({ title, mention, color }) => ({ title, mention, color })),
  channels: channels.map(({ title, tint, glyph }) => ({ title, tint, glyph })),
  hint: t.pick,
};
/** Les scènes 3D de chaque film, une par étape. */
const scenes = channels.map((channel) => channel.beats.map((beat) => beat.scene));
---

<section
  class="scene"
  data-scene
  data-config={JSON.stringify(config)}
  data-films={JSON.stringify(scenes)}
  data-state="loading"
  style={`--units:${(T.end + 1.4).toFixed(2)}`}
>
  <div class="stage">
    <canvas aria-hidden="true"></canvas>
    <i class="shade"></i>

    <div class="intro">
      <h1>{SITE.name}</h1>
      <p>{t.role}</p>
      <span class="cue">{t.scroll}</span>
    </div>

    <ol class="path">
      {
        milestones.map((item, index) => (
          <li data-milestone={index}>
            <p class="when">{item.when}</p>
            <h2>{item.title}</h2>
            <p class="place">{item.place}</p>
            {item.text && <p class="text">{item.text}</p>}
          </li>
        ))
      }
    </ol>

    {/* Les chaînes se choisissent sur l'écran 3D ; cette liste les rend accessibles au clavier. */}
    <div class="channels">
      <p class="tip">{t.tip}</p>
      <ul>
        {
          channels.map((channel, index) => (
            <li>
              <button type="button" data-channel={index}>
                <span>{pad(index + 1)}</span>
                {channel.title}
              </button>
            </li>
          ))
        }
      </ul>
    </div>

    <ol class="papers">
      {
        papers.map((paper, index) => (
          <li data-paper={index}>
            <p class="when">{paper.mention}</p>
            <h2>{paper.title}</h2>
            <p class="place">{paper.authors}</p>
            <a href={paper.url} target="_blank" rel="noopener">
              {t.read}
              <span>doi:{paper.doi?.toLowerCase()}</span>
            </a>
          </li>
        ))
      }
    </ol>

    <div class="film" data-film>
      {
        channels.map((channel, index) => (
          <article data-program={index} data-url={channel.url ?? undefined} hidden>
            <header>
              <span class="number">
                {t.channel} {pad(index + 1)}
              </span>
              <h3>{channel.title}</h3>
              {channel.status && <span class="status">{channel.status}</span>}
            </header>

            <div class="asides">
              {channel.beats.map((beat) => (
                <ul class="notes" data-empty={beat.notes.length === 0 || undefined}>
                  {beat.notes.map((note, index) => (
                    <li style={`--d:${(2.2 + index * 0.9).toFixed(1)}s`}>{note}</li>
                  ))}
                </ul>
              ))}
            </div>

            <ol class="lines">
              {channel.beats.map((beat) => (
                <li>{beat.line}</li>
              ))}
            </ol>
            <ol class="beats">
              {channel.beats.map((_, index) => (
                <li>
                  <button type="button" aria-label={`${t.step} ${index + 1}`} />
                </li>
              ))}
            </ol>
          </article>
        ))
      }

      <div class="remote">
        <button type="button" data-remote="previous" aria-label={t.previous}>
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 5 8l5 5"></path></svg>
        </button>
        <button type="button" data-remote="grid">{t.change}</button>
        <button type="button" data-remote="next" aria-label={t.next}>
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m6 3 5 5-5 5"></path></svg>
        </button>
        <a data-remote="open" target="_blank" rel="noopener">{t.open}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .scene {
    --nav: 0rem;
    --stage: calc(100svh - var(--nav));
    --ink: #0b0c0e;
    --glow: #7fdcff;

    position: relative;
    height: calc(var(--stage) * var(--units));
    background: var(--ink);
    color: #fff;
  }

  .stage {
    position: sticky;
    top: var(--nav);
    height: var(--stage);
    overflow: hidden;
  }

  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  .scene:not([data-state='loading']) canvas {
    opacity: 1;
  }

  /* Voile du bas : le texte reste lisible sur un décor clair. */
  .shade {
    position: absolute;
    inset: 45% 0 0;
    background: linear-gradient(rgb(11 12 14 / 0%), rgb(11 12 14 / 88%) 78%);
    pointer-events: none;
    transition: opacity 0.6s ease;
  }

  .scene[data-act='screen'] .shade,
  .scene[data-act='enter'] .shade {
    opacity: 0;
  }

  /* Chargement : un trait qui pulse. */
  .scene[data-state='loading'] .stage::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 6rem;
    height: 1.5px;
    background: #fff;
    translate: -50% 0;
    animation: load 1.2s ease-in-out infinite;
  }

  @keyframes load {
    0%,
    100% {
      scale: 0.2 1;
      opacity: 0.4;
    }

    50% {
      scale: 1 1;
      opacity: 1;
    }
  }

  /* ---------- Textes posés sur la scène ---------- */

  .intro,
  .path,
  .papers,
  .channels {
    position: absolute;
    inset: auto 1.25rem 2rem;
    pointer-events: none;
  }

  .intro {
    transition:
      opacity 0.5s ease,
      translate 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .scene:not([data-act='intro']) .intro {
    opacity: 0;
    translate: 0 -1.5rem;
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3.2rem, 10vw, 10rem);
    font-weight: 400;
    line-height: 0.86;
    letter-spacing: -0.02em;
    color: #fff;
  }

  .intro p {
    max-width: 26rem;
    margin: 1.2rem 0 0;
    font-size: 1rem;
    color: rgb(255 255 255 / 80%);
  }

  .cue {
    display: inline-grid;
    justify-items: center;
    gap: 0.5rem;
    margin-top: 1.6rem;
    font-size: 0.72rem;
    color: rgb(255 255 255 / 70%);
  }

  .cue::after {
    content: '';
    width: 1.5px;
    height: 2rem;
    background: #fff;
    transform-origin: top;
    animation: drip 1.8s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  @keyframes drip {
    0% {
      transform: scaleY(0);
    }

    50% {
      transform: scaleY(1);
      transform-origin: top;
    }

    51% {
      transform-origin: bottom;
    }

    100% {
      transform: scaleY(0);
      transform-origin: bottom;
    }
  }

  /* Parcours et publications : une fiche à la fois. */
  .path,
  .papers {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .path li,
  .papers li {
    grid-area: 1 / 1;
    align-self: end;
    max-width: 32rem;
    opacity: 0;
    translate: 0 1rem;
    transition:
      opacity 0.35s ease,
      translate 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .path li[data-on],
  .papers li[data-on] {
    opacity: 1;
    translate: 0;
    pointer-events: auto;
    transition-delay: 0.1s;
  }

  .when {
    margin: 0 0 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: rgb(255 255 255 / 70%);
  }

  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 3.6vw, 3.2rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.015em;
    color: #fff;
    text-wrap: balance;
  }

  .papers h2 {
    font-size: clamp(1.4rem, 2.2vw, 2rem);
    line-height: 1.08;
  }

  .place {
    margin: 0.7rem 0 0;
    font-size: 0.95rem;
    color: rgb(255 255 255 / 80%);
  }

  .text {
    margin: 0.7rem 0 0;
    font-size: 0.9rem;
    line-height: 1.5;
    color: rgb(255 255 255 / 68%);
    text-wrap: pretty;
  }

  .papers a {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1rem;
    margin-top: 1.1rem;
    padding: 0.7rem 1.1rem;
    border-radius: 2rem;
    background: #fff;
    color: var(--ink);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .papers a span {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 400;
    overflow-wrap: anywhere;
  }

  /* Invitation à choisir une chaîne ; la liste elle-même n'apparaît qu'au clavier. */
  .channels {
    display: grid;
    justify-items: center;
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .scene[data-act='screen']:not([data-playing]) .channels {
    opacity: 1;
  }

  .tip {
    margin: 0;
    padding: 0.55rem 1rem;
    border-radius: 2rem;
    background: rgb(11 12 14 / 72%);
    backdrop-filter: blur(8px);
    font-size: 0.82rem;
  }

  .channels ul {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: 0;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    list-style: none;
  }

  /* ---------- Film d'une réalisation ---------- */

  .film {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.5s ease,
      visibility 0s 0.5s;
  }

  .film[data-open] {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }

  .film article {
    position: absolute;
    inset: 0;
  }

  .film article[hidden] {
    display: none;
  }

  /* Voile du bas : les explications restent lisibles devant le décor. */
  .film article::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    z-index: 1;
    height: 15rem;
    background: linear-gradient(rgb(11 13 18 / 0%), #0b0d12 55%);
    pointer-events: none;
  }

  .film header {
    position: absolute;
    inset: 1.25rem 1.25rem auto;
    z-index: 2;
    display: grid;
    justify-items: start;
    gap: 0.35rem;
    animation: enter 0.8s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes enter {
    from {
      opacity: 0;
      translate: 0 0.8rem;
    }
  }

  .number {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--glow);
  }

  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 4.5rem);
    font-weight: 400;
    line-height: 0.95;
    color: #fff;
  }

  .status {
    font-size: 0.75rem;
    color: rgb(255 255 255 / 70%);
  }

  /* Notes de l'étape en cours, posées à côté de la projection. */
  .asides {
    position: absolute;
    inset: 6rem 1.25rem auto;
    z-index: 2;
    display: grid;
  }

  .asides .notes {
    grid-area: 1 / 1;
    display: none;
    max-width: 19rem;
    padding: 0.9rem 1rem;
    border-radius: 0.5rem;
    background: rgb(11 13 18 / 72%);
    backdrop-filter: blur(8px);
  }

  .asides .notes[data-on]:not([data-empty]) {
    display: grid;
  }

  .lines {
    position: absolute;
    inset: auto 1.25rem 4.6rem;
    z-index: 2;
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lines li {
    grid-area: 1 / 1;
    align-self: end;
    max-width: 46rem;
    font-size: clamp(0.98rem, 1.55vw, 1.35rem);
    line-height: 1.3;
    text-shadow: 0 1px 1rem #0b0d12;
    text-wrap: pretty;
    opacity: 0;
    translate: 0 0.6rem;
    transition:
      opacity 0.5s ease,
      translate 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .lines li[data-on] {
    opacity: 1;
    translate: 0;
  }

  /* Une barre par explication, qui se remplit pendant qu'elle est à l'écran. */
  .beats {
    position: absolute;
    inset: auto 1.25rem 3.3rem;
    z-index: 2;
    display: flex;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .beats li {
    flex: 1;
  }

  /* Chaque barre est un bouton : on revient à une étape en la touchant. */
  .beats button {
    pointer-events: auto;
    display: block;
    width: 100%;
    height: 1.4rem;
    background:
      linear-gradient(var(--glow), var(--glow)) 0 50% / calc(var(--played, 0) * 100%) 2px no-repeat,
      linear-gradient(rgb(255 255 255 / 24%), rgb(255 255 255 / 24%)) 0 50% / 100% 2px no-repeat;
    cursor: pointer;
  }

  .beats button:hover {
    background-size:
      calc(var(--played, 0) * 100%) 4px,
      100% 4px;
  }

  /* Notes : les termes du plan, définis un à un à côté de lui. */
  .notes {
    display: grid;
    gap: 0.7rem;
    align-self: start;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.86rem;
    line-height: 1.35;
  }

  .notes li {
    padding-left: 0.8rem;
    border-left: 1.5px solid var(--glow);
    animation: note 0.7s cubic-bezier(0.22, 1, 0.36, 1) var(--d) both;
  }

  @keyframes note {
    from {
      opacity: 0;
      translate: 0 0.6rem;
    }
  }

  .remote {
    position: absolute;
    z-index: 3;
    pointer-events: auto;
    inset: auto 1.25rem 1.1rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
  }

  .remote button,
  .remote a {
    display: grid;
    place-items: center;
    height: 2.2rem;
    padding-inline: 0.9rem;
    border-radius: 2rem;
    background: rgb(255 255 255 / 12%);
    color: #fff;
    white-space: nowrap;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .remote button:hover,
  .remote a:hover {
    background: rgb(255 255 255 / 26%);
  }

  .remote [data-remote='grid'] {
    background: #fff;
    color: var(--ink);
    font-weight: 500;
  }

  .remote a {
    margin-left: auto;
  }

  .remote svg {
    width: 0.8rem;
    height: 0.8rem;
    fill: none;
    stroke: currentcolor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (min-width: 1024px) {
    .intro,
    .path,
    .papers,
    .channels {
      inset: auto 4rem 3rem;
    }

    .film header {
      inset: 2.25rem 4rem auto;
    }

    .asides {
      inset: 9rem 4rem auto auto;
    }

    .asides .notes {
      gap: 1rem;
      max-width: 21rem;
      font-size: 1rem;
    }

    .lines {
      inset: auto 4rem 6.2rem;
    }

    .beats {
      inset: auto 4rem 4.4rem;
    }

    .remote {
      inset: auto 4rem 2rem;
    }
  }

  /* ---------- Sans JavaScript ou sans WebGL : tout se lit à la suite ---------- */

  :global(html:not(.js)) .scene,
  .scene[data-flat] {
    height: auto;
  }

  :global(html:not(.js)) .stage,
  .scene[data-flat] .stage {
    position: static;
    height: auto;
    padding: 4rem 1.25rem;
  }

  :global(html:not(.js)) :is(canvas, .shade, .cue, .tip, .film),
  .scene[data-flat] :is(canvas, .shade, .cue, .tip) {
    display: none;
  }

  :global(html:not(.js)) :is(.intro, .path, .papers, .channels, .channels ul),
  .scene[data-flat] :is(.intro, .path, .papers, .channels, .channels ul) {
    position: static;
    display: block;
    width: auto;
    height: auto;
    clip-path: none;
    opacity: 1;
    translate: 0;
    pointer-events: auto;
  }

  :global(html:not(.js)) :is(.path li, .papers li, .channels li),
  .scene[data-flat] :is(.path li, .papers li, .channels li) {
    margin-top: 2.5rem;
    opacity: 1;
    translate: 0;
    pointer-events: auto;
  }

  .scene[data-flat] .film {
    position: fixed;
    inset: var(--nav) 0 0;
    z-index: 30;
  }
</style>

<script>
  import type { Stage, StageOptions } from '../../scripts/stage';
  import type { Scene } from '../../scripts/holo';

  /** Durée d'une explication à l'écran, en millisecondes. */
  const LINE_MS = 9000;
  /** Temps que met la caméra à rejoindre l'écran avant que le film commence. */
  const ZOOM_MS = 700;

  let stage: Stage | null = null;
  let onScroll: (() => void) | null = null;
  let timer = 0;
  let opening = 0;

  const stop = () => {
    stage?.destroy();
    stage = null;
    if (onScroll) window.removeEventListener('scroll', onScroll);
    onScroll = null;
    window.clearInterval(timer);
    window.clearTimeout(opening);
  };

  const init = async () => {
    stop();
    const root = document.querySelector<HTMLElement>('[data-scene]');
    const canvas = root?.querySelector('canvas');
    if (!root || !canvas) return;

    const config = JSON.parse(root.dataset.config ?? '{}') as Omit<StageOptions, 'onPick'>;
    const milestones = [...root.querySelectorAll<HTMLElement>('[data-milestone]')];
    const papers = [...root.querySelectorAll<HTMLElement>('[data-paper]')];
    const film = root.querySelector<HTMLElement>('[data-film]')!;
    const programs = [...film.querySelectorAll<HTMLElement>('[data-program]')];
    const scenes = JSON.parse(root.dataset.films ?? '[]') as Scene[][];
    const open = film.querySelector<HTMLAnchorElement>('[data-remote="open"]')!;
    let current = -1;

    const only = (items: Element[], index: number) =>
      items.forEach((item, i) => item.toggleAttribute('data-on', i === index));

    /* ----- Film : les explications passent une à une, le plan change avec elles ----- */

    const run = (program: HTMLElement) => {
      const lines = [...program.querySelectorAll('.lines li')];
      const beats = [...program.querySelectorAll<HTMLElement>('.beats button')];
      const notes = [...program.querySelectorAll('.asides .notes')];
      const film = scenes[programs.indexOf(program)];
      let started = performance.now();
      let shown = -1;
      window.clearInterval(timer);
      const step = () => {
        const elapsed = performance.now() - started;
        const line = Math.min(lines.length - 1, Math.floor(elapsed / LINE_MS));
        if (line !== shown) {
          // Nouvelle étape : la maquette projetée dans le salon change avec la phrase.
          stage?.project(film[line]);
          only(lines, line);
          only(notes, line);
          shown = line;
        }
        beats.forEach((beat, i) =>
          beat.style.setProperty(
            '--played',
            Math.min(1, Math.max(0, elapsed / LINE_MS - i)).toFixed(3),
          ),
        );
      };
      // Toucher une barre ramène le film au début de cette étape.
      beats.forEach((beat, i) => {
        beat.onclick = () => {
          started = performance.now() - i * LINE_MS;
          step();
        };
      });
      step();
      timer = window.setInterval(step, 100);
    };

    const play = (index: number) => {
      const already = film.hasAttribute('data-open');
      current = (index + programs.length) % programs.length;
      root.toggleAttribute('data-playing', true);
      stage?.tune(current);
      const show = () => {
        programs.forEach((program, i) => (program.hidden = i !== current));
        const href = programs[current].dataset.url;
        open.hidden = !href;
        if (href) open.href = href;
        film.toggleAttribute('data-open', true);
        run(programs[current]);
      };
      window.clearTimeout(opening);
      if (already || !stage) show();
      else opening = window.setTimeout(show, ZOOM_MS);
    };

    const close = () => {
      if (current < 0) return;
      current = -1;
      window.clearInterval(timer);
      window.clearTimeout(opening);
      film.removeAttribute('data-open');
      root.removeAttribute('data-playing');
      stage?.tune(-1);
      stage?.project(null);
    };

    root
      .querySelectorAll('[data-channel]')
      .forEach((button, index) => button.addEventListener('click', () => play(index)));
    film
      .querySelector('[data-remote="previous"]')
      ?.addEventListener('click', () => play(current - 1));
    film.querySelector('[data-remote="next"]')?.addEventListener('click', () => play(current + 1));
    film.querySelector('[data-remote="grid"]')?.addEventListener('click', close);

    /* ----- Scène 3D ----- */

    // Les cadres, l'écran et les livres sont composés avec les polices du site.
    await Promise.all([
      document.fonts.load('400 96px "Instrument Serif"'),
      document.fonts.load('400 32px "Geist Mono Variable"'),
      document.fonts.load('400 32px "Instrument Sans Variable"'),
    ]);
    const { mountStage, timeline } = await import('../../scripts/stage');
    const T = timeline(config.frames.length, config.volumes.length);
    stage = mountStage(canvas, { ...config, onPick: play }, () => (root.dataset.state = 'ready'));
    if (!stage) {
      root.setAttribute('data-flat', '');
      root.dataset.state = 'ready';
      return;
    }

    /* ----- Défilement : quel acte, quel jalon, quel volume ----- */

    onScroll = () => {
      const unit =
        window.innerHeight - parseFloat(getComputedStyle(root).getPropertyValue('--nav')) * 16;
      const p = Math.max(
        0,
        (window.scrollY - (root.getBoundingClientRect().top + window.scrollY)) / unit,
      );
      stage?.setProgress(p);

      const act =
        p < 0.55
          ? 'intro'
          : p < T.seat + 0.2
            ? 'walk'
            : p < T.screen - 0.1
              ? 'enter'
              : p < T.rise
                ? 'screen'
                : 'books';
      root.dataset.act = act;
      if (act !== 'screen') close();
      only(
        milestones,
        act === 'walk'
          ? Math.min(milestones.length - 1, Math.max(0, Math.floor((p - T.walk) / T.STEP)))
          : -1,
      );
      only(
        papers,
        p > T.books - 0.3 ? Math.min(papers.length - 1, Math.round((p - T.books) / T.BOOK)) : -1,
      );
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  };

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', stop);
</script>
