---
/**
 * La page d'accueil tient dans une seule scène 3D (src/scripts/stage.ts), pilotée par le
 * défilement : un couloir, puis un salon. Ce composant porte le texte et le film de chaque
 * réalisation. Sans WebGL ou sans JavaScript, tout se lit à la suite.
 */
import Territory from '../film/Territory.astro';
import Engine from '../film/Engine.astro';
import Solar from '../film/Solar.astro';
import { SITE } from '../../lib/site';
import { getLangFromUrl } from '../../lib/i18n';
import {
  getProfile,
  getExperience,
  getEducation,
  getProjects,
  getPublications,
  statusLabels,
} from '../../lib/content';
import { films } from '../../data/films';
import { timeline } from '../../scripts/stage';

const lang = getLangFromUrl(Astro.url);
const isFr = lang === 'fr';
const profile = getProfile();

const since = isFr ? 'Depuis' : 'Since';
const dates = (start: string, end: string, current = false) =>
  current ? `${since} ${start}` : end ? `${start}–${end}` : start;

/* ---------- Parcours : formation et postes, dans l'ordre du temps ---------- */

const milestones = [
  ...getEducation().map((item) => ({
    year: Number(item.start),
    when: dates(item.start, item.end),
    title: isFr ? item.titleFr : item.titleEn,
    place: [item.school, isFr ? item.locationFr : item.locationEn].filter(Boolean).join(', '),
    text: '',
  })),
  ...getExperience().map((item) => ({
    year: Number(item.start) + 0.5,
    when: dates(item.start, item.end, item.current),
    title: isFr ? item.roleFr : item.roleEn,
    place: `${item.org}, ${isFr ? item.locationFr : item.locationEn}`,
    text: isFr ? item.descFr : item.descEn,
  })),
].sort((a, b) => a.year - b.year);

/* ---------- Réalisations : une chaîne par projet, un film par chaîne ---------- */

const sentences = (text: string) => text.split(/(?<=[.!?])\s+/).filter(Boolean);
const channels = getProjects()
  .filter((project) => project.image && films[project.slug])
  .map((project) => {
    const film = films[project.slug];
    return {
      title: project.title,
      status: project.status === 'live' ? '' : statusLabels[project.status][lang],
      image: project.image!,
      url: project.url,
      scene: film.scene,
      details: film.details.map((detail) => detail[lang]),
      // Le commentaire du film : le résumé, puis la description, phrase par phrase.
      lines: [
        isFr ? project.summaryFr : project.summaryEn,
        ...sentences(isFr ? project.bodyFr : project.bodyEn),
      ],
    };
  });

/* ---------- Recherche : un volume par publication ---------- */

const types: Record<string, { fr: string; en: string }> = {
  'journal-article': { fr: 'Article', en: 'Article' },
  preprint: { fr: 'Prépublication', en: 'Preprint' },
  'data-set': { fr: 'Jeu de données', en: 'Dataset' },
  software: { fr: 'Logiciel', en: 'Software' },
};
const cloths = ['#1f3a5f', '#7a2a2a', '#2f4a3a', '#c9a23f', '#3d3f47', '#b5532a', '#d8cdb8'];
const papers = getPublications().map((pub, index) => ({
  title: pub.title,
  mention: `${pub.year}, ${types[pub.type]?.[lang] ?? pub.type}`,
  authors: [pub.authors.join(', '), pub.venue].filter(Boolean).join('. '),
  doi: pub.doi,
  url: pub.url ?? `https://doi.org/${pub.doi}`,
  color: cloths[index % cloths.length],
}));

const T = timeline(milestones.length, papers.length);
const pad = (n: number) => String(n).padStart(2, '0');

const t = isFr
  ? {
      role: profile.roleFr,
      scroll: 'Défiler',
      pick: 'Choisissez une chaîne',
      tip: 'Cliquez sur une chaîne de l’écran',
      channel: 'Chaîne',
      change: 'Changer de chaîne',
      previous: 'Chaîne précédente',
      next: 'Chaîne suivante',
      open: 'Ouvrir le projet',
      read: 'Lire',
    }
  : {
      role: profile.roleEn,
      scroll: 'Scroll',
      pick: 'Pick a channel',
      tip: 'Click a channel on the screen',
      channel: 'Channel',
      change: 'Change channel',
      previous: 'Previous channel',
      next: 'Next channel',
      open: 'Open the project',
      read: 'Read',
    };

const config = {
  avatar: '/models/avatar.glb',
  walk: '/models/walk.json',
  frames: milestones.map(({ when, title, place }) => ({ when, title, place })),
  volumes: papers.map(({ title, mention, color }) => ({ title, mention, color })),
  channels: channels.map(({ title, image }) => ({ title, image })),
  hint: t.pick,
};
/** Position des ancres du menu, en hauteurs d'écran. */
const anchors = [
  { id: 'parcours', at: T.walk },
  { id: 'realisations', at: T.screen + 0.1 },
  { id: 'recherche', at: T.books },
];
---

<section
  class="scene"
  data-scene
  data-config={JSON.stringify(config)}
  data-state="loading"
  style={`--units:${(T.end + 1.4).toFixed(2)}`}
>
  <div class="stage">
    <canvas aria-hidden="true"></canvas>
    <i class="shade"></i>

    <div class="intro">
      <h1>{SITE.name}</h1>
      <p>{t.role}</p>
      <span class="cue">{t.scroll}</span>
    </div>

    <ol class="path">
      {
        milestones.map((item, index) => (
          <li data-milestone={index}>
            <p class="when">{item.when}</p>
            <h2>{item.title}</h2>
            <p class="place">{item.place}</p>
            {item.text && <p class="text">{item.text}</p>}
          </li>
        ))
      }
    </ol>

    {/* Les chaînes se choisissent sur l'écran 3D ; cette liste les rend accessibles au clavier. */}
    <div class="channels">
      <p class="tip">{t.tip}</p>
      <ul>
        {
          channels.map((channel, index) => (
            <li>
              <button type="button" data-channel={index}>
                <span>{pad(index + 1)}</span>
                {channel.title}
              </button>
            </li>
          ))
        }
      </ul>
    </div>

    <ol class="papers">
      {
        papers.map((paper, index) => (
          <li data-paper={index}>
            <p class="when">{paper.mention}</p>
            <h2>{paper.title}</h2>
            <p class="place">{paper.authors}</p>
            <a href={paper.url} target="_blank" rel="noopener">
              {t.read}
              <span>doi:{paper.doi?.toLowerCase()}</span>
            </a>
          </li>
        ))
      }
    </ol>

    <div class="film" data-film>
      {
        channels.map((channel, index) => (
          <article data-program={index} data-url={channel.url ?? undefined} hidden>
            <header>
              <span class="number">
                {t.channel} {pad(index + 1)}
              </span>
              <h3>{channel.title}</h3>
              {channel.status && <span class="status">{channel.status}</span>}
            </header>

            <div class="visual">
              <div class="vector">
                {channel.scene.kind === 'territory' && (
                  <Territory country={channel.scene.country} />
                )}
                {channel.scene.kind === 'engine' && (
                  <Engine
                    inputs={channel.scene.inputs.map((label) => label[lang])}
                    core={channel.scene.core[lang]}
                    output={channel.scene.output[lang]}
                  />
                )}
                {channel.scene.kind === 'solar' && <Solar />}
              </div>
              <figure class="capture">
                <img src={channel.image} alt="" loading="lazy" />
              </figure>
            </div>

            <ul class="details">
              {channel.details.map((detail) => (
                <li>{detail}</li>
              ))}
            </ul>
            <ol class="lines">
              {channel.lines.map((line) => (
                <li>{line}</li>
              ))}
            </ol>
            <ol class="beats" aria-hidden="true">
              {channel.lines.map(() => (
                <li />
              ))}
            </ol>
          </article>
        ))
      }

      <div class="remote">
        <button type="button" data-remote="previous" aria-label={t.previous}>
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 5 8l5 5"></path></svg>
        </button>
        <button type="button" data-remote="grid">{t.change}</button>
        <button type="button" data-remote="next" aria-label={t.next}>
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m6 3 5 5-5 5"></path></svg>
        </button>
        <a data-remote="open" target="_blank" rel="noopener">{t.open}</a>
      </div>
    </div>
  </div>

  {/* Piste de défilement, et ancres du menu posées à leur place dans la piste. */}
  <div class="track" aria-hidden="true">
    {anchors.map((anchor) => <span id={anchor.id} style={`--at:${anchor.at.toFixed(2)}`} />)}
  </div>
</section>

<style>
  .scene {
    --nav: 4rem;
    --stage: calc(100svh - var(--nav));
    --ink: #0b0c0e;
    --glow: #7fdcff;

    position: relative;
    height: calc(var(--stage) * var(--units));
    background: var(--ink);
    color: #fff;
  }

  .stage {
    position: sticky;
    top: var(--nav);
    height: var(--stage);
    overflow: hidden;
  }

  .track span {
    position: absolute;
    top: calc(var(--stage) * var(--at));
    scroll-margin-top: var(--nav);
  }

  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  .scene:not([data-state='loading']) canvas {
    opacity: 1;
  }

  /* Voile du bas : le texte reste lisible sur un décor clair. */
  .shade {
    position: absolute;
    inset: 45% 0 0;
    background: linear-gradient(rgb(11 12 14 / 0%), rgb(11 12 14 / 88%) 78%);
    pointer-events: none;
    transition: opacity 0.6s ease;
  }

  .scene[data-act='screen'] .shade,
  .scene[data-act='enter'] .shade {
    opacity: 0;
  }

  /* Chargement : un trait qui pulse. */
  .scene[data-state='loading'] .stage::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 6rem;
    height: 1.5px;
    background: #fff;
    translate: -50% 0;
    animation: load 1.2s ease-in-out infinite;
  }

  @keyframes load {
    0%,
    100% {
      scale: 0.2 1;
      opacity: 0.4;
    }

    50% {
      scale: 1 1;
      opacity: 1;
    }
  }

  /* ---------- Textes posés sur la scène ---------- */

  .intro,
  .path,
  .papers,
  .channels {
    position: absolute;
    inset: auto 1.25rem 2rem;
    pointer-events: none;
  }

  .intro {
    transition:
      opacity 0.5s ease,
      translate 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .scene:not([data-act='intro']) .intro {
    opacity: 0;
    translate: 0 -1.5rem;
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3.2rem, 10vw, 10rem);
    font-weight: 400;
    line-height: 0.86;
    letter-spacing: -0.02em;
    color: #fff;
  }

  .intro p {
    max-width: 26rem;
    margin: 1.2rem 0 0;
    font-size: 1rem;
    color: rgb(255 255 255 / 80%);
  }

  .cue {
    display: inline-grid;
    justify-items: center;
    gap: 0.5rem;
    margin-top: 1.6rem;
    font-size: 0.72rem;
    color: rgb(255 255 255 / 70%);
  }

  .cue::after {
    content: '';
    width: 1.5px;
    height: 2rem;
    background: #fff;
    transform-origin: top;
    animation: drip 1.8s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  @keyframes drip {
    0% {
      transform: scaleY(0);
    }

    50% {
      transform: scaleY(1);
      transform-origin: top;
    }

    51% {
      transform-origin: bottom;
    }

    100% {
      transform: scaleY(0);
      transform-origin: bottom;
    }
  }

  /* Parcours et publications : une fiche à la fois. */
  .path,
  .papers {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .path li,
  .papers li {
    grid-area: 1 / 1;
    align-self: end;
    max-width: 32rem;
    opacity: 0;
    translate: 0 1rem;
    transition:
      opacity 0.35s ease,
      translate 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .path li[data-on],
  .papers li[data-on] {
    opacity: 1;
    translate: 0;
    pointer-events: auto;
    transition-delay: 0.1s;
  }

  .when {
    margin: 0 0 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: rgb(255 255 255 / 70%);
  }

  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 3.6vw, 3.2rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.015em;
    color: #fff;
    text-wrap: balance;
  }

  .papers h2 {
    font-size: clamp(1.4rem, 2.2vw, 2rem);
    line-height: 1.08;
  }

  .place {
    margin: 0.7rem 0 0;
    font-size: 0.95rem;
    color: rgb(255 255 255 / 80%);
  }

  .text {
    margin: 0.7rem 0 0;
    font-size: 0.9rem;
    line-height: 1.5;
    color: rgb(255 255 255 / 68%);
    text-wrap: pretty;
  }

  .papers a {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1rem;
    margin-top: 1.1rem;
    padding: 0.7rem 1.1rem;
    border-radius: 2rem;
    background: #fff;
    color: var(--ink);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .papers a span {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 400;
    overflow-wrap: anywhere;
  }

  /* Invitation à choisir une chaîne ; la liste elle-même n'apparaît qu'au clavier. */
  .channels {
    display: grid;
    justify-items: center;
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .scene[data-act='screen']:not([data-playing]) .channels {
    opacity: 1;
  }

  .tip {
    margin: 0;
    padding: 0.55rem 1rem;
    border-radius: 2rem;
    background: rgb(11 12 14 / 72%);
    backdrop-filter: blur(8px);
    font-size: 0.82rem;
  }

  .channels ul {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: 0;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    list-style: none;
  }

  /* ---------- Film d'une réalisation ---------- */

  .film {
    position: absolute;
    inset: 0;
    background: #0b0d12;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.5s ease,
      visibility 0s 0.5s;
  }

  .film[data-open] {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }

  /* Sol en perspective qui file vers le fond : le film se joue dans un espace, pas sur une page. */
  .film::before {
    content: '';
    position: absolute;
    inset: 35% -50% -60%;
    background:
      repeating-linear-gradient(90deg, rgb(127 220 255 / 16%) 0 1px, transparent 1px 5rem),
      repeating-linear-gradient(rgb(127 220 255 / 16%) 0 1px, transparent 1px 5rem);
    mask-image: linear-gradient(transparent 5%, #000 60%);
    transform: perspective(700px) rotateX(64deg);
    transform-origin: 50% 0;
    animation: glide 6s linear infinite;
  }

  @keyframes glide {
    to {
      background-position:
        0 5rem,
        0 5rem;
    }
  }

  .film article {
    position: absolute;
    inset: 0;
  }

  .film article[hidden] {
    display: none;
  }

  /* Voile du bas : les explications restent lisibles devant le décor. */
  .film article::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    z-index: 1;
    height: 15rem;
    background: linear-gradient(rgb(11 13 18 / 0%), #0b0d12 55%);
    pointer-events: none;
  }

  .film header {
    position: absolute;
    inset: 1.25rem 1.25rem auto;
    z-index: 2;
    display: grid;
    justify-items: start;
    gap: 0.35rem;
    animation: enter 0.8s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes enter {
    from {
      opacity: 0;
      translate: 0 0.8rem;
    }
  }

  .number {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--glow);
  }

  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 4.5rem);
    font-weight: 400;
    line-height: 0.95;
    color: #fff;
  }

  .status {
    font-size: 0.75rem;
    color: rgb(255 255 255 / 70%);
  }

  /* Deux plans alternent en plein cadre : le décor vectoriel, puis la capture inclinée dans l'espace. */
  .visual {
    position: absolute;
    inset: 5.5rem 0 11.5rem;
    perspective: 1400px;
  }

  .vector,
  .capture {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    margin: 0;
    padding-inline: 1.25rem;
    transition:
      opacity 0.7s ease,
      transform 1.1s cubic-bezier(0.22, 1, 0.36, 1);
  }

  article[data-shot='capture'] .vector {
    opacity: 0;
    transform: translate3d(-18%, 0, -420px) rotateY(38deg);
  }

  article[data-shot='vector'] .capture {
    opacity: 0;
    transform: translate3d(18%, 0, -420px) rotateY(-38deg);
  }

  .capture img {
    width: min(100%, 60rem);
    max-height: 100%;
    aspect-ratio: 16 / 10;
    border-radius: 0.5rem;
    object-fit: cover;
    object-position: left top;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 14%),
      0 3rem 6rem rgb(0 0 0 / 65%);
    transform: rotateY(-18deg) rotateX(7deg);
    animation: float 9s ease-in-out infinite alternate;
  }

  @keyframes float {
    to {
      transform: rotateY(14deg) rotateX(2deg) translateY(-1.5%);
    }
  }

  .details {
    position: absolute;
    inset: auto 1.25rem 9.4rem;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.74rem;
  }

  .details li {
    padding: 0.35rem 0.75rem;
    border: 1px solid rgb(255 255 255 / 30%);
    border-radius: 2rem;
    background: rgb(11 13 18 / 70%);
    opacity: 0;
    translate: 0 0.5rem;
    transition:
      opacity 0.5s ease,
      translate 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .details li[data-on] {
    opacity: 1;
    translate: 0;
  }

  .lines {
    position: absolute;
    inset: auto 1.25rem 4.6rem;
    z-index: 2;
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lines li {
    grid-area: 1 / 1;
    align-self: end;
    max-width: 46rem;
    font-size: clamp(0.98rem, 1.55vw, 1.35rem);
    line-height: 1.3;
    text-shadow: 0 1px 1rem #0b0d12;
    text-wrap: pretty;
    opacity: 0;
    translate: 0 0.6rem;
    transition:
      opacity 0.5s ease,
      translate 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .lines li[data-on] {
    opacity: 1;
    translate: 0;
  }

  /* Une barre par explication, qui se remplit pendant qu'elle est à l'écran. */
  .beats {
    position: absolute;
    inset: auto 1.25rem 3.9rem;
    z-index: 2;
    display: flex;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .beats li {
    flex: 1;
    height: 2px;
    background: linear-gradient(var(--glow), var(--glow)) 0 0 / calc(var(--played, 0) * 100%) 100%
      no-repeat rgb(255 255 255 / 22%);
  }

  .remote {
    position: absolute;
    z-index: 3;
    inset: auto 1.25rem 1.1rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
  }

  .remote button,
  .remote a {
    display: grid;
    place-items: center;
    height: 2.2rem;
    padding-inline: 0.9rem;
    border-radius: 2rem;
    background: rgb(255 255 255 / 12%);
    color: #fff;
    white-space: nowrap;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .remote button:hover,
  .remote a:hover {
    background: rgb(255 255 255 / 26%);
  }

  .remote [data-remote='grid'] {
    background: #fff;
    color: var(--ink);
    font-weight: 500;
  }

  .remote a {
    margin-left: auto;
  }

  .remote svg {
    width: 0.8rem;
    height: 0.8rem;
    fill: none;
    stroke: currentcolor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (min-width: 1024px) {
    .intro,
    .path,
    .papers,
    .channels {
      inset: auto 4rem 3rem;
    }

    .film header {
      inset: 2.25rem 4rem auto;
    }

    .visual {
      inset: 8rem 0 12rem;
    }

    .details {
      inset: 2.6rem 4rem auto auto;
      flex-direction: column;
      align-items: end;
    }

    .lines {
      inset: auto 4rem 6.2rem;
    }

    .beats {
      inset: auto 4rem 5rem;
    }

    .remote {
      inset: auto 4rem 2rem;
    }
  }

  /* ---------- Sans JavaScript ou sans WebGL : tout se lit à la suite ---------- */

  :global(html:not(.js)) .scene,
  .scene[data-flat] {
    height: auto;
  }

  :global(html:not(.js)) .stage,
  .scene[data-flat] .stage {
    position: static;
    height: auto;
    padding: 4rem 1.25rem;
  }

  :global(html:not(.js)) :is(canvas, .shade, .cue, .tip, .film),
  .scene[data-flat] :is(canvas, .shade, .cue, .tip) {
    display: none;
  }

  :global(html:not(.js)) :is(.intro, .path, .papers, .channels, .channels ul),
  .scene[data-flat] :is(.intro, .path, .papers, .channels, .channels ul) {
    position: static;
    display: block;
    width: auto;
    height: auto;
    clip-path: none;
    opacity: 1;
    translate: 0;
    pointer-events: auto;
  }

  :global(html:not(.js)) :is(.path li, .papers li, .channels li),
  .scene[data-flat] :is(.path li, .papers li, .channels li) {
    margin-top: 2.5rem;
    opacity: 1;
    translate: 0;
    pointer-events: auto;
  }

  .scene[data-flat] .film {
    position: fixed;
    inset: var(--nav) 0 0;
    z-index: 30;
  }
</style>

<script>
  import type { Stage, StageOptions } from '../../scripts/stage';

  /** Durée d'une explication à l'écran, en millisecondes. */
  const LINE_MS = 5600;
  /** Temps que met la caméra à rejoindre l'écran avant que le film commence. */
  const ZOOM_MS = 900;

  let stage: Stage | null = null;
  let onScroll: (() => void) | null = null;
  let timer = 0;
  let opening = 0;

  const stop = () => {
    stage?.destroy();
    stage = null;
    if (onScroll) window.removeEventListener('scroll', onScroll);
    onScroll = null;
    window.clearInterval(timer);
    window.clearTimeout(opening);
  };

  const init = async () => {
    stop();
    const root = document.querySelector<HTMLElement>('[data-scene]');
    const canvas = root?.querySelector('canvas');
    if (!root || !canvas) return;

    const config = JSON.parse(root.dataset.config ?? '{}') as Omit<StageOptions, 'onPick'>;
    const milestones = [...root.querySelectorAll<HTMLElement>('[data-milestone]')];
    const papers = [...root.querySelectorAll<HTMLElement>('[data-paper]')];
    const film = root.querySelector<HTMLElement>('[data-film]')!;
    const programs = [...film.querySelectorAll<HTMLElement>('[data-program]')];
    const open = film.querySelector<HTMLAnchorElement>('[data-remote="open"]')!;
    let current = -1;

    const only = (items: Element[], index: number) =>
      items.forEach((item, i) => item.toggleAttribute('data-on', i === index));
    const upTo = (items: Element[], index: number) =>
      items.forEach((item, i) => item.toggleAttribute('data-on', i <= index));

    /* ----- Film : les explications passent une à une, le plan change avec elles ----- */

    const run = (program: HTMLElement) => {
      const lines = [...program.querySelectorAll('.lines li')];
      const beats = [...program.querySelectorAll<HTMLElement>('.beats li')];
      const details = [...program.querySelectorAll('.details li')];
      const started = performance.now();
      window.clearInterval(timer);
      const step = () => {
        const elapsed = performance.now() - started;
        const line = Math.min(lines.length - 1, Math.floor(elapsed / LINE_MS));
        only(lines, line);
        upTo(details, line);
        program.dataset.shot = line % 2 ? 'capture' : 'vector';
        beats.forEach((beat, i) =>
          beat.style.setProperty(
            '--played',
            Math.min(1, Math.max(0, elapsed / LINE_MS - i)).toFixed(3),
          ),
        );
      };
      step();
      timer = window.setInterval(step, 100);
    };

    const play = (index: number) => {
      const already = film.hasAttribute('data-open');
      current = (index + programs.length) % programs.length;
      root.toggleAttribute('data-playing', true);
      stage?.tune(current);
      const show = () => {
        programs.forEach((program, i) => (program.hidden = i !== current));
        const href = programs[current].dataset.url;
        open.hidden = !href;
        if (href) open.href = href;
        film.toggleAttribute('data-open', true);
        run(programs[current]);
      };
      window.clearTimeout(opening);
      if (already || !stage) show();
      else opening = window.setTimeout(show, ZOOM_MS);
    };

    const close = () => {
      if (current < 0) return;
      current = -1;
      window.clearInterval(timer);
      window.clearTimeout(opening);
      film.removeAttribute('data-open');
      root.removeAttribute('data-playing');
      stage?.tune(-1);
    };

    root
      .querySelectorAll('[data-channel]')
      .forEach((button, index) => button.addEventListener('click', () => play(index)));
    film
      .querySelector('[data-remote="previous"]')
      ?.addEventListener('click', () => play(current - 1));
    film.querySelector('[data-remote="next"]')?.addEventListener('click', () => play(current + 1));
    film.querySelector('[data-remote="grid"]')?.addEventListener('click', close);

    /* ----- Scène 3D ----- */

    // Les cadres, l'écran et les livres sont composés avec les polices du site.
    await Promise.all([
      document.fonts.load('400 96px "Instrument Serif"'),
      document.fonts.load('400 32px "Geist Mono Variable"'),
      document.fonts.load('400 32px "Instrument Sans Variable"'),
    ]);
    const { mountStage, timeline } = await import('../../scripts/stage');
    const T = timeline(config.frames.length, config.volumes.length);
    stage = mountStage(canvas, { ...config, onPick: play }, () => (root.dataset.state = 'ready'));
    if (!stage) {
      root.setAttribute('data-flat', '');
      root.dataset.state = 'ready';
      return;
    }

    /* ----- Défilement : quel acte, quel jalon, quel volume ----- */

    onScroll = () => {
      const unit =
        window.innerHeight - parseFloat(getComputedStyle(root).getPropertyValue('--nav')) * 16;
      const p = Math.max(
        0,
        (window.scrollY - (root.getBoundingClientRect().top + window.scrollY)) / unit,
      );
      stage?.setProgress(p);

      const act =
        p < 0.55
          ? 'intro'
          : p < T.seat + 0.2
            ? 'walk'
            : p < T.screen - 0.1
              ? 'enter'
              : p < T.rise
                ? 'screen'
                : 'books';
      root.dataset.act = act;
      if (act !== 'screen') close();
      only(
        milestones,
        act === 'walk'
          ? Math.min(milestones.length - 1, Math.max(0, Math.floor((p - T.walk) / T.STEP)))
          : -1,
      );
      only(
        papers,
        p > T.books - 0.3 ? Math.min(papers.length - 1, Math.round((p - T.books) / T.BOOK)) : -1,
      );
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  };

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', stop);
</script>
