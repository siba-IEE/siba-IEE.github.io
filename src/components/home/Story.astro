---
/**
 * Ouverture de l'accueil : la carte du réseau ESMAP/WAPP, pilotée par le défilement.
 * Tout ce qui est dessiné vient de la prépublication (src/data/calage.ts) : les 31 stations
 * (tableau 1), la droite biais-latitude et son intervalle de prédiction (tableau 5), les
 * résidus par méthode (tableau 3). Le fond de carte est Natural Earth.
 *
 * Le SVG est rendu au build : sans JavaScript, la carte et le texte restent lisibles.
 * Le script ne fait que cadrer la vue, suivre l'étape active et animer la sonde de latitude.
 */
import { getLangFromUrl, localizePath } from '../../lib/i18n';
import {
  MAP,
  STATIONS,
  BIAS_LINE,
  GHI_RESIDUALS,
  PAPER,
  projX,
  projY,
  biasAt,
  piAt,
} from '../../data/calage';

const lang = getLangFromUrl(Astro.url);
const isFr = lang === 'fr';

const num = (value: number, digits = 1) =>
  new Intl.NumberFormat(isFr ? 'fr-FR' : 'en-US', {
    minimumFractionDigits: digits,
    maximumFractionDigits: digits,
  }).format(value);
// Espace fine insécable avant le signe pour cent, selon l'usage français.
const pct = (value: number, digits = 1) =>
  isFr ? `${num(value, digits)}\u202f%` : `${num(value, digits)}%`;

/* ---------- Géométrie ---------- */

const box = (lonW: number, lonE: number, latS: number, latN: number) => [
  projX(lonW),
  projY(latN),
  projX(lonE),
  projY(latS),
];
const focus = {
  net: box(-18.4, 11.4, 3.9, 15.9),
  gin: box(-15.9, -6.9, 6.6, 13.2),
};

const stations = STATIONS.map((s, i) => ({
  ...s,
  i,
  x: projX(s.lon),
  y: projY(s.lat),
  inGuinea: s.country.fr === 'Guinée',
}));

// Bande du domaine de validité de la droite (5,9 à 14,0° N), sur l'emprise du réseau.
const band = {
  x: projX(-17.9),
  y: projY(BIAS_LINE.latMax),
  w: projX(11.9) - projX(-17.9),
  h: projY(BIAS_LINE.latMin) - projY(BIAS_LINE.latMax),
};

const parallels = [4, 6, 8, 10, 12, 14, 16].map((lat) => ({ lat, y: projY(lat) }));
const meridians = [-15, -10, -5, 0, 5, 10].map((lon) => ({ lon, x: projX(lon) }));
const grid = { x0: projX(-19), x1: projX(12.5), y0: projY(17), y1: projY(3) };
const lonLabel = (lon: number) =>
  lon === 0 ? '0°' : `${Math.abs(lon)}° ${lon < 0 ? (isFr ? 'O' : 'W') : 'E'}`;

// Étape « sans station » : la cible et ses 4 donneurs les plus proches (méthode D-IDW4).
const rad = (deg: number) => (deg * Math.PI) / 180;
const greatCircle = (a: { lat: number; lon: number }, b: { lat: number; lon: number }) => {
  const h =
    Math.sin(rad(b.lat - a.lat) / 2) ** 2 +
    Math.cos(rad(a.lat)) * Math.cos(rad(b.lat)) * Math.sin(rad(b.lon - a.lon) / 2) ** 2;
  return 2 * 6371 * Math.asin(Math.sqrt(h));
};
const target = stations.find((s) => s.name === 'Kankan')!;
const donors = stations
  .filter((s) => s !== target)
  .map((s) => ({ s, km: greatCircle(target, s) }))
  .sort((a, b) => a.km - b.km)
  .slice(0, 4);
const donorNames = new Set(donors.map((d) => d.s.name));
const arcs = donors.map(({ s }) => {
  const mx = (s.x + target.x) / 2;
  const my = (s.y + target.y) / 2 - Math.hypot(s.x - target.x, s.y - target.y) * 0.18;
  return `M${s.x.toFixed(1)},${s.y.toFixed(1)}Q${mx.toFixed(1)},${my.toFixed(1)} ${target.x.toFixed(1)},${target.y.toFixed(1)}`;
});

const conakry = { x: projX(-13.71), y: projY(9.51) };

const probeLat = 10;
const maxResidual = Math.max(...GHI_RESIDUALS.map((r) => r.value));
const raw = GHI_RESIDUALS.find((r) => r.kind === 'raw')!;
const onsite = GHI_RESIDUALS.find((r) => r.kind === 'onsite')!;

/* ---------- Textes ---------- */

const t = isFr
  ? {
      rail: 'Étapes',
      mapLabel:
        'Carte de l’Afrique de l’Ouest avec les 31 stations de mesure du rayonnement solaire du réseau ESMAP/WAPP.',
      credit:
        'Fond de carte Natural Earth. Stations ESMAP/WAPP. Biais d’après le tableau 5 de la prépublication.',
      tier1: 'Tier 1 : rayonnement direct mesuré au pyrhéliomètre (23 stations)',
      tier2: 'Tier 2 : radiomètre à bande d’ombrage (8 stations)',
      probe: 'Latitude du site',
      probeOut: 'Biais prédit de CAMS en GHI',
      scaleLow: `${pct(biasAt(BIAS_LINE.latMax), 0)} à 14° N`,
      scaleHigh: `${pct(biasAt(BIAS_LINE.latMin), 0)} à 5,9° N`,
      rawLabel: 'CAMS brut',
      onsiteLabel: 'Après calage sur site',
      residualCaption:
        'Erreur absolue moyenne du cumul annuel de GHI sur 29 stations, mesurée sur l’année qui suit le calage.',
      methodsCaption:
        'Erreur absolue moyenne du cumul annuel de GHI sur 29 stations. Les six barres grises sont les transferts.',
      read: 'Prépublication (Zenodo)',
      detail: 'Méthode et résultats détaillés',
      steps: [
        {
          tag: 'Mesures au sol',
          title: '31 stations de mesure dans 13 pays',
          body: 'La campagne ESMAP/WAPP a mesuré le rayonnement solaire entre avril 2021 et avril 2024. Chaque station fournit deux années consécutives. Les données sont publiques.',
        },
        {
          tag: 'Biais du satellite',
          title: 'Le biais de CAMS augmente vers le sud',
          body: `Le produit CAMS brut surestime le cumul annuel de rayonnement global de ${pct(raw.value)} en moyenne. Sur les stations Tier 1 situées sous 600 m, ce biais diminue de ${num(Math.abs(BIAS_LINE.slope), 2)} point par degré de latitude vers le nord. La droite ajustée donne le biais attendu sur un site sans mesure, avec un intervalle de prédiction à 95 %.`,
          hint: 'Le curseur ou le survol de la carte déplace la latitude.',
        },
        {
          tag: 'Calage sur site',
          title: `Avec un an de mesure, l’erreur passe de ${pct(raw.value)} à ${pct(onsite.value)}`,
          body: 'La correction est apprise sur la première année de mesure de la station et évaluée sur la seconde. Ce calage sert de référence pour les méthodes sans station.',
        },
        {
          tag: 'Transfert',
          title: 'Sans station, le transfert ajoute environ un point d’erreur',
          body: 'La correction est apprise sur les autres stations. Une correction qui suit la tendance en latitude laisse 1,8 % d’erreur. La correction de la station la plus proche en laisse 2,9 %. En rayonnement direct, le biais varie trop d’une année à l’autre pour être fixé par une seule année de mesure.',
        },
        {
          tag: 'Application',
          title: '340 localités de Guinée corrigées',
          body: 'La méthode a servi à corriger les séries de 340 localités de Guinée. Le référentiel de données solaires du pays couvre 34 chefs-lieux de préfecture de 1981 à 2025, avec six sources satellitaires et de réanalyse et 68 millions d’enregistrements en accès ouvert.',
        },
      ],
    }
  : {
      rail: 'Steps',
      mapLabel:
        'Map of West Africa with the 31 solar-radiation measurement stations of the ESMAP/WAPP network.',
      credit: 'Base map Natural Earth. ESMAP/WAPP stations. Bias from Table 5 of the preprint.',
      tier1: 'Tier 1: direct irradiance measured by pyrheliometer (23 stations)',
      tier2: 'Tier 2: rotating shadowband radiometer (8 stations)',
      probe: 'Site latitude',
      probeOut: 'Predicted CAMS bias in GHI',
      scaleLow: `${pct(biasAt(BIAS_LINE.latMax), 0)} at 14° N`,
      scaleHigh: `${pct(biasAt(BIAS_LINE.latMin), 0)} at 5.9° N`,
      rawLabel: 'Raw CAMS',
      onsiteLabel: 'After on-site adaptation',
      residualCaption:
        'Mean absolute error of the annual GHI total over 29 stations, measured on the year after the adaptation.',
      methodsCaption:
        'Mean absolute error of the annual GHI total over 29 stations. The six grey bars are the transfers.',
      read: 'Preprint (Zenodo)',
      detail: 'Method and detailed results',
      steps: [
        {
          tag: 'Ground measurements',
          title: '31 measurement stations in 13 countries',
          body: 'The ESMAP/WAPP campaign measured solar radiation between April 2021 and April 2024. Each station provides two consecutive years. The data are public.',
        },
        {
          tag: 'Satellite bias',
          title: 'The CAMS bias increases towards the south',
          body: `The raw CAMS product overestimates the annual total of global irradiance by ${pct(raw.value)} on average. On Tier 1 stations below 600 m, this bias decreases by ${num(Math.abs(BIAS_LINE.slope), 2)} points per degree of latitude northward. The fitted line gives the expected bias at a site with no measurement, with a 95% prediction interval.`,
          hint: 'The slider, or hovering the map, moves the latitude.',
        },
        {
          tag: 'On-site adaptation',
          title: `With one year of measurement, the error goes from ${pct(raw.value)} to ${pct(onsite.value)}`,
          body: 'The correction is learned on the station’s first year of measurement and evaluated on the second. This adaptation is the reference for the methods that use no station.',
        },
        {
          tag: 'Transfer',
          title: 'Without a station, transfer adds about one point of error',
          body: 'The correction is learned on the other stations. A correction that follows the latitude trend leaves 1.8% of error. The nearest station’s correction leaves 2.9%. For direct irradiance, the bias varies too much from year to year to be set by a single year of measurement.',
        },
        {
          tag: 'Application',
          title: '340 localities in Guinea corrected',
          body: 'The method was used to correct the series of 340 localities in Guinea. The country’s solar-data reference covers 34 prefecture seats from 1981 to 2025, with six satellite and reanalysis sources and 68 million open records.',
        },
      ],
    };

const probeText = (lat: number) => `${num(lat)}° N   +${pct(biasAt(lat))} ± ${num(piAt(lat))}`;

const config = JSON.stringify({
  focus,
  map: { w: MAP.width, h: MAP.height, ...MAP.projection },
  line: BIAS_LINE,
  locale: isFr ? 'fr-FR' : 'en-US',
  pctSuffix: isFr ? '\u202f%' : '%',
});
---

<section class="story" data-story data-step="1" data-config={config}>
  <div class="stage">
    <svg
      class="map"
      viewBox={`${focus.net[0] - 60} ${focus.net[1] - 190} ${focus.net[2] - focus.net[0] + 120} ${focus.net[3] - focus.net[1] + 330}`}
      preserveAspectRatio="xMidYMid slice"
      role="img"
      aria-label={t.mapLabel}
    >
      <defs>
        <clipPath id="story-land"><path d={MAP.land}></path></clipPath>
        <linearGradient id="story-bias" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" style="stop-color: #f50; stop-opacity: 0.06"></stop>
          <stop offset="1" style="stop-color: #f50; stop-opacity: 0.86"></stop>
        </linearGradient>
        <pattern
          id="story-hatch"
          width="5"
          height="5"
          patternUnits="userSpaceOnUse"
          patternTransform="rotate(45)"
        >
          <line x1="0" y1="0" x2="0" y2="5" stroke="#f50" stroke-width="1.6"></line>
        </pattern>
      </defs>

      <path class="land" d={MAP.land}></path>

      <g class="band" clip-path="url(#story-land)">
        <rect x={band.x} y={band.y} width={band.w} height={band.h} fill="url(#story-bias)"></rect>
      </g>

      <path class="borders" d={MAP.land}></path>
      <path class="coast" d={MAP.coast}></path>
      <path class="guinea" d={MAP.guinea}></path>

      <g class="grid" aria-hidden="true">
        {parallels.map((p) => <line x1={grid.x0} x2={grid.x1} y1={p.y} y2={p.y} />)}
        {meridians.map((m) => <line x1={m.x} x2={m.x} y1={grid.y0} y2={grid.y1} />)}
        {
          parallels.map((p) => (
            <g transform={`translate(${grid.x0} ${p.y})`}>
              <g class="u">
                <text x="-6" y="3.5" text-anchor="end">
                  {p.lat}° N
                </text>
              </g>
            </g>
          ))
        }
        {
          meridians.map((m) => (
            <g transform={`translate(${m.x} ${grid.y1})`}>
              <g class="u">
                <text y="14" text-anchor="middle">
                  {lonLabel(m.lon)}
                </text>
              </g>
            </g>
          ))
        }
      </g>

      <g class="arcs" aria-hidden="true">
        {arcs.map((d, i) => <path d={d} pathLength="1" style={`--i:${i}`} />)}
      </g>

      <g class="probe" aria-hidden="true">
        <line
          data-probe-line
          x1={band.x}
          x2={band.x + band.w}
          y1={projY(probeLat)}
          y2={projY(probeLat)}></line>
        <g data-probe-anchor transform={`translate(${band.x} ${projY(probeLat)})`}>
          <g class="u">
            <text data-probe-text x="0" y="-8">{probeText(probeLat)}</text>
          </g>
        </g>
      </g>

      <g
        class="capital"
        transform={`translate(${conakry.x.toFixed(1)} ${conakry.y.toFixed(1)})`}
        aria-hidden="true"
      >
        <g class="u">
          <rect x="-3" y="-3" width="6" height="6"></rect>
          <text x="-9" y="4" text-anchor="end">Conakry</text>
        </g>
      </g>

      <g class="stations">
        {
          stations.map((s) => (
            <g
              class:list={[
                'st',
                `tier-${s.tier}`,
                s.label && `label-${s.label}`,
                s.inGuinea && 'in-guinea',
                s === target && 'is-target',
                donorNames.has(s.name) && 'is-donor',
              ]}
              transform={`translate(${s.x.toFixed(1)} ${s.y.toFixed(1)})`}
              style={`--i:${s.i}`}
            >
              <title>{`${s.name}, ${s.country[lang]} (${num(Math.abs(s.lat), 2)}° N, ${s.alt} m, Tier ${s.tier})`}</title>
              <g class="u">
                <circle class="hit" r="11" />
                <circle class="halo" r="8" />
                <circle class="dot" r="3.4" />
                <text>{s.name}</text>
              </g>
            </g>
          ))
        }
      </g>
    </svg>

    <ol class="rail" aria-label={t.rail}>
      {
        t.steps.map((step, i) => (
          <li>
            <a href={`#etape-${i + 1}`} data-rail={i + 1} aria-label={step.tag} title={step.tag} />
          </li>
        ))
      }
    </ol>
    <div class="scalebar" aria-hidden="true">
      <i data-scalebar></i>
      <span>500 km</span>
    </div>

    {/* Cartouche : la légende de la planche, qui change avec l'étape */}
    <div class="cartouche">
      {
        t.steps.map((step, index) => {
          const n = index + 1;
          return (
            <article class="panel" data-panel={n}>
              <div class="col-a">
                <h2>{step.title}</h2>
              </div>
              <div class="col-b">
                <p class="body">{step.body}</p>
                {n === 5 && (
                  <p class="links">
                    <a href={PAPER.url} target="_blank" rel="noopener">
                      {t.read}
                    </a>
                    <a href={localizePath('/travaux', lang)}>{t.detail}</a>
                  </p>
                )}
              </div>
              <div class="col-c">
                {n === 1 && (
                  <ul class="legend">
                    <li>
                      <svg viewBox="0 0 12 12" aria-hidden="true">
                        <circle cx="6" cy="6" r="4" class="k1" />
                      </svg>
                      {t.tier1}
                    </li>
                    <li>
                      <svg viewBox="0 0 12 12" aria-hidden="true">
                        <circle cx="6" cy="6" r="3.4" class="k2" />
                      </svg>
                      {t.tier2}
                    </li>
                  </ul>
                )}

                {n === 2 && (
                  <div class="probe-ui">
                    <div class="probe-read">
                      <span>{t.probeOut}</span>
                      <output data-probe-out for="story-probe">
                        {probeText(probeLat)}
                      </output>
                    </div>
                    <label for="story-probe">{t.probe}</label>
                    <input
                      id="story-probe"
                      type="range"
                      min={BIAS_LINE.latMin}
                      max={BIAS_LINE.latMax}
                      step="0.1"
                      value={probeLat}
                      data-probe-input
                    />
                    <div class="scale" aria-hidden="true">
                      <span>{t.scaleHigh}</span>
                      <i />
                      <span>{t.scaleLow}</span>
                    </div>
                    <p class="note">{'hint' in step ? step.hint : ''}</p>
                  </div>
                )}

                {n === 3 && (
                  <figure class="bars">
                    <div class="bar-row">
                      <span class="bar-label">{t.rawLabel}</span>
                      <span class="bar-track">
                        <i class="bar raw" style="--w:1" />
                      </span>
                      <span class="bar-value">{pct(raw.value, 2)}</span>
                    </div>
                    <div class="bar-row">
                      <span class="bar-label">{t.onsiteLabel}</span>
                      <span class="bar-track">
                        <i
                          class="bar onsite"
                          style={`--w:${(onsite.value / raw.value).toFixed(4)}`}
                        />
                      </span>
                      <span class="bar-value">{pct(onsite.value, 2)}</span>
                    </div>
                    <figcaption>{t.residualCaption}</figcaption>
                  </figure>
                )}

                {n === 4 && (
                  <figure class="bars compact">
                    {GHI_RESIDUALS.map((row, r) => (
                      <div class="bar-row" style={`--d:${r}`}>
                        <span class="bar-label">
                          <b>{row.code}</b>
                          <small>{row[lang]}</small>
                        </span>
                        <span class="bar-track">
                          <i
                            class:list={['bar', row.kind]}
                            style={`--w:${(row.value / maxResidual).toFixed(4)}`}
                          />
                        </span>
                        <span class="bar-value">{pct(row.value, 2)}</span>
                      </div>
                    ))}
                    <figcaption>{t.methodsCaption}</figcaption>
                  </figure>
                )}

                {n === 5 && <p class="note">{t.credit}</p>}
              </div>
            </article>
          );
        })
      }
    </div>
  </div>

  {/* Piste de défilement : une hauteur d'écran par étape, sans contenu propre */}
  <div class="track" aria-hidden="true">
    {[1, 2, 3, 4, 5].map((n) => <div class="stop" id={`etape-${n}`} data-step={n} />)}
  </div>
</section>

<style>
  /* La planche garde son papier et ses deux encres quel que soit le thème du site. */
  .story {
    --nav: 4rem;
    --paper: #fff;
    --sea: #ededed;
    --ink: #111;
    --ink-2: #5a5a5a;
    --ink-3: #8a8a8a;
    --rule: #d4d4d4;
    --spot: #f50;
    --u: 0.5;
    --stage-h: calc(100svh - var(--nav));
    --pad: 1.25rem;
    --cart-h: 50%;

    position: relative;
    background: var(--sea);
    color: var(--ink);
  }

  @media (min-width: 1024px) {
    .story {
      --pad: 2.5rem;
      --cart-h: 31%;
    }
  }

  .stage {
    position: sticky;
    top: var(--nav);
    height: var(--stage-h);
    overflow: hidden;
  }

  .track {
    position: relative;
    margin-top: calc(-1 * var(--stage-h));
    /* La dernière étape reste à l'écran un demi-écran de plus avant la suite de la page. */
    padding-bottom: calc(var(--stage-h) * 0.5);
    pointer-events: none;
  }

  .stop {
    height: var(--stage-h);
    scroll-margin-top: var(--nav);
  }

  /* ---------- Carte ---------- */

  .map {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    touch-action: pan-y;
  }

  .land {
    fill: #fff;
  }

  .borders {
    fill: none;
    stroke: #cfcfcf;
    stroke-width: 0.8;
    vector-effect: non-scaling-stroke;
  }

  .coast {
    fill: none;
    stroke: var(--ink);
    stroke-width: 0.9;
    vector-effect: non-scaling-stroke;
  }

  .guinea {
    fill: url('#story-hatch');
    fill-opacity: 0.5;
    stroke: var(--ink);
    stroke-width: 1.8;
    vector-effect: non-scaling-stroke;
    opacity: 0;
    transition: opacity 0.8s ease;
  }

  /* Dans le SVG, .u ramène un groupe à l'échelle de l'écran : tout y est en pixels. */
  .u {
    transform: scale(var(--u));
  }

  .grid {
    transition: opacity 0.6s ease;
  }

  .grid line {
    stroke: color-mix(in oklch, var(--ink) 13%, transparent);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .grid text {
    fill: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 10px;
  }

  /* Petits écrans : le fond de carte s'arrête à 32° N, le haut de la planche reste papier. */
  @media (max-width: 1023px) {
    .grid text,
    .stage .scalebar {
      display: none;
    }

    .panel[data-panel='2'] .scale {
      display: none;
    }
  }

  .band {
    mix-blend-mode: multiply;
    opacity: 0.55;
    transition: opacity 1s ease;
  }

  .arcs path {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.3;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0;
    transition:
      stroke-dashoffset 0.9s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.3s ease;
    transition-delay: calc(var(--i) * 120ms);
  }

  .probe {
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .probe line {
    stroke: var(--ink);
    stroke-width: 1.2;
    vector-effect: non-scaling-stroke;
  }

  .probe text,
  .capital text,
  .st text {
    fill: var(--ink);
    paint-order: stroke;
    stroke: #fff;
    stroke-width: 3.5px;
    stroke-linejoin: round;
  }

  .probe text {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    white-space: pre;
  }

  .capital {
    opacity: 0;
    transition: opacity 0.8s ease 0.5s;
  }

  .capital rect {
    fill: var(--ink);
  }

  .capital text {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
  }

  .st {
    transition: opacity 0.6s ease;
  }

  .st .hit {
    fill: transparent;
  }

  .st .dot {
    fill: var(--ink);
    stroke: #fff;
    stroke-width: 1.2;
  }

  .st.tier-2 .dot {
    fill: #fff;
    stroke: var(--ink);
    stroke-width: 1.5;
  }

  .st .halo {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.1;
    opacity: 0;
    transform: scale(0.4);
    transition:
      opacity 0.5s ease,
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--i) * 22ms);
  }

  .st text {
    font-family: var(--font-sans);
    font-size: 11px;
    opacity: 0;
    transform: translate(8px, 3.5px);
    transition: opacity 0.45s ease;
    pointer-events: none;
  }

  .st.label-l text {
    text-anchor: end;
    transform: translate(-8px, 3.5px);
  }

  .st.label-t text {
    text-anchor: middle;
    transform: translate(0, -8px);
  }

  .st.label-b text {
    text-anchor: middle;
    transform: translate(0, 16px);
  }

  .st:hover text {
    opacity: 1 !important;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .st .dot {
      animation: st-in 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
      animation-delay: calc(400ms + var(--i) * 50ms);
    }
  }

  @keyframes st-in {
    from {
      opacity: 0;
      transform: scale(3);
    }
  }

  /* États de la carte par étape */
  @media (min-width: 900px) {
    .story[data-step='1'] .st text {
      opacity: 1;
    }
  }

  .story[data-step='1'] .band {
    opacity: 0.1;
  }

  .story[data-step='2'] .band {
    opacity: 1;
  }

  .story[data-step='2'] .probe {
    opacity: 1;
  }

  .story[data-step='3'] .band {
    opacity: 0.16;
  }

  .story[data-step='3'] .st .halo {
    opacity: 1;
    transform: none;
  }

  .story[data-step='4'] .band {
    opacity: 0.4;
  }

  .story[data-step='4'] .st:not(.is-target, .is-donor) {
    opacity: 0.3;
  }

  .story[data-step='4'] .arcs path {
    opacity: 1;
    stroke-dashoffset: 0;
  }

  .story[data-step='4'] .st.is-target .halo {
    opacity: 1;
    stroke: var(--spot);
    stroke-width: 2;
    transform: scale(1.3);
  }

  .story[data-step='4'] .st.is-target text,
  .story[data-step='4'] .st.is-donor text,
  .story[data-step='5'] .st.in-guinea text {
    opacity: 1;
  }

  .story[data-step='5'] .band {
    opacity: 0.12;
  }

  .story[data-step='5'] .guinea,
  .story[data-step='5'] .capital {
    opacity: 1;
  }

  .story[data-step='5'] .st:not(.in-guinea) {
    opacity: 0.3;
  }

  .story[data-step='5'] .grid {
    opacity: 0.4;
  }

  /* ---------- Marges de la planche ---------- */

  .scalebar {
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  /* Graduations : une par étape, la courante s'allonge. */
  .rail {
    position: absolute;
    top: 1rem;
    left: 50%;
    z-index: 2;
    display: flex;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    transform: translateX(-50%);
  }

  .rail a {
    display: block;
    width: 1.1rem;
    height: 1.6rem;
    position: relative;
  }

  .rail a::before {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0.3rem;
    width: 1.5px;
    height: 0.55rem;
    background: var(--ink-3);
    transition:
      height 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      background 0.2s ease;
  }

  .rail a:hover::before {
    background: var(--ink);
  }

  .rail a[aria-current='step']::before {
    height: 1.1rem;
    background: var(--ink);
  }

  .scalebar {
    position: absolute;
    z-index: 1;
    right: var(--pad);
    bottom: calc(var(--cart-h) + 0.8rem);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.25rem;
    color: var(--ink-2);
  }

  .scalebar i {
    display: block;
    width: 60px;
    height: 5px;
    border: 1px solid var(--ink);
    border-top: 0;
  }

  /* ---------- Cartouche ---------- */

  .cartouche {
    position: absolute;
    inset: auto 0 0;
    height: var(--cart-h);
    background: var(--paper);
  }

  .panel {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: start;
    gap: 0.9rem;
    padding: 1.1rem var(--pad) 1rem;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.35s ease,
      visibility 0s linear 0.35s;
  }

  .panel.is-active {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 0.5s ease 0.15s,
      visibility 0s;
  }

  :global(html:not(.js)) .stage {
    position: static;
    height: auto;
  }

  :global(html:not(.js)) .map {
    position: static;
    height: 60vh;
  }

  :global(html:not(.js)) .cartouche,
  :global(html:not(.js)) .panel {
    position: static;
    height: auto;
    opacity: 1;
    visibility: visible;
  }

  :global(html:not(.js)) .track {
    display: none;
  }

  @media (min-width: 1024px) {
    .panel {
      grid-template-columns: minmax(0, 5fr) minmax(0, 4fr) minmax(0, 4fr);
      gap: 3rem;
      padding-top: 1.6rem;
    }
  }

  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 5.8vw, 1.9rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.04em;
    color: var(--ink);
    text-wrap: balance;
  }

  .body {
    margin: 0;
    font-size: 0.93rem;
    line-height: 1.5;
    color: var(--ink);
    text-wrap: pretty;
  }

  @media (min-width: 1024px) {
    h2 {
      font-size: clamp(1.9rem, 2.9vw, 3.2rem);
    }

    .body {
      font-size: 0.98rem;
      line-height: 1.55;
    }
  }

  .links a {
    color: var(--ink);
    font-size: 0.9rem;
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 5px;
  }

  .links a:hover {
    text-decoration-color: var(--spot);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    margin: 0.8rem 0 0;
  }

  .note {
    margin: 0.6rem 0 0;
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--ink-2);
  }

  .legend {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.84rem;
    color: var(--ink);
  }

  .legend li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .legend svg {
    flex: none;
    width: 0.8rem;
    height: 0.8rem;
  }

  .legend .k1 {
    fill: var(--ink);
  }

  .legend .k2 {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.4;
  }

  /* Sonde de latitude */
  .probe-read {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.2rem 1rem;
  }

  .probe-read span,
  .probe-ui label {
    font-size: 0.78rem;
    color: var(--ink-2);
  }

  .probe-read output {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    white-space: pre;
  }

  .probe-ui label {
    display: block;
    margin-top: 0.5rem;
  }

  .probe-ui input {
    display: block;
    width: 100%;
    height: 1.6rem;
    margin: 0;
    accent-color: var(--spot);
  }

  .scale {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--ink-2);
  }

  .scale i {
    height: 0.4rem;
    background: linear-gradient(
      to right,
      var(--spot),
      color-mix(in oklch, var(--spot) 8%, transparent)
    );
  }

  /* Barres */
  .bars {
    display: grid;
    gap: 0.55rem;
    margin: 0;
  }

  .bar-row {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 0.2rem 0.9rem;
  }

  .bar-label {
    font-size: 0.84rem;
  }

  .bar-value {
    font-family: var(--font-mono);
    font-size: 0.84rem;
    font-variant-numeric: tabular-nums;
  }

  .bar-track {
    grid-column: 1 / -1;
    display: block;
    height: 0.5rem;
  }

  .bar {
    display: block;
    width: calc(var(--w) * 100%);
    min-width: 2px;
    height: 100%;
    background: var(--ink);
    transform-origin: left;
  }

  .bar.raw {
    background: var(--spot);
  }

  .bar.transfer {
    background: var(--ink-3);
  }

  .compact {
    gap: 0.16rem;
  }

  .compact .bar-row {
    grid-template-columns: 4.6rem 1fr 3.4rem;
    align-items: center;
  }

  .compact .bar-track {
    grid-column: auto;
    height: 0.42rem;
  }

  .compact .bar-label b {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
  }

  .compact .bar-label small {
    display: none;
  }

  .compact .bar-value {
    text-align: right;
    font-size: 0.74rem;
  }

  @media (min-width: 1280px) {
    .compact .bar-row {
      grid-template-columns: 12.5rem 1fr 3.6rem;
    }

    .compact .bar-label {
      display: flex;
      align-items: baseline;
      gap: 0.6rem;
      white-space: nowrap;
    }

    .compact .bar-label b {
      min-width: 4rem;
    }

    .compact .bar-label small {
      display: inline;
      font-size: 0.7rem;
      color: var(--ink-2);
    }
  }

  .bars figcaption {
    margin-top: 0.25rem;
    font-size: 0.74rem;
    line-height: 1.4;
    color: var(--ink-2);
  }

  /* Écrans bas ou étroits : le cartouche garde l'essentiel. */
  @media (max-width: 1023px) {
    .panel[data-panel='4'] .body,
    .panel[data-panel='3'] figcaption,
    .panel[data-panel='2'] .note {
      display: none;
    }
  }

  @media (max-height: 760px) and (min-width: 1024px) {
    .bars figcaption,
    .probe-ui .note {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .bar {
      transform: scaleX(0);
      transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
      transition-delay: calc(var(--d, 0) * 50ms + 250ms);
    }

    :global(.js) .panel.is-active .bar {
      transform: none;
    }
  }
</style>

<script>
  interface StoryConfig {
    focus: Record<string, number[]>;
    map: { w: number; h: number; lon0: number; lat0: number; scale: number; k: number };
    line: {
      intercept: number;
      slope: number;
      latMin: number;
      latMax: number;
      pi: { a: number; b: number; c: number };
    };
    locale: string;
    pctSuffix: string;
  }

  let teardown: (() => void) | null = null;

  function initStory() {
    teardown?.();
    teardown = null;

    const root = document.querySelector<HTMLElement>('[data-story]');
    const svg = root?.querySelector<SVGSVGElement>('.map');
    if (!root || !svg) return;

    const cfg = JSON.parse(root.dataset.config ?? '{}') as StoryConfig;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const desktop = window.matchMedia('(min-width: 1024px)');
    const cleanups: (() => void)[] = [];
    const fmt = new Intl.NumberFormat(cfg.locale, {
      minimumFractionDigits: 1,
      maximumFractionDigits: 1,
    });

    /* ---------- Cadrage : la zone d'intérêt occupe la partie libre de la scène ---------- */

    let view = [0, 0, 1, 1];
    let frame = 0;
    let focusKey = 'net';
    let heroView = false;
    const scalebar = root.querySelector<HTMLElement>('[data-scalebar]');

    const frameFor = (key: string, hero: boolean) => {
      const rect = svg.getBoundingClientRect();
      const W = rect.width || 1;
      const H = rect.height || 1;
      const cartouche = root.querySelector<HTMLElement>('.cartouche');
      const free = 1 - (cartouche ? cartouche.offsetHeight / H : 0.3);
      // À l'ouverture, le titre occupe le haut de la planche ; ensuite la carte le reprend.
      const top = hero ? (desktop.matches ? 0.36 : 0.33) : desktop.matches ? 0.11 : 0.1;
      const side = desktop.matches ? 0.06 : 0.04;
      const safe = { x0: W * side, x1: W * (1 - side), y0: H * top, y1: H * (free - 0.035) };
      const [fx0, fy0, fx1, fy1] = cfg.focus[key];
      const s = Math.min((safe.x1 - safe.x0) / (fx1 - fx0), (safe.y1 - safe.y0) / (fy1 - fy0));
      const w = W / s;
      const h = H / s;
      // Tant que la vue tient dans le fond de carte, on l'y maintient ; sinon on garde le cadrage voulu.
      const clamp = (v: number, size: number, max: number) =>
        size >= max ? v : Math.min(Math.max(v, 0), max - size);
      const x = clamp((fx0 + fx1) / 2 - (safe.x0 + safe.x1) / 2 / s, w, cfg.map.w);
      const y = clamp((fy0 + fy1) / 2 - (safe.y0 + safe.y1) / 2 / s, h, cfg.map.h);
      return [x, y, w, h];
    };

    const applyView = (v: number[]) => {
      view = v;
      svg.setAttribute('viewBox', v.map((n) => n.toFixed(2)).join(' '));
      const width = svg.getBoundingClientRect().width || 1;
      const unit = v[2] / width;
      root.style.setProperty('--u', unit.toFixed(4));
      // Barre d'échelle : 500 km, soit 500 / 111,19 degrés de latitude.
      if (scalebar) scalebar.style.width = `${((500 / 111.19) * cfg.map.scale) / unit}px`;
    };

    const moveTo = (key: string, hero: boolean, animate: boolean) => {
      focusKey = key;
      heroView = hero;
      cancelAnimationFrame(frame);
      const to = frameFor(key, hero);
      if (!animate || reduced) {
        applyView(to);
        return;
      }
      const from = view.slice();
      const start = performance.now();
      const duration = 1300;
      const tick = (now: number) => {
        const p = Math.min(1, (now - start) / duration);
        const e = p < 0.5 ? 4 * p * p * p : 1 - (-2 * p + 2) ** 3 / 2;
        applyView(from.map((a, i) => a + (to[i] - a) * e));
        if (p < 1) frame = requestAnimationFrame(tick);
      };
      frame = requestAnimationFrame(tick);
    };

    svg.setAttribute('preserveAspectRatio', 'xMidYMid meet');
    moveTo('net', false, false);

    const onResize = () => moveTo(focusKey, heroView, false);
    window.addEventListener('resize', onResize);
    cleanups.push(
      () => window.removeEventListener('resize', onResize),
      () => cancelAnimationFrame(frame),
    );

    /* ---------- Sonde de latitude (tableau 5) ---------- */

    const line = root.querySelector<SVGLineElement>('[data-probe-line]');
    const anchor = root.querySelector<SVGGElement>('[data-probe-anchor]');
    const label = root.querySelector<SVGTextElement>('[data-probe-text]');
    const out = root.querySelector<HTMLOutputElement>('[data-probe-out]');
    const input = root.querySelector<HTMLInputElement>('[data-probe-input]');
    const anchorX = anchor?.getAttribute('transform')?.match(/translate\(([-\d.]+)/)?.[1] ?? '0';
    let touched = false;
    let demo = 0;

    const setLat = (value: number) => {
      const lat = Math.min(cfg.line.latMax, Math.max(cfg.line.latMin, value));
      const bias = cfg.line.intercept + cfg.line.slope * lat;
      const half = Math.sqrt(cfg.line.pi.a + cfg.line.pi.b * (lat - cfg.line.pi.c) ** 2);
      const y = ((cfg.map.lat0 - lat) * cfg.map.scale).toFixed(2);
      const text = `${fmt.format(lat)}° N   +${fmt.format(bias)}${cfg.pctSuffix} ± ${fmt.format(half)}`;
      line?.setAttribute('y1', y);
      line?.setAttribute('y2', y);
      anchor?.setAttribute('transform', `translate(${anchorX} ${y})`);
      if (label) label.textContent = text;
      if (out) out.textContent = text;
      if (input && document.activeElement !== input) input.value = lat.toFixed(1);
    };

    const stopDemo = () => {
      touched = true;
      cancelAnimationFrame(demo);
    };

    const onInput = () => {
      stopDemo();
      if (input) setLat(Number(input.value));
    };
    input?.addEventListener('input', onInput);

    const onPointer = (event: PointerEvent) => {
      if (root.dataset.step !== '2') return;
      const rect = svg.getBoundingClientRect();
      const userY = view[1] + ((event.clientY - rect.top) / rect.height) * view[3];
      const lat = cfg.map.lat0 - userY / cfg.map.scale;
      if (lat < cfg.line.latMin - 1.5 || lat > cfg.line.latMax + 1.5) return;
      stopDemo();
      setLat(lat);
    };
    svg.addEventListener('pointermove', onPointer);
    svg.addEventListener('pointerdown', onPointer);
    cleanups.push(
      () => input?.removeEventListener('input', onInput),
      () => svg.removeEventListener('pointermove', onPointer),
      () => svg.removeEventListener('pointerdown', onPointer),
      () => cancelAnimationFrame(demo),
    );

    // À la première arrivée sur l'étape, la sonde balaie le domaine pour montrer le geste.
    const runDemo = () => {
      if (touched || reduced) return;
      const stops = [10, cfg.line.latMax, cfg.line.latMin, 10];
      const start = performance.now();
      const leg = 900;
      const tick = (now: number) => {
        const t = (now - start - 500) / leg;
        if (t >= stops.length - 1) {
          setLat(stops[stops.length - 1]);
          return;
        }
        if (t > 0) {
          const i = Math.floor(t);
          const p = t - i;
          const e = p < 0.5 ? 2 * p * p : 1 - (-2 * p + 2) ** 2 / 2;
          setLat(stops[i] + (stops[i + 1] - stops[i]) * e);
        }
        demo = requestAnimationFrame(tick);
      };
      demo = requestAnimationFrame(tick);
    };

    /* ---------- Étape active ---------- */

    const steps = [...root.querySelectorAll<HTMLElement>('.stop')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const rail = [...root.querySelectorAll<HTMLAnchorElement>('[data-rail]')];
    let demoDone = false;

    const setStep = (step: string) => {
      if (root.dataset.step === step && panels.some((el) => el.classList.contains('is-active')))
        return;
      root.dataset.step = step;
      panels.forEach((el) => {
        const active = el.dataset.panel === step;
        el.classList.toggle('is-active', active);
        el.inert = !active;
      });
      rail.forEach((a) => {
        if (a.dataset.rail === step) a.setAttribute('aria-current', 'step');
        else a.removeAttribute('aria-current');
      });
      const key = step === '5' ? 'gin' : 'net';
      const hero = false;
      if (key !== focusKey || hero !== heroView) moveTo(key, hero, true);
      if (step === '2' && !demoDone) {
        demoDone = true;
        runDemo();
      }
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) setStep((entry.target as HTMLElement).dataset.step ?? '1');
        });
      },
      { rootMargin: '-50% 0px -50% 0px' },
    );
    steps.forEach((el) => observer.observe(el));
    setStep(root.dataset.step ?? '1');
    cleanups.push(() => observer.disconnect());

    teardown = () => cleanups.forEach((fn) => fn());
  }

  document.addEventListener('astro:page-load', initStory);
  document.addEventListener('astro:before-swap', () => {
    teardown?.();
    teardown = null;
  });
</script>
