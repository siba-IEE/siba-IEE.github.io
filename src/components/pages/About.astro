---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../chrome/PageHeader.astro';
import { SITE, orcidUrl, socialLinks } from '../../lib/site';
import { getLangFromUrl, useTranslations } from '../../lib/i18n';
import { getProfile, getExperience, getSkills, getEducation } from '../../lib/content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const profile = getProfile();
const role = (lang === 'fr' ? profile.roleFr : profile.roleEn) || SITE.role[lang];
const bio = (lang === 'fr' ? profile.bioFr : profile.bioEn) || SITE.bio[lang];
const experience = getExperience();
const education = getEducation();
const skills = getSkills();
---

<BaseLayout title={t('about.pageTitle')} description={bio.slice(0, 155)} ogType="profile">
  <PageHeader title={t('about.pageTitle')} lede={role} />

  <section class="shell py-12 sm:py-14">
    <div class="grid gap-8 md:grid-cols-[auto_1fr] md:items-start">
      <div class="flex items-center gap-5 md:flex-col md:items-start">
        {
          profile.photo ? (
            <img
              src={profile.photo}
              alt={SITE.name}
              width="112"
              height="112"
              class="size-28 rounded-2xl object-cover"
            />
          ) : (
            <span
              class="grid size-28 place-items-center rounded-2xl bg-brand-800 font-display text-4xl font-bold text-white"
              aria-hidden="true"
            >
              S
            </span>
          )
        }
      </div>

      <div>
        <p class="text-sm text-text-muted">{SITE.location[lang]}</p>
        <p class="mt-3 max-w-2xl text-lg leading-relaxed text-text-muted text-pretty">{bio}</p>
      </div>
    </div>

    {
      experience.length > 0 && (
        <div class="mt-12">
          <h2 class="font-display text-xl font-bold tracking-tight">{t('about.experience')}</h2>
          <ol class="mt-5 space-y-5">
            {experience.map((item) => (
              <li class="grid gap-2 border-l-2 border-border pl-5 sm:grid-cols-[10rem_1fr]">
                <p class="text-sm text-text-subtle">
                  {item.start}
                  {item.current
                    ? ` · ${lang === 'fr' ? 'aujourd’hui' : 'present'}`
                    : item.end
                      ? ` · ${item.end}`
                      : ''}
                </p>
                <div>
                  <p class="font-medium">
                    {lang === 'fr' ? item.roleFr : item.roleEn}
                    {item.org && <span class="text-text-muted"> · {item.org}</span>}
                  </p>
                  {(lang === 'fr' ? item.locationFr : item.locationEn) && (
                    <p class="text-sm text-text-subtle">
                      {lang === 'fr' ? item.locationFr : item.locationEn}
                    </p>
                  )}
                  <p class="mt-1 text-sm text-text-muted text-pretty">
                    {lang === 'fr' ? item.descFr : item.descEn}
                  </p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      )
    }

    {
      education.length > 0 && (
        <div class="mt-12">
          <h2 class="font-display text-xl font-bold tracking-tight">{t('about.education')}</h2>
          <ol class="mt-5 space-y-5">
            {education.map((item) => (
              <li class="grid gap-2 border-l-2 border-border pl-5 sm:grid-cols-[10rem_1fr]">
                <p class="text-sm text-text-subtle">
                  {item.start}
                  {item.end ? ` · ${item.end}` : ''}
                </p>
                <div>
                  <p class="font-medium">
                    {lang === 'fr' ? item.titleFr : item.titleEn}
                    {item.school && <span class="text-text-muted"> · {item.school}</span>}
                  </p>
                  {(lang === 'fr' ? item.locationFr : item.locationEn) && (
                    <p class="text-sm text-text-subtle">
                      {lang === 'fr' ? item.locationFr : item.locationEn}
                    </p>
                  )}
                  {(lang === 'fr' ? item.noteFr : item.noteEn) && (
                    <p class="mt-1 text-sm text-text-muted">
                      {lang === 'fr' ? item.noteFr : item.noteEn}
                    </p>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </div>
      )
    }

    {
      skills.length > 0 && (
        <div class="mt-12">
          <h2 class="font-display text-xl font-bold tracking-tight">{t('about.skills')}</h2>
          <div class="mt-5 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {skills.map((group) => (
              <div>
                <h3 class="text-sm font-semibold">
                  {lang === 'fr' ? group.categoryFr : group.categoryEn}
                </h3>
                <ul class="mt-2 flex flex-wrap gap-1.5">
                  {(lang === 'fr' ? group.itemsFr : group.itemsEn).map((item) => (
                    <li class="rounded-md bg-surface-2 px-2 py-0.5 text-xs text-text-muted">{item}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      )
    }

    <div class="mt-12">
      <h2 class="font-display text-xl font-bold tracking-tight">{t('about.elsewhere')}</h2>
      <ul class="mt-5 flex flex-wrap gap-2.5">
        {
          socialLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.key === 'email' ? undefined : '_blank'}
                rel={link.key === 'email' ? undefined : 'me noopener'}
                class="inline-flex items-center gap-2 rounded-full border border-border px-4 py-2 text-sm font-medium transition-colors hover:bg-surface-2"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-3 text-sm text-text-subtle">
        ORCID{' '}
        <a
          href={orcidUrl}
          target="_blank"
          rel="me noopener"
          class="font-mono hover:text-text hover:underline"
        >
          {SITE.orcid}
        </a>
      </p>
    </div>
  </section>
</BaseLayout>
