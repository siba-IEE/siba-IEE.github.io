---
/**
 * Page À propos. Composition d'après les fiches d'associés du studio Pentagram : le nom et
 * le lieu en tête, une colonne de texte serrée à gauche, un grand portrait à droite, puis le
 * parcours en lignes.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE, socialLinks } from '../../lib/site';
import { getLangFromUrl, useTranslations } from '../../lib/i18n';
import { getProfile, getExperience, getSkills, getEducation } from '../../lib/content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isFr = lang === 'fr';

const profile = getProfile();
const bio = isFr ? profile.bioFr : profile.bioEn;
const background = isFr ? profile.backgroundFr : profile.backgroundEn;
const place = isFr ? 'Montréal et Conakry' : 'Montréal and Conakry';

const since = isFr ? 'Depuis' : 'Since';
const dates = (start: string, end: string, current = false) =>
  current ? `${since} ${start}` : end ? `${start}–${end}` : start;
const address = (href: string) =>
  href.replace(/^(https?:\/\/(www\.)?|mailto:)/, '').replace(/\/$/, '');
---

<BaseLayout title={t('about.pageTitle')} description={bio.slice(0, 155)} ogType="profile">
  <section class="block first last">
    <div class="shell">
      <div class="intro">
        <div class="text">
          <h1>
            {SITE.name}
            <span>{place}</span>
          </h1>
          <p>{bio}</p>
          <p>{background}</p>
          <ul>
            {
              socialLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target={link.key === 'email' ? undefined : '_blank'}
                    rel="me noopener"
                    class="group"
                  >
                    <span class="draw">{address(link.href)}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <figure data-portrait>
          <img src="/images/portrait.jpg" alt={SITE.name} width="1080" height="1049" />
        </figure>
      </div>

      <h2 class="label">{t('about.experience')}</h2>
      <ul class="rows">
        {
          getExperience().map((item) => (
            <li data-reveal>
              <span class="when">{dates(item.start, item.end, item.current)}</span>
              <span class="what">{isFr ? item.roleFr : item.roleEn}</span>
              <span class="where">
                {item.org}, {isFr ? item.locationFr : item.locationEn}
              </span>
            </li>
          ))
        }
      </ul>

      <h2 class="label">{t('about.education')}</h2>
      <ul class="rows">
        {
          getEducation().map((item) => (
            <li data-reveal>
              <span class="when">{dates(item.start, item.end)}</span>
              <span class="what">{isFr ? item.titleFr : item.titleEn}</span>
              <span class="where">
                {[item.school, isFr ? item.locationFr : item.locationEn].filter(Boolean).join(', ')}
              </span>
            </li>
          ))
        }
      </ul>

      <h2 class="label">{t('about.skills')}</h2>
      <ul class="rows wip">
        {
          getSkills().map((group) => (
            <li data-reveal>
              <span class="what">{isFr ? group.categoryFr : group.categoryEn}</span>
              <span class="where">{(isFr ? group.itemsFr : group.itemsEn).join(', ')}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    display: grid;
    gap: 2.5rem;
    margin-bottom: 1rem;
  }

  h1 {
    margin: 0 0 2rem;
    font-size: clamp(2rem, 3.6vw, 3.2rem);
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -0.015em;
    color: var(--heading);
  }

  /* Le lieu, sous le nom, dans la même taille mais en gris. */
  h1 span {
    display: block;
    color: var(--text-subtle);
  }

  .text p {
    max-width: 30rem;
    margin: 0 0 0.9rem;
    font-size: 0.98rem;
    line-height: 1.4;
    color: var(--text);
    text-wrap: pretty;
  }

  .text ul {
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 2;
    color: var(--heading);
  }

  figure {
    margin: 0;
    overflow: hidden;
    background: var(--surface-2);
  }

  figure img {
    display: block;
    width: 100%;
    height: auto;
    filter: grayscale(1) contrast(1.06);
    scale: 1.08;
  }

  @media (min-width: 900px) {
    .intro {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 4rem;
      align-items: start;
    }

    .text {
      position: sticky;
      top: 6rem;
    }
  }

  /* Le portrait se dévoile de haut en bas, puis glisse légèrement au défilement. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) figure {
      animation: unveil 1.3s cubic-bezier(0.22, 1, 0.36, 1) 0.15s both;
    }

    :global(.js) .text > :not(h1) {
      animation: rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.35s both;
    }
  }

  @keyframes unveil {
    from {
      clip-path: inset(0 0 100% 0);
    }

    to {
      clip-path: inset(0);
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.9rem);
    }
  }
</style>

<script>
  // Parallaxe du portrait : l'image glisse un peu dans son cadre pendant le défilement.
  let stop: (() => void) | null = null;

  const init = () => {
    stop?.();
    stop = null;
    const frame = document.querySelector<HTMLElement>('[data-portrait]');
    const image = frame?.querySelector('img');
    if (!frame || !image || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let ticking = false;
    const update = () => {
      ticking = false;
      const rect = frame.getBoundingClientRect();
      const offset = (window.innerHeight / 2 - (rect.top + rect.height / 2)) / window.innerHeight;
      image.style.translate = `0 ${(offset * -6).toFixed(2)}%`;
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    update();
    stop = () => window.removeEventListener('scroll', onScroll);
  };

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => {
    stop?.();
    stop = null;
  });
</script>
