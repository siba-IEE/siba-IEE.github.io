---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE, socialLinks } from '../../lib/site';
import { getLangFromUrl, useTranslations } from '../../lib/i18n';
import { getProfile, getExperience, getSkills, getEducation } from '../../lib/content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isFr = lang === 'fr';

const profile = getProfile();
const bio = (isFr ? profile.bioFr : profile.bioEn) || SITE.bio[lang];

const since = isFr ? 'Depuis' : 'Since';
const dates = (start: string, end: string, current = false) =>
  current ? `${since} ${start}` : end ? `${start}–${end}` : start;
---

<BaseLayout title={t('about.pageTitle')} description={bio.slice(0, 155)} ogType="profile">
  <section class="block first last">
    <div class="shell">
      <h1 class="page-title">{t('about.pageTitle')}</h1>
      <div class="bio" data-reveal>
        <img src="/images/portrait.jpg" alt={SITE.name} width="1080" height="1049" />
        <p>{bio}</p>
      </div>

      <h2 class="label">{t('about.experience')}</h2>
      <ul class="rows">
        {
          getExperience().map((item) => (
            <li data-reveal>
              <span class="when">{dates(item.start, item.end, item.current)}</span>
              <span class="what">
                {isFr ? item.roleFr : item.roleEn}
                <small>{isFr ? item.descFr : item.descEn}</small>
              </span>
              <span class="where">
                {item.org}, {isFr ? item.locationFr : item.locationEn}
              </span>
            </li>
          ))
        }
      </ul>

      <h2 class="label">{t('about.education')}</h2>
      <ul class="rows">
        {
          getEducation().map((item) => (
            <li data-reveal>
              <span class="when">{dates(item.start, item.end)}</span>
              <span class="what">{isFr ? item.titleFr : item.titleEn}</span>
              <span class="where">
                {[item.school, isFr ? item.locationFr : item.locationEn].filter(Boolean).join(', ')}
              </span>
            </li>
          ))
        }
      </ul>

      <h2 class="label">{t('about.skills')}</h2>
      <ul class="rows wip">
        {
          getSkills().map((group) => (
            <li data-reveal>
              <span class="what">{isFr ? group.categoryFr : group.categoryEn}</span>
              <span class="where">{(isFr ? group.itemsFr : group.itemsEn).join(', ')}</span>
            </li>
          ))
        }
      </ul>

      <h2 class="label">{t('about.elsewhere')}</h2>
      <ul class="rows wip">
        {
          socialLinks.map((link) => (
            <li data-reveal>
              <span class="what">
                <a
                  href={link.href}
                  target={link.key === 'email' ? undefined : '_blank'}
                  rel="me noopener"
                  class="group"
                >
                  <span class="draw">{link.label}</span>
                </a>
              </span>
              <span class="where">
                {link.href.replace(/^(https?:\/\/|mailto:)/, '').replace(/\/$/, '')}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
