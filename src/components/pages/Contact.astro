---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE, socialLinks } from '../../lib/site';
import { getLangFromUrl, useTranslations } from '../../lib/i18n';

const t = useTranslations(getLangFromUrl(Astro.url));
---

<BaseLayout title={t('contact.pageTitle')} description={t('contact.pageLede')}>
  <section class="block first last">
    <div class="shell">
      <h1 class="page-title">{t('contact.pageTitle')}</h1>
      <a href={`mailto:${SITE.email}`} class="mail">{SITE.email}</a>
      <p class="lead" style="margin-top: 2.5rem">{t('contact.pageLede')}</p>

      <ul class="rows wip" style="margin-top: 5rem">
        {
          socialLinks
            .filter((link) => link.key !== 'email')
            .map((link) => (
              <li data-reveal>
                <span class="what">
                  <a href={link.href} target="_blank" rel="me noopener" class="group">
                    <span class="draw">{link.label}</span>
                  </a>
                </span>
                <span class="where">
                  {link.href.replace(/^https?:\/\//, '').replace(/\/$/, '')}
                </span>
              </li>
            ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
