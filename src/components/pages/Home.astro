---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../projects/ProjectCard.astro';
import { SITE, orcidUrl } from '../../lib/site';
import { getLangFromUrl, localizePath, useTranslations } from '../../lib/i18n';
import { getProfile, getProjects, getPublications } from '../../lib/content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const profile = getProfile();
const role = (lang === 'fr' ? profile.roleFr : profile.roleEn) || SITE.role[lang];
const tagline = (lang === 'fr' ? profile.taglineFr : profile.taglineEn) || SITE.tagline[lang];
const bio = (lang === 'fr' ? profile.bioFr : profile.bioEn) || SITE.bio[lang];

const projects = getProjects();
const publications = getPublications();
const publicationCount = publications.length;
const peerReviewed = publications.filter((p) => p.type === 'journal-article').length;

const stats = [
  {
    value: String(projects.length),
    label: lang === 'fr' ? 'projets dans l’écosystème Kuma' : 'projects in the Kuma ecosystem',
  },
  {
    value: String(peerReviewed),
    label: lang === 'fr' ? 'articles évalués par les pairs' : 'peer-reviewed articles',
  },
  {
    value: '15',
    label: lang === 'fr' ? 'sources de données qualifiées' : 'qualified data sources',
  },
  {
    value: 'FR · EN',
    label: lang === 'fr' ? 'recherche, données et logiciel' : 'research, data and software',
  },
];
---

<BaseLayout description={tagline}>
  {/* Hero */}
  <section class="relative overflow-hidden border-b border-border/60">
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <div class="absolute -top-32 right-[-8rem] size-[46rem] rounded-full bg-brand-400/20 blur-3xl"></div>
      <div
        class="absolute inset-0 opacity-[0.06] [background-image:linear-gradient(var(--border)_1px,transparent_1px),linear-gradient(90deg,var(--border)_1px,transparent_1px)] [background-size:44px_44px] [mask-image:radial-gradient(75%_60%_at_50%_0%,black,transparent)]"
      >
      </div>
    </div>

    <div
      class="shell grid gap-12 pt-16 pb-12 sm:pt-24 lg:grid-cols-[1.25fr_1fr] lg:items-center lg:gap-16"
    >
      <div>
        <p
          class="inline-flex items-center gap-2 rounded-full border border-border bg-surface-2 px-3 py-1 text-xs font-medium text-text-muted"
        >
          <span class="relative flex size-2">
            <span class="absolute inline-flex size-full animate-ping rounded-full bg-brand-500 opacity-75"
            ></span>
            <span class="relative inline-flex size-2 rounded-full bg-brand-500"></span>
          </span>
          {t('hero.availability')}
        </p>

        <h1 class="mt-6 font-display text-5xl font-bold tracking-tight text-balance sm:text-7xl">
          {SITE.name}
        </h1>
        <p class="mt-4 text-xl font-medium text-brand-700 text-pretty">{role}</p>
        <p class="mt-5 max-w-xl text-lg text-text-muted text-pretty">{tagline}</p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            href={localizePath('/projets', lang)}
            class="inline-flex items-center gap-2 rounded-lg bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-brand-700"
          >
            {t('hero.cta.projects')}
            <span aria-hidden="true">&rarr;</span>
          </a>
          <a
            href={localizePath('/contact', lang)}
            class="inline-flex items-center gap-2 rounded-lg border border-border px-5 py-2.5 text-sm font-semibold text-text transition-colors hover:bg-surface-2"
          >
            {t('hero.cta.contact')}
          </a>
        </div>

        <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-text-muted">
          <a href={SITE.github} target="_blank" rel="me noopener" class="hover:text-text">GitHub</a>
          <a href={SITE.linkedin} target="_blank" rel="me noopener" class="hover:text-text">LinkedIn</a>
          <a href={orcidUrl} target="_blank" rel="me noopener" class="hover:text-text">ORCID</a>
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-sm lg:mx-0">
        <div
          class="relative aspect-[4/5] overflow-hidden rounded-2xl border border-border bg-surface-2 shadow-sm"
        >
          {
            profile.photo ? (
              <img
                src={profile.photo}
                alt={SITE.name}
                width="480"
                height="600"
                class="size-full object-cover"
              />
            ) : (
              <div class="flex size-full flex-col items-center justify-center gap-3 bg-gradient-to-br from-brand-500 to-brand-700 text-white">
                <span class="font-display text-7xl font-bold">S</span>
                <span class="text-[0.7rem] uppercase tracking-[0.2em] opacity-80">
                  {lang === 'fr' ? 'portrait à venir' : 'portrait coming'}
                </span>
              </div>
            )
          }
        </div>
        <div class="absolute -bottom-4 -left-4 rounded-xl border border-border bg-surface px-4 py-2.5 shadow-md">
          <p class="font-mono text-[0.7rem] uppercase tracking-wider text-text-subtle">
            {lang === 'fr' ? 'basé entre' : 'based between'}
          </p>
          <p class="text-sm font-semibold">Montréal &harr; Conakry</p>
        </div>
      </div>
    </div>

    <div class="shell pb-14">
      <dl
        class="grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-border bg-border sm:grid-cols-4"
      >
        {
          stats.map((s) => (
            <div class="bg-surface p-5">
              <dt class="font-display text-3xl font-bold tracking-tight text-brand-700">{s.value}</dt>
              <dd class="mt-1 text-sm text-text-muted text-pretty">{s.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  {/* À propos */}
  <section id="a-propos" class="scroll-mt-20 border-t border-border/60">
    <div class="shell py-16">
      <h2 class="font-display text-2xl font-bold tracking-tight">{t('nav.about')}</h2>
      <p class="mt-5 max-w-3xl text-lg leading-relaxed text-text-muted text-pretty">{bio}</p>
      <a
        href={localizePath('/a-propos', lang)}
        class="mt-6 inline-flex items-center gap-1 text-sm font-medium text-brand-700 hover:underline"
      >
        {t('about.pageTitle')}
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </section>

  {/* Projets */}
  <section id="projets" class="scroll-mt-20 border-t border-border/60 bg-surface-2/40">
    <div class="shell py-16">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div class="max-w-2xl">
          <h2 class="font-display text-2xl font-bold tracking-tight">
            {t('section.projects.title')}
          </h2>
          <p class="mt-3 text-text-muted">{t('section.projects.lede')}</p>
        </div>
        <a
          href={localizePath('/projets', lang)}
          class="text-sm font-medium text-brand-700 hover:underline"
        >
          {t('section.projects.all')}
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {projects.map((project) => <ProjectCard project={project} lang={lang} />)}
      </ul>
    </div>
  </section>

  {/* Publications */}
  <section id="publications" class="scroll-mt-20 border-t border-border/60">
    <div class="shell py-16">
      <h2 class="font-display text-2xl font-bold tracking-tight">{t('nav.publications')}</h2>
      <p class="mt-4 max-w-2xl text-text-muted">{t('publications.pageLede')}</p>
      <div class="mt-6 flex flex-wrap items-center gap-4">
        <a
          href={localizePath('/publications', lang)}
          class="inline-flex items-center gap-2 rounded-lg border border-border px-4 py-2 text-sm font-semibold transition-colors hover:bg-surface-2"
        >
          {t('nav.publications')} ({publicationCount})
        </a>
        <a
          href={orcidUrl}
          target="_blank"
          rel="me noopener"
          class="text-sm text-brand-700 underline-offset-4 hover:underline"
        >
          ORCID {SITE.orcid}
        </a>
      </div>
    </div>
  </section>

  {/* Contact */}
  <section id="contact" class="scroll-mt-20 border-t border-border/60 bg-surface-2/40">
    <div class="shell py-16">
      <h2 class="font-display text-2xl font-bold tracking-tight">{t('nav.contact')}</h2>
      <p class="mt-4 max-w-2xl text-text-muted">{t('contact.pageLede')}</p>
      <a
        href={`mailto:${SITE.email}`}
        class="mt-5 inline-flex items-center gap-2 rounded-lg bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brand-700"
      >
        {SITE.email}
      </a>
    </div>
  </section>
</BaseLayout>
