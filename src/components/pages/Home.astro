---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE, orcidUrl } from '../../lib/site';
import { getLangFromUrl, localizePath, useTranslations } from '../../lib/i18n';
import { getProfile, getProjects, getPublications, statusLabels } from '../../lib/content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isFr = lang === 'fr';

const profile = getProfile();
const bio = (isFr ? profile.bioFr : profile.bioEn) || SITE.bio[lang];

const projects = getProjects();
const publications = getPublications();
const publicationCount = publications.length;

// Réalisations = abouti (en ligne) ; Projets = en cours.
const realisations = projects.filter((p) => p.status === 'live');
const enCours = projects.filter((p) => p.status !== 'live');

// Accroche de mission (à affiner librement).
const mission = isFr
  ? 'Fiabiliser la donnée solaire de l’Afrique de l’Ouest.'
  : 'Making West Africa’s solar data trustworthy.';
const missionLede = isFr
  ? 'Chercheur et ingénieur, je bâtis les données, méthodes et outils du solaire ouest-africain.'
  : 'A researcher and engineer building the data, methods and tools of West African solar.';

const pillars = [
  {
    n: '01',
    title: isFr ? 'Recherche & méthode' : 'Research & method',
    desc: isFr
      ? 'Des méthodes de qualification et de transfert de la donnée solaire (calage spatial, incertitude, dégénérescence de pixel), validées et publiées.'
      : 'Methods to qualify and transfer solar data (spatial calibration, uncertainty, pixel degeneracy), validated and published.',
    href: localizePath('/publications', lang),
  },
  {
    n: '02',
    title: isFr ? 'Infrastructure de données' : 'Data infrastructure',
    desc: isFr
      ? 'Kuma Data Core : l’ossature qui ingère, qualifie (A/B/C) et sert des millions de points de données solaires.'
      : 'Kuma Data Core: the backbone that ingests, qualifies (A/B/C) and serves millions of solar data points.',
    href: localizePath('/projets/kuma-data-core', lang),
  },
  {
    n: '03',
    title: isFr ? 'Outils & logiciels' : 'Tools & software',
    desc: isFr
      ? 'Des applications de dimensionnement, desktop et mobile, qui mettent la donnée qualifiée entre les mains des bureaux d’études.'
      : 'Desktop and mobile sizing apps that put qualified data in the hands of design offices.',
    href: localizePath('/projets', lang),
  },
  {
    n: '04',
    title: isFr ? 'Ingénierie énergétique' : 'Energy engineering',
    desc: isFr
      ? 'Audit et optimisation de la performance énergétique des bâtiments : audits, DPE, bilans carbone, simulation.'
      : 'Auditing and optimising building energy performance: audits, EPC, carbon assessments, simulation.',
    href: localizePath('/a-propos', lang),
  },
];
---

<BaseLayout description={missionLede.slice(0, 155)}>
  {/* Hero de mission · bandeau encre */}
  <section class="relative overflow-hidden bg-brand-900 text-white">
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.12] [background-image:linear-gradient(rgba(255,255,255,0.7)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.7)_1px,transparent_1px)] [background-size:46px_46px] [mask-image:radial-gradient(80%_75%_at_25%_0%,black,transparent)]"
      aria-hidden="true"
    >
    </div>
    <div class="shell relative py-14 sm:py-20">
      <p class="inline-flex items-center gap-2 text-xs font-medium tracking-[0.15em] text-white/70 uppercase">
        <span class="relative flex size-2">
          <span class="absolute inline-flex size-full animate-ping rounded-full bg-accent-400 opacity-75"></span>
          <span class="relative inline-flex size-2 rounded-full bg-accent-400"></span>
        </span>
        {t('hero.availability')}
      </p>

      <h1 class="mt-5 max-w-3xl font-display text-4xl font-bold tracking-tight text-balance text-white sm:text-5xl">
        {mission}
      </h1>
      <p class="mt-4 max-w-xl text-base text-white/75 text-pretty">{missionLede}</p>

      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a
          href={localizePath('/projets', lang)}
          class="inline-flex items-center gap-2 rounded-full bg-white px-6 py-3 text-sm font-semibold text-brand-900 transition-transform hover:-translate-y-0.5"
        >
          {isFr ? 'Voir mes travaux' : 'See my work'}
        </a>
        <a
          href={localizePath('/contact', lang)}
          class="inline-flex items-center gap-2 text-sm font-semibold text-white/90 underline-offset-4 hover:underline"
        >
          {t('nav.contact')}
        </a>
      </div>
    </div>
  </section>

  {/* Présentation · panneau encre + portrait */}
  <section data-reveal class="bg-surface-2/60">
    <div class="shell py-12 sm:py-16">
      <div class="grid overflow-hidden rounded-2xl border border-border sm:grid-cols-[1.05fr_0.95fr]">
        <div class="flex flex-col justify-center gap-6 bg-brand-900 p-8 text-white sm:p-10">
          <p class="font-mono text-xs tracking-[0.2em] text-white/50 uppercase">Montréal &harr; Conakry</p>
          <p class="text-lg leading-relaxed text-white/90 text-pretty">{bio}</p>
          <div class="flex flex-wrap items-center gap-4">
            <a
              href={localizePath('/contact', lang)}
              class="inline-flex items-center gap-2 rounded-full bg-white px-6 py-3 text-sm font-semibold text-brand-900 transition-transform hover:-translate-y-0.5"
            >
              {t('nav.contact')}
            </a>
            <a
              href={localizePath('/a-propos', lang)}
              class="text-sm font-semibold text-white/90 underline-offset-4 hover:underline"
            >
              {t('about.pageTitle')}
            </a>
          </div>
        </div>
        <div class="relative min-h-[22rem] bg-surface-3">
          {
            profile.photo ? (
              <img src={profile.photo} alt={SITE.name} class="absolute inset-0 size-full object-cover object-top" />
            ) : (
              <div class="flex size-full flex-col items-center justify-center gap-2 bg-gradient-to-br from-surface-3 to-brand-100">
                <span class="font-display text-6xl font-bold text-brand-800/40">S</span>
                <span class="font-mono text-xs tracking-[0.2em] text-text-subtle uppercase">
                  {isFr ? 'portrait à venir' : 'portrait coming'}
                </span>
              </div>
            )
          }
        </div>
      </div>
    </div>
  </section>

  {/* Ce que je fais · titre figé (sticky) + piliers qui défilent */}
  <section class="relative bg-brand-900 text-white">
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.08] [background-image:linear-gradient(rgba(255,255,255,0.7)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.7)_1px,transparent_1px)] [background-size:46px_46px]"
      aria-hidden="true"
    >
    </div>
    <div class="shell relative py-16 sm:py-24">
      <div class="grid gap-10 lg:grid-cols-[0.72fr_1.28fr] lg:gap-16">
        <div class="lg:sticky lg:top-24 lg:self-start">
          <h2 class="font-display text-2xl font-bold tracking-tight text-white sm:text-3xl">
            {isFr ? 'Ce que je fais' : 'What I do'}
          </h2>
          <p class="mt-4 max-w-sm text-white/70 text-pretty">
            {
              isFr
                ? 'Quatre facettes d’un même fil : rendre l’énergie solaire mesurable, fiable et outillée.'
                : 'Four facets of one thread: making solar energy measurable, reliable and equipped.'
            }
          </p>
        </div>
        <div>
          {
            pillars.map((p) => (
              <a
                href={p.href}
                class="group flex gap-5 border-t border-white/15 py-6 first:border-t-0 first:pt-0 sm:gap-8"
              >
                <span class="pt-1 font-mono text-sm text-accent-400">{p.n}</span>
                <div class="flex-1">
                  <h3 class="font-display text-xl font-bold tracking-tight text-white sm:text-2xl">{p.title}</h3>
                  <p class="mt-2 text-white/70 text-pretty">{p.desc}</p>
                  <span class="mt-3 inline-block text-sm font-medium text-white/90 group-hover:underline">
                    {isFr ? 'En savoir plus' : 'Learn more'}
                  </span>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  {/* Réalisations & projets · aperçu en liste, détail sur /projets */}
  <section class="border-t border-border">
    <div class="shell py-12 sm:py-16">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 class="font-display text-2xl font-bold tracking-tight sm:text-3xl">
          {isFr ? 'Réalisations & projets' : 'Work & projects'}
        </h2>
        <a
          href={localizePath('/projets', lang)}
          class="text-sm font-medium text-brand-700 hover:underline"
        >
          {isFr ? 'Tout voir en détail' : 'See it all in detail'}
        </a>
      </div>

      <ul class="mt-8 border-t border-border">
        {
          [...realisations, ...enCours].map((project) => (
            <li class="border-b border-border">
              <a
                href={localizePath(`/projets/${project.slug}`, lang)}
                class="group grid gap-1 py-5 sm:grid-cols-[1fr_auto] sm:items-baseline sm:gap-8"
              >
                <div>
                  <span class="font-display text-lg font-bold tracking-tight group-hover:underline">
                    {project.title}
                  </span>
                  <p class="mt-1 max-w-2xl text-sm text-text-muted text-pretty">
                    {isFr ? project.summaryFr : project.summaryEn}
                  </p>
                </div>
                <span class="rounded-full bg-surface-3 px-2.5 py-0.5 text-[0.65rem] font-medium tracking-wide text-text-subtle uppercase sm:justify-self-end">
                  {statusLabels[project.status][lang]}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* Publications / reconnaissance */}
  <section data-reveal class="border-t border-border">
    <div class="shell py-12 sm:py-16">
      <h2 class="font-display text-2xl font-bold tracking-tight sm:text-3xl">{t('nav.publications')}</h2>
      <p class="mt-4 max-w-2xl text-text-muted text-pretty">{t('publications.pageLede')}</p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a
          href={localizePath('/publications', lang)}
          class="inline-flex items-center gap-2 rounded-full bg-brand-700 px-5 py-2.5 text-sm font-semibold text-white transition-transform hover:-translate-y-0.5"
        >
          {isFr ? `${publicationCount} références` : `${publicationCount} references`}
        </a>
        <a
          href={orcidUrl}
          target="_blank"
          rel="me noopener"
          class="font-mono text-sm text-brand-700 underline-offset-4 hover:underline"
        >
          ORCID {SITE.orcid}
        </a>
      </div>
    </div>
  </section>

  {/* Contact · bandeau encre */}
  <section data-reveal class="bg-brand-900 text-white">
    <div
      class="shell flex flex-col items-start gap-6 py-16 sm:flex-row sm:items-center sm:justify-between sm:py-20"
    >
      <div>
        <h2 class="font-display text-2xl font-bold tracking-tight text-white sm:text-3xl">{t('nav.contact')}</h2>
        <p class="mt-3 max-w-xl text-white/80 text-pretty">{t('contact.pageLede')}</p>
      </div>
      <a
        href={`mailto:${SITE.email}`}
        class="inline-flex shrink-0 items-center gap-2 rounded-full bg-white px-6 py-3 text-sm font-semibold text-brand-900 transition-transform hover:-translate-y-0.5"
      >
        {SITE.email}
      </a>
    </div>
  </section>

</BaseLayout>
