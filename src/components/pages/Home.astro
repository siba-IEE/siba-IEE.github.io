---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../home/Hero.astro';
import Story from '../home/Story.astro';
import { SITE, orcidUrl } from '../../lib/site';
import { getLangFromUrl, localizePath } from '../../lib/i18n';
import {
  getProfile,
  getProjects,
  getPublications,
  getExperience,
  getResearch,
} from '../../lib/content';

const lang = getLangFromUrl(Astro.url);
const isFr = lang === 'fr';

const profile = getProfile();
const bio = (isFr ? profile.bioFr : profile.bioEn) || SITE.bio[lang];
const tagline = (isFr ? profile.taglineFr : profile.taglineEn) || SITE.tagline[lang];

const projects = getProjects();
const live = projects.filter((p) => p.status === 'live');
const building = projects.filter((p) => p.status === 'wip');
const openResearch = getResearch().filter((w) => w.status === 'wip');
const publications = getPublications();
const experience = getExperience();

const since = isFr ? 'Depuis' : 'Since';
const dates = (start: string, end: string, current: boolean) =>
  current ? `${since} ${start}` : end ? `${start}–${end}` : start;

const typeLabels: Record<string, { fr: string; en: string }> = {
  'journal-article': { fr: 'article', en: 'article' },
  preprint: { fr: 'prépublication', en: 'preprint' },
  'data-set': { fr: 'jeu de données', en: 'dataset' },
  software: { fr: 'logiciel', en: 'software' },
};
const typeLabel = (type: string) => typeLabels[type]?.[lang] ?? type.replace(/[-_]/g, ' ');

const t = isFr
  ? {
      works: 'Réalisations en production',
      allProjects: 'Tous les projets',
      about: 'Parcours',
      aboutMore: 'Formation et compétences',
      pubs: 'Publications',
      orcid: 'Profil ORCID',
      wip: 'En cours',
      contact: 'Contact',
      contactLede:
        'Pour un programme de données énergétiques, une étude de ressource solaire ou un appui technique à un projet en Guinée. Je réponds en français ou en anglais.',
      services: 'Prestations et tarifs',
    }
  : {
      works: 'Work in production',
      allProjects: 'All projects',
      about: 'Background',
      aboutMore: 'Education and skills',
      pubs: 'Publications',
      orcid: 'ORCID profile',
      wip: 'In progress',
      contact: 'Contact',
      contactLede:
        'For an energy-data programme, a solar resource study or technical support for a project in Guinea. I reply in French or English.',
      services: 'Services and prices',
    };

const upcoming = [
  ...openResearch.map((w) => ({
    title: isFr ? w.titleFr : w.titleEn,
    text: isFr ? w.summaryFr : w.summaryEn,
    href: localizePath('/travaux', lang),
  })),
  ...building.map((p) => ({
    title: p.title,
    text: isFr ? p.summaryFr : p.summaryEn,
    href: `${localizePath('/projets', lang)}#${p.slug}`,
  })),
];
---

<BaseLayout description={tagline.slice(0, 158)}>
  <Hero />

  <Story />

  {/* Réalisations : la capture d'écran de chaque système en ligne */}
  <section id="production" class="block scroll-mt-16">
    <div class="shell">
      <h2 class="label" data-reveal>{t.works}</h2>
      <ul class="works">
        {
          live.map((project) => (
            <li data-reveal>
              <a
                href={project.url ?? `${localizePath('/projets', lang)}#${project.slug}`}
                target="_blank"
                rel="noopener"
              >
                {project.image && (
                  <span class="shot">
                    <img src={project.image} alt="" width="1200" height="750" loading="lazy" />
                  </span>
                )}
                <span class="name">{project.title}</span>
                <span class="desc">{isFr ? project.summaryFr : project.summaryEn}</span>
                <span class="host">{project.links?.[0]?.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <a href={localizePath('/projets', lang)} class="more">{t.allProjects}</a>
    </div>
  </section>

  {/* Parcours */}
  <section class="block">
    <div class="shell">
      <h2 class="label" data-reveal>{t.about}</h2>
      <div class="bio" data-reveal>
        <img src="/images/portrait.jpg" alt={SITE.name} width="1080" height="1049" loading="lazy" />
        <p>{bio}</p>
      </div>
      <ul class="rows after-bio">
        {
          experience.map((item, i) => (
            <li data-reveal style={`--reveal-delay:${i * 50}ms`}>
              <span class="when">{dates(item.start, item.end, item.current)}</span>
              <span class="what">{isFr ? item.roleFr : item.roleEn}</span>
              <span class="where">
                {item.org}, {isFr ? item.locationFr : item.locationEn}
              </span>
            </li>
          ))
        }
      </ul>
      <a href={localizePath('/a-propos', lang)} class="more">{t.aboutMore}</a>
    </div>
  </section>

  {/* Publications */}
  <section class="block">
    <div class="shell">
      <h2 class="label" data-reveal>{t.pubs}</h2>
      <ul class="rows">
        {
          publications.map((pub, i) => (
            <li data-reveal style={`--reveal-delay:${i * 50}ms`}>
              <span class="when">
                {pub.year}, {typeLabel(pub.type)}
              </span>
              <span class="what">
                <a
                  href={pub.url ?? (pub.doi ? `https://doi.org/${pub.doi}` : '#')}
                  target="_blank"
                  rel="noopener"
                  class="group"
                >
                  <span class="draw">{pub.title}</span>
                </a>
                <small>
                  {pub.authors.map((author, a) => (
                    <>
                      {a > 0 && ', '}
                      {author.includes('Kalivogui') ? <b>{author}</b> : author}
                    </>
                  ))}
                  {pub.authors.length > 0 && pub.venue && '. '}
                  {pub.venue}
                </small>
              </span>
              <span class="where doi">{pub.doi?.toLowerCase()}</span>
            </li>
          ))
        }
      </ul>
      <a href={orcidUrl} target="_blank" rel="me noopener" class="more">{t.orcid}</a>
    </div>
  </section>

  {/* En cours */}
  {
    upcoming.length > 0 && (
      <section class="block">
        <div class="shell">
          <h2 class="label" data-reveal>
            {t.wip}
          </h2>
          <ul class="rows wip">
            {upcoming.map((item, i) => (
              <li data-reveal style={`--reveal-delay:${i * 50}ms`}>
                <span class="what">
                  <a href={item.href} class="group">
                    <span class="draw">{item.title}</span>
                  </a>
                </span>
                <span class="where">{item.text}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {/* Contact */}
  <section class="contact">
    <div class="shell">
      <h2 class="label" data-reveal>{t.contact}</h2>
      <a href={`mailto:${SITE.email}`} class="mail" data-reveal>{SITE.email}</a>
      <p data-reveal>{t.contactLede}</p>
      <a href={localizePath('/services', lang)} class="more" data-reveal>{t.services}</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Sections ---------- */

  .block,
  .contact {
    padding-block: 5rem 0;
    background: var(--surface);
  }

  .contact {
    padding-bottom: 5rem;
  }

  @media (min-width: 1024px) {
    .block,
    .contact {
      padding-block: 9rem 0;
    }

    .contact {
      padding-bottom: 9rem;
    }
  }

  .label {
    margin: 0 0 1.5rem;
    font-size: 0.95rem;
    font-weight: 400;
    color: var(--text-subtle);
  }

  .more {
    display: inline-block;
    margin-top: 2rem;
    font-size: 0.95rem;
    color: var(--heading);
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 5px;
    transition: text-decoration-color 0.2s ease;
  }

  .more:hover {
    text-decoration-color: var(--heading);
  }

  /* Réalisations : grille à largeurs alternées, pour que les captures ne s'alignent pas en damier. */
  .works {
    display: grid;
    gap: 3rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 900px) {
    .works {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 5rem 2rem;
    }

    .works li {
      grid-column: span 7;
    }

    .works li:nth-child(4n + 2),
    .works li:nth-child(4n + 3) {
      grid-column: span 5;
    }
  }

  .works a {
    display: grid;
    gap: 0.3rem;
    color: var(--text-muted);
  }

  .shot {
    display: block;
    margin-bottom: 0.9rem;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--panel);
  }

  .shot img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
    transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .works a:hover .shot img {
    transform: scale(1.04);
  }

  .works .name {
    font-size: 1.35rem;
    font-weight: 500;
    letter-spacing: -0.03em;
    color: var(--heading);
  }

  .works .desc {
    max-width: 34rem;
    font-size: 0.95rem;
    line-height: 1.45;
    text-wrap: pretty;
  }

  .works .host {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    overflow-wrap: anywhere;
  }

  /* Parcours */
  .bio {
    max-width: 70rem;
  }

  .bio p {
    margin: 0;
    font-size: clamp(1.3rem, 2.5vw, 2.3rem);
    line-height: 1.16;
    letter-spacing: -0.035em;
    color: var(--heading);
    text-wrap: pretty;
  }

  .bio img {
    float: right;
    width: clamp(8rem, 24vw, 21rem);
    height: auto;
    margin: 0.3rem 0 1rem 2rem;
    filter: grayscale(1) contrast(1.08);
    transition: filter 0.5s ease;
  }

  .bio img:hover {
    filter: none;
  }

  /* Listes : une ligne par entrée, rien d'autre. */
  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
    clear: both;
    border-top: 1px solid var(--border);
  }

  .rows.after-bio {
    margin-top: 3.5rem;
  }

  .rows li {
    display: grid;
    gap: 0.15rem 2rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--border);
    font-size: 0.98rem;
    color: var(--text-muted);
    transition: padding-left 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .rows li:hover {
    padding-left: 0.6rem;
  }

  @media (min-width: 900px) {
    .rows li {
      grid-template-columns: 11rem minmax(0, 6fr) minmax(0, 5fr);
      align-items: baseline;
    }

    .rows.wip li {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }
  }

  .rows .when {
    font-size: 0.85rem;
    color: var(--text-subtle);
  }

  .rows .what {
    color: var(--heading);
  }

  .rows small {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.82rem;
    line-height: 1.45;
    color: var(--text-muted);
  }

  .rows small b {
    font-weight: 500;
    color: var(--heading);
  }

  .rows .doi {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    overflow-wrap: anywhere;
  }

  @media (min-width: 900px) {
    .rows .doi {
      text-align: right;
    }
  }

  /* Contact */
  .mail {
    display: inline-block;
    font-size: clamp(1.7rem, 7.4vw, 7rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.05em;
    color: var(--heading);
    overflow-wrap: anywhere;
    background: linear-gradient(var(--color-accent-400), var(--color-accent-400)) 0 100% / 100% 0
      no-repeat;
    transition:
      background-size 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      color 0.3s ease;
  }

  .mail:hover {
    background-size: 100% 100%;
    color: #111;
  }

  .contact p {
    max-width: 34rem;
    margin: 2rem 0 0;
    color: var(--text-muted);
    text-wrap: pretty;
  }
</style>
