---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../home/Hero.astro';
import { SITE } from '../../lib/site';
import { getLangFromUrl } from '../../lib/i18n';
import { getProfile } from '../../lib/content';

const lang = getLangFromUrl(Astro.url);
const isFr = lang === 'fr';

const profile = getProfile();
const tagline = (isFr ? profile.taglineFr : profile.taglineEn) || SITE.tagline[lang];
---

<BaseLayout description={tagline.slice(0, 158)}>
  <Hero />

  <section class="contact">
    <div class="shell">
      <h2 class="label" data-reveal>Contact</h2>
      <a href={`mailto:${SITE.email}`} class="mail" data-reveal>{SITE.email}</a>
    </div>
  </section>
</BaseLayout>
