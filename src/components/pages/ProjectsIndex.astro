---
/**
 * Page Projets. Composition d'après la page « Work » du studio Fathom : fond sombre, une
 * grande image par projet, placée en décalé, le nom et une phrase posés à côté. Les images
 * se chevauchent d'un projet au suivant. Un clic ouvre la fiche (ProjectSheet).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectSheet from '../home/ProjectSheet.astro';
import { getLangFromUrl, useTranslations } from '../../lib/i18n';
import { getProjects, statusLabels } from '../../lib/content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isFr = lang === 'fr';

const projects = getProjects();
const more = isFr ? 'Voir la fiche' : 'View details';
---

<BaseLayout title={t('projects.pageTitle')} description={t('projects.pageLede')}>
  <section class="page">
    <div class="shell">
      <h1>{t('projects.pageTitle')}</h1>
      <ol>
        {
          projects.map((project) => (
            <li id={project.slug} data-reveal>
              {project.image && (
                <button
                  type="button"
                  class="shot"
                  data-sheet-open={project.slug}
                  aria-label={project.title}
                >
                  <img src={project.image} alt="" loading="lazy" data-parallax />
                </button>
              )}
              <div class="text">
                <h2>
                  {project.title}
                  {project.status !== 'live' && <span>{statusLabels[project.status][lang]}</span>}
                </h2>
                <p>{isFr ? project.summaryFr : project.summaryEn}</p>
                <button type="button" class="open" data-sheet-open={project.slug}>
                  {more}
                </button>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
  <ProjectSheet projects={projects} />
</BaseLayout>

<style>
  /* Comme l'accueil, la page reste sombre dans les deux thèmes : les images y ressortent. */
  .page {
    padding-block: 3.5rem 7rem;
    background: #0a0a0a;
    color: #fff;
  }

  h1 {
    margin: 0;
    font-size: clamp(3rem, 9vw, 8rem);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.055em;
    color: #fff;
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    gap: 1.25rem;
    margin-top: 4rem;
    scroll-margin-top: 6rem;
  }

  .shot {
    display: block;
    padding: 0;
    overflow: hidden;
    cursor: pointer;
  }

  .shot img {
    display: block;
    width: 100%;
    height: auto;
    /* Légèrement agrandie pour que la parallaxe ne découvre jamais le bord du cadre. */
    scale: 1.07;
    transition: scale 1.2s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .shot:hover img {
    scale: 1.11;
  }

  h2 {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    color: #fff;
  }

  h2 span {
    margin-left: 0.75rem;
    font-weight: 400;
    color: rgb(255 255 255 / 55%);
  }

  .text p {
    margin: 0.6rem 0 0;
    font-size: clamp(1.15rem, 1.7vw, 1.5rem);
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: rgb(255 255 255 / 78%);
    text-wrap: pretty;
  }

  .open {
    margin-top: 1rem;
    padding: 0;
    font: inherit;
    font-size: 0.9rem;
    color: #fff;
    text-decoration: underline;
    text-decoration-color: rgb(255 255 255 / 40%);
    text-underline-offset: 5px;
    cursor: pointer;
    transition: text-decoration-color 0.2s ease;
  }

  .open:hover {
    text-decoration-color: #fff;
  }

  /* L'image se dévoile de bas en haut quand le projet entre à l'écran. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) li .shot {
      clip-path: inset(100% 0 0 0);
      transition: clip-path 1.1s cubic-bezier(0.22, 1, 0.36, 1);
    }

    :global(.js) li[data-revealed] .shot {
      clip-path: inset(0);
    }
  }

  /* Ordinateur : trois placements qui alternent, et des images qui se chevauchent. */
  @media (min-width: 1024px) {
    li {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 0 2rem;
      align-items: end;
      margin-top: 7rem;
    }

    .shot,
    .text {
      grid-row: 1;
    }

    li:nth-child(3n + 1) .shot {
      grid-column: 3 / span 6;
    }

    li:nth-child(3n + 1) .text {
      grid-column: 9 / span 4;
      padding-bottom: 1.5rem;
    }

    li:nth-child(3n + 2) {
      position: relative;
      z-index: 1;
      margin-top: -4rem;
    }

    li:nth-child(3n + 2) .shot {
      grid-column: 1 / span 5;
    }

    li:nth-child(3n + 2) .text {
      grid-column: 6 / span 4;
      align-self: center;
      padding-top: 6rem;
    }

    li:nth-child(3n) .shot {
      grid-column: 5 / span 8;
    }

    li:nth-child(3n) .text {
      grid-column: 1 / span 4;
      align-self: start;
      padding-top: 2rem;
    }

    li:nth-child(3n + 1):not(:first-child) {
      position: relative;
      z-index: 1;
      margin-top: -3rem;
    }
  }
</style>

<script>
  // Parallaxe : chaque image glisse légèrement dans son cadre pendant le défilement.
  let stop: (() => void) | null = null;

  const init = () => {
    stop?.();
    stop = null;
    const images = [...document.querySelectorAll<HTMLElement>('[data-parallax]')];
    if (!images.length || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let ticking = false;
    const update = () => {
      ticking = false;
      for (const image of images) {
        const rect = image.parentElement!.getBoundingClientRect();
        if (rect.bottom < 0 || rect.top > window.innerHeight) continue;
        // -1 quand le cadre entre par le bas, +1 quand il sort par le haut.
        const offset =
          (window.innerHeight / 2 - (rect.top + rect.height / 2)) / (window.innerHeight / 2);
        image.style.translate = `0 ${(offset * 3).toFixed(2)}%`;
      }
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    update();
    stop = () => window.removeEventListener('scroll', onScroll);
  };

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => {
    stop?.();
    stop = null;
  });
</script>
