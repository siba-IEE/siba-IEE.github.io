---
/**
 * Page Projets : la liste des noms à gauche, un seul cadre d'image à droite. Le cadre montre
 * le projet survolé ; un clic ouvre la fiche (ProjectSheet). Sur mobile, la liste seule.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectSheet from '../home/ProjectSheet.astro';
import { getLangFromUrl, useTranslations } from '../../lib/i18n';
import { getProjects, statusLabels } from '../../lib/content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isFr = lang === 'fr';
const projects = getProjects();
---

<BaseLayout title={t('projects.pageTitle')} description={t('projects.pageLede')} footer={false}>
  <section class="page" data-index>
    <div class="shell">
      <div class="list">
        <h1>{t('projects.pageTitle')}</h1>
        <ul>
          {
            projects.map((project, index) => (
              <li id={project.slug}>
                <button
                  type="button"
                  data-item={project.slug}
                  data-sheet-open={project.slug}
                  aria-current={index === 0 ? 'true' : undefined}
                >
                  <span class="name">
                    {project.title}
                    {project.status !== 'live' && (
                      <small>{statusLabels[project.status][lang]}</small>
                    )}
                  </span>
                  <span class="summary">
                    <span>{isFr ? project.summaryFr : project.summaryEn}</span>
                  </span>
                </button>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="frame" aria-hidden="true">
        {
          projects.map((project, index) =>
            project.image ? (
              <img
                src={project.image}
                alt=""
                data-shot={project.slug}
                data-on={index === 0 ? '' : undefined}
              />
            ) : null,
          )
        }
      </div>
    </div>
  </section>
  <ProjectSheet projects={projects} />
</BaseLayout>

<style>
  /* Comme l'accueil, la page reste sombre dans les deux thèmes. */
  .page {
    --nav: 4rem;

    min-height: calc(100svh - var(--nav));
    padding-block: 3rem 4rem;
    background: #0a0a0a;
    color: #fff;
  }

  h1 {
    margin: 0 0 2.5rem;
    font-size: 0.95rem;
    font-weight: 400;
    letter-spacing: 0;
    color: rgb(255 255 255 / 55%);
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  button {
    display: block;
    width: 100%;
    padding: 0.35rem 0;
    font: inherit;
    color: inherit;
    text-align: left;
    cursor: pointer;
  }

  .name {
    display: block;
    font-size: clamp(1.9rem, 4.2vw, 3.6rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.05em;
    color: rgb(255 255 255 / 32%);
    transition: color 0.35s ease;
  }

  .name small {
    margin-left: 0.9rem;
    font-size: 0.85rem;
    font-weight: 400;
    letter-spacing: 0;
    vertical-align: middle;
  }

  /* Le résumé se déplie sous le nom actif. */
  .summary {
    display: grid;
    grid-template-rows: 0fr;
    max-width: 30rem;
    font-size: 0.98rem;
    line-height: 1.45;
    color: rgb(255 255 255 / 70%);
    transition: grid-template-rows 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .summary span {
    overflow: hidden;
  }

  button[aria-current] .name {
    color: #fff;
  }

  button[aria-current] .summary {
    grid-template-rows: 1fr;
    padding-block: 0.4rem 0.9rem;
  }

  .frame {
    display: none;
  }

  @media (min-width: 1024px) {
    .shell {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 4rem;
      align-items: start;
    }

    .frame {
      position: sticky;
      top: calc(var(--nav) + 3rem);
      display: block;
      aspect-ratio: 16 / 10;
      margin-top: 3.5rem;
      overflow: hidden;
      background: #141414;
    }

    .frame img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: left top;
      clip-path: inset(0 0 100% 0);
      scale: 1.06;
      transition:
        clip-path 0.7s cubic-bezier(0.22, 1, 0.36, 1),
        scale 1.2s cubic-bezier(0.22, 1, 0.36, 1);
    }

    /* L'image active se dévoile de haut en bas, par-dessus la précédente. */
    .frame img[data-on] {
      z-index: 1;
      clip-path: inset(0);
      scale: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .frame img,
    .summary {
      transition: none;
    }
  }
</style>

<script>
  // Le cadre suit le nom survolé ou atteint au clavier.
  const init = () => {
    const root = document.querySelector<HTMLElement>('[data-index]');
    if (!root || root.dataset.bound) return;
    root.dataset.bound = 'true';
    const items = [...root.querySelectorAll<HTMLButtonElement>('[data-item]')];
    const shots = [...root.querySelectorAll<HTMLImageElement>('[data-shot]')];

    const show = (slug: string) => {
      items.forEach((item) => {
        if (item.dataset.item === slug) item.setAttribute('aria-current', 'true');
        else item.removeAttribute('aria-current');
      });
      shots.forEach((shot) => shot.toggleAttribute('data-on', shot.dataset.shot === slug));
    };
    items.forEach((item) => {
      const activate = () => show(item.dataset.item ?? '');
      item.addEventListener('pointerenter', activate);
      item.addEventListener('focus', activate);
    });
  };

  document.addEventListener('astro:page-load', init);
</script>
