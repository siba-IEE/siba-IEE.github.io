---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangFromUrl, useTranslations } from '../../lib/i18n';
import { getProjects, statusLabels } from '../../lib/content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isFr = lang === 'fr';

const projects = getProjects();
const groups = [
  { status: 'live' as const, items: projects.filter((p) => p.status === 'live') },
  { status: 'wip' as const, items: projects.filter((p) => p.status !== 'live') },
].filter((group) => group.items.length > 0);
---

<BaseLayout title={t('projects.pageTitle')} description={t('projects.pageLede')}>
  <section class="block first last">
    <div class="shell">
      <h1 class="page-title">{t('projects.pageTitle')}</h1>
      {
        groups.map((group) => (
          <>
            <h2 class="label">{statusLabels[group.status][lang]}</h2>
            <ul class="works">
              {group.items.map((project) => (
                <li id={project.slug} class="scroll-mt-24" data-reveal>
                  <div class="work">
                    {project.image && (
                      <span class="shot">
                        <img src={project.image} alt="" width="1200" height="750" loading="lazy" />
                      </span>
                    )}
                    <span class="name">{project.title}</span>
                    <span class="desc">{isFr ? project.summaryFr : project.summaryEn}</span>
                    {(project.links ?? []).map((link) => (
                      <a href={link.url} target="_blank" rel="noopener" class="host group">
                        <span class="draw">{link.label}</span>
                      </a>
                    ))}
                  </div>
                </li>
              ))}
            </ul>
          </>
        ))
      }
    </div>
  </section>
</BaseLayout>
