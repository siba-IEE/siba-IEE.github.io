---
/**
 * Page Travaux : une maquette 3D qui raconte les travaux étape par étape, puis la figure
 * interactive de la prépublication (d'après les articles de la revue Distill) et les publications.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import BiasFigure from '../research/BiasFigure.astro';
import Diorama from '../research/Diorama.astro';
import { SITE } from '../../lib/site';
import { getLangFromUrl } from '../../lib/i18n';
import { getResearch, getPublications } from '../../lib/content';

const lang = getLangFromUrl(Astro.url);
const isFr = lang === 'fr';

const [paper] = getResearch();
const publications = getPublications();
const doi = paper.url?.replace('https://doi.org/', '');

const t = isFr
  ? { title: 'Travaux', meta: 'Prépublication, octobre 2026', publications: 'Publications' }
  : { title: 'Research', meta: 'Preprint, October 2026', publications: 'Publications' };
---

<BaseLayout title={t.title} description={isFr ? paper.summaryFr : paper.summaryEn}>
  <Diorama />

  <article class="block">
    <div class="shell">
      <h2 class="paper-title">{isFr ? paper.titleFr : paper.titleEn}</h2>
      <BiasFigure />
      <p class="byline">
        <span>{SITE.name}</span>
        <span>{t.meta}</span>
        {
          paper.url && (
            <a href={paper.url} target="_blank" rel="noopener" class="group">
              <span class="draw">doi:{doi}</span>
            </a>
          )
        }
      </p>
    </div>
  </article>

  <section class="block last">
    <div class="shell">
      <h2 class="label">{t.publications}</h2>
      <ul class="rows">
        {
          publications.map((pub) => (
            <li data-reveal>
              <span class="when">{pub.year}</span>
              <span class="what">
                <a
                  href={pub.url ?? `https://doi.org/${pub.doi}`}
                  target="_blank"
                  rel="noopener"
                  class="group"
                >
                  <span class="draw">{pub.title}</span>
                </a>
                <small>{[pub.authors.join(', '), pub.venue].filter(Boolean).join('. ')}</small>
              </span>
              <span class="where doi">{pub.doi?.toLowerCase()}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .paper-title {
    max-width: 60rem;
    margin: 0 0 2.5rem;
    font-size: clamp(2.2rem, 5.6vw, 5rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.05em;
    color: var(--heading);
    text-wrap: balance;
  }

  .byline {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 2.5rem;
    margin: 2.5rem 0 0;
    padding-block: 1rem;
    border-block: 1px solid var(--border);
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .byline a {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--heading);
  }
</style>
