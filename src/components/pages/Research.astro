---
import { marked } from 'marked';
import katex from 'katex';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangFromUrl } from '../../lib/i18n';
import { getResearch, getPublications } from '../../lib/content';
import 'katex/dist/katex.min.css';

const lang = getLangFromUrl(Astro.url);
const isFr = lang === 'fr';
const works = getResearch();
const publications = getPublications();

// KaTeX est rendu au build, avant le markdown : sinon CommonMark déséchappe les commandes
// LaTeX (\, \; \{ \}) et casse les formules. Les maths sont remplacées par des jetons
// neutres, puis réinjectées une fois le markdown converti.
function render(source: string, inline = false): string {
  const blocks: string[] = [];
  const stash = (tex: string, displayMode: boolean) => {
    blocks.push(
      katex.renderToString(tex.trim(), { displayMode, throwOnError: false, strict: false }),
    );
    return `@@KMATH${blocks.length - 1}@@`;
  };
  const text = source
    .replace(/\$\$([\s\S]+?)\$\$/g, (_match, tex) => stash(tex, true))
    .replace(/\$([^\n$]+?)\$/g, (_match, tex) => stash(tex, false));
  const html = (inline ? marked.parseInline(text) : marked.parse(text)) as string;
  return html
    .replace(/@@KMATH(\d+)@@/g, (_match, index) => blocks[Number(index)])
    .replace(/<p>(\s*<span class="katex-display">[\s\S]*?<\/span>\s*)<\/p>/g, '$1');
}
const list = (items: string[]) =>
  ['<ol>', ...items.map((item) => ['<li>', render(item, true), '</li>'].join('')), '</ol>'].join(
    '',
  );

const title = isFr ? 'Travaux' : 'Research';
const lede = isFr
  ? 'Travaux sur les données de rayonnement solaire en Afrique de l’Ouest.'
  : 'Work on solar radiation data in West Africa.';
const labels = isFr
  ? {
      problem: 'Problématique',
      hypotheses: 'Hypothèses',
      method: 'Méthode',
      results: 'Résultats',
      questions: 'Limites et suites',
      paper: 'Lire la prépublication',
    }
  : {
      problem: 'Problem',
      hypotheses: 'Hypotheses',
      method: 'Method',
      results: 'Results',
      questions: 'Limits and next steps',
      paper: 'Read the preprint',
    };
---

<BaseLayout title={title} description={lede}>
  <section class="block first">
    <div class="shell">
      <h1 class="page-title">{title}</h1>
    </div>
  </section>

  {
    works.map((work, index) => {
      const figures = (work.figures ?? []).map((figure) => ({
        src: !isFr && figure.srcEn ? figure.srcEn : figure.src,
        caption: isFr ? figure.captionFr : figure.captionEn,
        featured: figure.featured,
      }));
      const main = figures.find((figure) => figure.featured) ?? figures[0];
      const others = figures.filter((figure) => figure !== main);
      const parts = [
        { label: labels.problem, html: render(isFr ? work.problemFr : work.problemEn) },
        { label: labels.hypotheses, html: list(isFr ? work.hypothesesFr : work.hypothesesEn) },
        { label: labels.method, html: render(isFr ? work.methodFr : work.methodEn) },
        { label: labels.results, html: render(isFr ? work.resultsFr : work.resultsEn) },
        { label: labels.questions, html: list(isFr ? work.questionsFr : work.questionsEn) },
      ];
      return (
        <section
          id={`travail-${index + 1}`}
          class:list={['block scroll-mt-16', index === 0 && 'first', false]}
        >
          <div class="shell">
            <h2 class="work-title" data-reveal>
              {isFr ? work.titleFr : work.titleEn}
            </h2>
            <p class="lead" data-reveal>
              {isFr ? work.summaryFr : work.summaryEn}
            </p>
            {work.url && (
              <a href={work.url} target="_blank" rel="noopener" class="more">
                {labels.paper}
              </a>
            )}
            {work.url && work.preview && (
              <a href={work.url} target="_blank" rel="noopener" class="figure" data-reveal>
                <img src={work.preview} alt="" loading="lazy" />
              </a>
            )}

            {main && (
              <figure class="figure" data-reveal>
                <img src={main.src} alt="" loading="lazy" />
                <figcaption>{main.caption}</figcaption>
              </figure>
            )}

            {parts.map((part) => (
              <div class="part" data-reveal>
                <h3>{part.label}</h3>
                <div class="prose" set:html={part.html} />
              </div>
            ))}

            {others.length > 0 && (
              <div class="figures">
                {others.map((figure) => (
                  <figure class="figure" data-reveal>
                    <img src={figure.src} alt="" loading="lazy" />
                    <figcaption>{figure.caption}</figcaption>
                  </figure>
                ))}
              </div>
            )}
          </div>
        </section>
      );
    })
  }

  <section class="block last">
    <div class="shell">
      <h2 class="label">Publications</h2>
      <ul class="rows">
        {
          publications.map((pub) => (
            <li data-reveal>
              <span class="when">{pub.year}</span>
              <span class="what">
                <a
                  href={pub.url ?? `https://doi.org/${pub.doi}`}
                  target="_blank"
                  rel="noopener"
                  class="group"
                >
                  <span class="draw">{pub.title}</span>
                </a>
                <small>{[pub.authors.join(', '), pub.venue].filter(Boolean).join('. ')}</small>
              </span>
              <span class="where doi">{pub.doi?.toLowerCase()}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
