---
/**
 * Page Travaux. Composition d'après les articles de la revue Distill : le titre, une figure
 * interactive en pleine largeur, puis une colonne de texte étroite.
 */
import { marked } from 'marked';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BiasFigure from '../research/BiasFigure.astro';
import { SITE } from '../../lib/site';
import { getLangFromUrl } from '../../lib/i18n';
import { getResearch, getPublications } from '../../lib/content';

const lang = getLangFromUrl(Astro.url);
const isFr = lang === 'fr';

const [paper, ...others] = getResearch();
const publications = getPublications();
const figures = (paper.figures ?? []).filter(
  (figure) => !figure.featured && figure.section === 'result',
);
const doi = paper.url?.replace('https://doi.org/', '');

const t = isFr
  ? {
      title: 'Travaux',
      meta: 'Prépublication, octobre 2026',
      limits: 'Limites',
      read: 'Lire la prépublication',
      ongoing: 'En cours',
      publications: 'Publications',
    }
  : {
      title: 'Research',
      meta: 'Preprint, October 2026',
      limits: 'Limits',
      read: 'Read the preprint',
      ongoing: 'In progress',
      publications: 'Publications',
    };
---

<BaseLayout title={t.title} description={isFr ? paper.summaryFr : paper.summaryEn}>
  <article class="block first">
    <div class="shell">
      <h1 class="paper-title">{isFr ? paper.titleFr : paper.titleEn}</h1>
      <BiasFigure />

      <p class="byline">
        <span>{SITE.name}</span>
        <span>{t.meta}</span>
        {
          paper.url && (
            <a href={paper.url} target="_blank" rel="noopener" class="group">
              <span class="draw">doi:{doi}</span>
            </a>
          )
        }
      </p>

      <div class="column">
        <p class="lead">{isFr ? paper.summaryFr : paper.summaryEn}</p>
        <div class="prose" set:html={marked.parse(isFr ? paper.resultsFr : paper.resultsEn)} />
      </div>

      {
        figures.map((figure) => (
          <figure class="figure wide" data-reveal>
            <img src={!isFr && figure.srcEn ? figure.srcEn : figure.src} alt="" loading="lazy" />
            <figcaption>{isFr ? figure.captionFr : figure.captionEn}</figcaption>
          </figure>
        ))
      }

      <div class="column">
        <h2 class="label">{t.limits}</h2>
        <ul class="prose">
          {(isFr ? paper.questionsFr : paper.questionsEn).map((item) => <li>{item}</li>)}
        </ul>
        {
          paper.url && (
            <a href={paper.url} target="_blank" rel="noopener" class="more">
              {t.read}
            </a>
          )
        }
      </div>
    </div>
  </article>

  <section class="block last">
    <div class="shell">
      {
        others.length > 0 && (
          <>
            <h2 class="label">{t.ongoing}</h2>
            <ul class="rows wip">
              {others.map((work) => (
                <li data-reveal>
                  <span class="what">{isFr ? work.titleFr : work.titleEn}</span>
                  <span class="where">{isFr ? work.summaryFr : work.summaryEn}</span>
                </li>
              ))}
            </ul>
          </>
        )
      }

      <h2 class="label">{t.publications}</h2>
      <ul class="rows">
        {
          publications.map((pub) => (
            <li data-reveal>
              <span class="when">{pub.year}</span>
              <span class="what">
                <a
                  href={pub.url ?? `https://doi.org/${pub.doi}`}
                  target="_blank"
                  rel="noopener"
                  class="group"
                >
                  <span class="draw">{pub.title}</span>
                </a>
                <small>{[pub.authors.join(', '), pub.venue].filter(Boolean).join('. ')}</small>
              </span>
              <span class="where doi">{pub.doi?.toLowerCase()}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .paper-title {
    max-width: 60rem;
    margin: 0 0 2.5rem;
    font-size: clamp(2.2rem, 5.6vw, 5rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.05em;
    color: var(--heading);
    text-wrap: balance;
  }

  .byline {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 2.5rem;
    margin: 2.5rem 0 0;
    padding-block: 1rem;
    border-block: 1px solid var(--border);
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .byline a {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--heading);
  }

  /* Colonne de lecture étroite, décalée vers la droite comme dans la revue. */
  .column {
    max-width: 40rem;
    margin-top: 4rem;
  }

  .column .prose {
    margin-top: 2rem;
  }

  .column ul {
    padding-left: 1.1rem;
    list-style: disc;
  }

  .figure.wide {
    margin-top: 4rem;
  }

  @media (min-width: 1024px) {
    .column {
      margin-left: 25%;
    }

    .figure.wide {
      margin-left: 12.5%;
    }
  }
</style>
