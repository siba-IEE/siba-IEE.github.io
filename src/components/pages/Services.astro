---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangFromUrl, localizePath } from '../../lib/i18n';
import { getServices, serviceCategoryLabels, type ServiceCategory } from '../../lib/content';

const lang = getLangFromUrl(Astro.url);
const isFr = lang === 'fr';
const services = getServices();

const order: ServiceCategory[] = ['research', 'dev', 'platforms'];
const groups = order
  .map((category) => ({
    label: serviceCategoryLabels[category][lang],
    items: services.filter((service) => service.category === category),
  }))
  .filter((group) => group.items.length > 0);

const title = 'Services';
const lede = isFr
  ? 'Recherche, développement logiciel et plateformes de données. Les prix sont des prix de départ, hors frais tiers ; chaque projet fait l’objet d’un devis.'
  : 'Research, software development and data platforms. Prices are starting prices, excluding third-party costs; each project gets its own quote.';
const from = isFr ? 'à partir de' : 'from';
---

<BaseLayout title={title} description={lede}>
  <section class="block first last">
    <div class="shell">
      <h1 class="page-title">{title}</h1>
      <p class="lead">{lede}</p>

      {
        groups.map((group) => (
          <>
            <h2 class="label">{group.label}</h2>
            <ul class="rows services">
              {group.items.map((service) => (
                <li data-reveal>
                  <span class="what">{isFr ? service.nameFr : service.nameEn}</span>
                  <span class="where">{isFr ? service.descFr : service.descEn}</span>
                  <span class="price">
                    {from} {service.priceFrom}
                  </span>
                </li>
              ))}
            </ul>
          </>
        ))
      }

      <a href={localizePath('/contact', lang)} class="more"
        >{isFr ? 'Discuter d’un projet' : 'Discuss a project'}</a
      >
    </div>
  </section>
</BaseLayout>
