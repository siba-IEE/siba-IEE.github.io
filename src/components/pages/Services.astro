---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../chrome/PageHeader.astro';
import { getLangFromUrl, useTranslations, localizePath } from '../../lib/i18n';
import { getServices, serviceCategoryLabels, type ServiceCategory } from '../../lib/content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isFr = lang === 'fr';
const services = getServices();

const order: ServiceCategory[] = ['research', 'dev', 'platforms'];
const groups = order
  .map((cat) => ({
    cat,
    label: serviceCategoryLabels[cat][lang],
    items: services.filter((s) => s.category === cat),
  }))
  .filter((g) => g.items.length > 0);

const pageTitle = 'Services';
const pageLede = isFr
  ? 'Ce que je peux réaliser pour vous ou votre organisation, du logiciel métier à la plateforme de données. Tarifs de départ ; chaque projet fait l’objet d’un devis sur mesure.'
  : 'What I can build for you or your organisation, from business software to data platforms. Starting prices; every project gets a tailored quote.';
---

<BaseLayout title={pageTitle} description={pageLede}>
  <PageHeader title={pageTitle} lede={pageLede} />

  <section class="shell py-14 sm:py-20">
    <div class="space-y-16 sm:space-y-20">
      {
        groups.map((g, gi) => (
          <div>
            <div class="flex items-center gap-4 border-b border-border pb-3">
              <span class="font-mono text-sm font-medium text-brand-500">
                {String(gi + 1).padStart(2, '0')}
              </span>
              <h2 class="text-xs font-semibold tracking-[0.16em] text-brand-600 uppercase">{g.label}</h2>
            </div>

            <ul class="mt-2">
              {g.items.map((s) => (
                <li class="grid gap-x-8 gap-y-3 border-b border-border py-6 sm:grid-cols-[1fr_auto] sm:items-baseline">
                  <div class="max-w-2xl">
                    <h3 class="font-display text-lg font-bold tracking-tight text-heading sm:text-xl">
                      {isFr ? s.nameFr : s.nameEn}
                    </h3>
                    <p class="mt-1.5 text-sm leading-relaxed text-text-muted text-pretty">
                      {isFr ? s.descFr : s.descEn}
                    </p>
                  </div>
                  <div class="sm:pl-8 sm:text-right">
                    <span class="block text-[0.65rem] font-medium tracking-[0.12em] text-text-subtle uppercase">
                      {isFr ? 'À partir de' : 'From'}
                    </span>
                    <span class="font-display text-xl font-bold tracking-tight whitespace-nowrap text-heading">
                      {s.priceFrom}
                    </span>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    {/* Note + appel à discuter */}
    <div class="mt-14 border-t border-border pt-8">
      <p class="max-w-2xl text-sm leading-relaxed text-text-muted text-pretty">
        {
          isFr
            ? 'Tarifs de départ indicatifs, hors frais tiers (hébergement, licences, données). Le périmètre exact et le devis détaillé sont établis après un cadrage ensemble.'
            : 'Indicative starting prices, excluding third-party costs (hosting, licences, data). The exact scope and detailed quote are set after we scope the work together.'
        }
      </p>
      <a
        href={localizePath('/contact', lang)}
        class="mt-6 inline-flex items-center gap-2 rounded-full bg-brand-700 px-6 py-3 text-sm font-semibold text-white transition-transform hover:-translate-y-0.5"
      >
        {isFr ? 'Discuter d’un projet' : 'Discuss a project'}
      </a>
    </div>
  </section>
</BaseLayout>
