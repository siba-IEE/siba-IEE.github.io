---
/**
 * Page Services : une pile de volumes reliés, un par service (composant Shelf, d'après le
 * site de Stripe Press). Aucun prix : chaque projet fait l'objet d'un devis.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Shelf from '../shelf/Shelf.astro';
import { getLangFromUrl, localizePath } from '../../lib/i18n';
import { getServices, serviceCategoryLabels } from '../../lib/content';

const lang = getLangFromUrl(Astro.url);
const isFr = lang === 'fr';

/** Toiles de reliure, dans l'ordre de la pile. */
const cloths = ['#1f3a5f', '#7a2a2a', '#2f4a3a', '#c9a23f', '#3d3f47', '#b5532a', '#d8cdb8'];

const description = isFr
  ? 'Recherche, logiciels et plateformes de données pour l’énergie. Chaque projet fait l’objet d’un devis.'
  : 'Research, software and data platforms for energy. Each project gets its own quote.';

const entries = getServices().map((service, index) => ({
  title: isFr ? service.nameFr : service.nameEn,
  mention: serviceCategoryLabels[service.category][lang],
  text: isFr ? service.descFr : service.descEn,
  color: cloths[index % cloths.length],
  href: localizePath('/contact', lang),
  cta: isFr ? 'Demander un devis' : 'Request a quote',
}));
---

<BaseLayout title="Services" description={description} footer={false}>
  <Shelf title="Services" entries={entries} />
</BaseLayout>
