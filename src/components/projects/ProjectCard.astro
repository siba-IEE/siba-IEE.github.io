---
import type { Project } from '../../lib/content';
import { kindLabels, statusLabels } from '../../lib/content';
import { localizePath, type Lang } from '../../lib/i18n';

interface Props {
  project: Project;
  lang: Lang;
}

const { project, lang } = Astro.props;
const summary = lang === 'fr' ? project.summaryFr : project.summaryEn;
---

<li
  data-kind={project.kind}
  class="group relative flex flex-col rounded-2xl border border-border bg-surface p-6 transition-colors hover:border-brand-400"
>
  <div class="flex items-center justify-between gap-3">
    <span class="text-xs font-medium tracking-wide text-text-subtle uppercase">
      {kindLabels[project.kind][lang]}
    </span>
    <span class="rounded-full bg-brand-100 px-2.5 py-0.5 text-xs font-medium text-brand-800">
      {statusLabels[project.status][lang]}
    </span>
  </div>
  <h3 class="mt-3 font-display text-lg font-semibold">
    <a href={localizePath(`/projets/${project.slug}`, lang)} class="after:absolute after:inset-0">{project.title}</a>
  </h3>
  <p class="mt-2 flex-1 text-sm text-text-muted text-pretty">{summary}</p>
  <ul class="mt-4 flex flex-wrap gap-1.5">
    {
      project.stack.map((tech) => (
        <li class="rounded-md bg-surface-3 px-2 py-0.5 font-mono text-xs text-text-muted">{tech}</li>
      ))
    }
  </ul>
</li>
