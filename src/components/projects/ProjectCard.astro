---
import type { Project } from '../../lib/content';
import { kindLabels, statusLabels } from '../../lib/content';
import { localizePath, type Lang } from '../../lib/i18n';

interface Props {
  project: Project;
  lang: Lang;
  index?: number;
}

const { project, lang, index = 0 } = Astro.props;
const summary = lang === 'fr' ? project.summaryFr : project.summaryEn;
---

<li
  data-kind={project.kind}
  data-reveal
  style={`--reveal-delay:${Math.min(index, 6) * 0.07}s`}
  class="group relative flex flex-col overflow-hidden rounded-xl border border-border bg-surface transition-colors hover:border-brand-400"
>
  <div class="relative aspect-[16/9] overflow-hidden border-b border-border bg-surface-2">
    {
      project.image ? (
        <img
          src={project.image}
          alt={project.title}
          class="size-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
          loading="lazy"
        />
      ) : (
        <div class="absolute inset-0 bg-brand-900">
          <div
            class="absolute inset-0 opacity-[0.15] [background-image:linear-gradient(rgba(255,255,255,0.6)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.6)_1px,transparent_1px)] [background-size:20px_20px]"
            aria-hidden="true"
          />
        </div>
      )
    }
    <span
      class="absolute top-2.5 left-2.5 rounded bg-white/90 px-2 py-0.5 text-[0.65rem] font-medium tracking-wide text-brand-800 uppercase backdrop-blur"
    >
      {kindLabels[project.kind][lang]}
    </span>
    <span
      class="absolute top-2.5 right-2.5 rounded bg-brand-700/90 px-2 py-0.5 text-[0.65rem] font-medium text-white backdrop-blur"
    >
      {statusLabels[project.status][lang]}
    </span>
  </div>

  <div class="flex flex-1 flex-col p-4">
    <h3 class="font-display text-base font-semibold leading-snug">
      <a href={localizePath(`/projets/${project.slug}`, lang)} class="after:absolute after:inset-0">
        {project.title}
      </a>
    </h3>
    <p class="mt-1.5 line-clamp-2 flex-1 text-sm text-text-muted text-pretty">{summary}</p>
    <ul class="mt-3 flex flex-wrap gap-1">
      {
        project.stack.slice(0, 4).map((tech) => (
          <li class="rounded bg-surface-3 px-1.5 py-0.5 font-mono text-[0.65rem] text-text-muted">{tech}</li>
        ))
      }
    </ul>
  </div>
</li>
