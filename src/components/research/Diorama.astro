---
/**
 * Maquette 3D de la page Travaux : un personnage marche d'étape en étape et montre chaque
 * scène (src/scripts/diorama.ts). Les textes des étapes sont ici. Sans WebGL ou sans
 * JavaScript, les étapes se lisent à la suite, sans la maquette.
 */
import { getLangFromUrl } from '../../lib/i18n';

const lang = getLangFromUrl(Astro.url);
const isFr = lang === 'fr';

interface Step {
  work: string;
  title: string;
  text: string;
}

const works = isFr
  ? { cams: 'Calage de CAMS sans station locale', pixel: 'Dégénérescence de pixel, en cours' }
  : {
      cams: 'Site adaptation of CAMS without a local station',
      pixel: 'Pixel degeneracy, in progress',
    };

const steps: Step[] = isFr
  ? [
      {
        work: works.cams,
        title: 'On mesure au sol',
        text: '31 stations ont mesuré le rayonnement solaire dans 13 pays d’Afrique de l’Ouest, deux années chacune.',
      },
      {
        work: works.cams,
        title: 'Le satellite surestime',
        text: 'Le produit CAMS surestime le rayonnement annuel de 6,6 % en moyenne, et de plus en plus vers le sud.',
      },
      {
        work: works.cams,
        title: 'Avec une station, on corrige',
        text: 'Un an de mesure sur place ramène l’erreur de 6,6 % à 1,1 % l’année suivante.',
      },
      {
        work: works.cams,
        title: 'Sans station, on emprunte',
        text: 'La correction vient des autres stations. Suivre la tendance nord-sud laisse 1,8 % d’erreur ; copier la station la plus proche, 2,9 %.',
      },
      {
        work: works.cams,
        title: 'On dimensionne',
        text: 'La méthode a corrigé les séries de 340 localités de Guinée, utilisées pour dimensionner des installations solaires.',
      },
      {
        work: works.pixel,
        title: 'Deux villes, une seule maille',
        text: 'Kindia et Mamou sont à 92 km l’une de l’autre. NASA POWER leur attribue exactement la même série, car elles tombent dans la même maille.',
      },
      {
        work: works.pixel,
        title: 'Une grille plus fine',
        text: 'Les produits à maille fine devraient séparer ces sites. Le vérifier sur les 34 communes de Guinée est l’étape en cours.',
      },
    ]
  : [
      {
        work: works.cams,
        title: 'Measure on the ground',
        text: '31 stations measured solar radiation in 13 West African countries, two years each.',
      },
      {
        work: works.cams,
        title: 'The satellite overestimates',
        text: 'The CAMS product overestimates annual irradiation by 6.6% on average, and more and more towards the south.',
      },
      {
        work: works.cams,
        title: 'With a station, correct',
        text: 'One year of on-site measurement brings the error from 6.6% down to 1.1% the following year.',
      },
      {
        work: works.cams,
        title: 'Without a station, borrow',
        text: 'The correction comes from the other stations. Following the north–south trend leaves 1.8% of error; copying the nearest station, 2.9%.',
      },
      {
        work: works.cams,
        title: 'Size the plant',
        text: 'The method corrected the series of 340 localities in Guinea, used to size solar installations.',
      },
      {
        work: works.pixel,
        title: 'Two towns, one grid cell',
        text: 'Kindia and Mamou are 92 km apart. NASA POWER gives them exactly the same series, because they fall in the same grid cell.',
      },
      {
        work: works.pixel,
        title: 'A finer grid',
        text: 'Fine-grid products should separate these sites. Checking it on the 34 communes of Guinea is the step in progress.',
      },
    ];

const labels = isFr
  ? {
      raw: '6,6 %',
      onsite: '1,1 %',
      nearest: '2,9 %',
      trend: '1,8 %',
      localities: '340 localités',
      sameValue: 'même valeur',
    }
  : {
      raw: '6.6%',
      onsite: '1.1%',
      nearest: '2.9%',
      trend: '1.8%',
      localities: '340 localities',
      sameValue: 'same value',
    };

const ui = isFr
  ? {
      previous: 'Étape précédente',
      next: 'Étape suivante',
      drag: 'Glisser pour tourner la maquette',
      title: 'Travaux',
    }
  : {
      previous: 'Previous step',
      next: 'Next step',
      drag: 'Drag to turn the model',
      title: 'Research',
    };
---

<section class="diorama" data-diorama data-labels={JSON.stringify(labels)} data-step="0">
  <canvas aria-hidden="true"></canvas>

  <div class="panel">
    <h1>{ui.title}</h1>
    <ol>
      {
        steps.map((step, index) => (
          <li data-step-text={index} data-on={index === 0 ? '' : undefined}>
            <p class="work">{step.work}</p>
            <h2>{step.title}</h2>
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>
    <nav>
      <button type="button" data-move="-1" aria-label={ui.previous}>
        <svg viewBox="0 0 16 16" aria-hidden="true"
          ><path d="M13 8H3m4.5-4.5L3 8l4.5 4.5"></path></svg
        >
      </button>
      <button type="button" data-move="1" aria-label={ui.next}>
        <svg viewBox="0 0 16 16" aria-hidden="true"
          ><path d="M3 8h10M8.5 3.5 13 8l-4.5 4.5"></path></svg
        >
      </button>
      <span class="ticks">
        {
          steps.map((step, index) => (
            <button type="button" data-tick={index} aria-label={step.title} />
          ))
        }
      </span>
    </nav>
  </div>
  <p class="hint">{ui.drag}</p>
</section>

<style>
  .diorama {
    --nav: 4rem;

    position: relative;
    height: calc(100svh - var(--nav));
    min-height: 36rem;
    overflow: hidden;

    /* La maquette est blanche et ses étiquettes sont noires : la scène reste claire dans les deux thèmes. */
    --heading: #0a0a0a;
    --text-muted: #5a5a5a;
    --text-subtle: #858585;
    --surface: #ededed;

    background: var(--surface);
  }

  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    cursor: grab;
    touch-action: pan-y;
  }

  canvas:active {
    cursor: grabbing;
  }

  .panel {
    position: absolute;
    inset: auto 1.25rem 1.25rem;
    max-width: 26rem;
    pointer-events: none;
  }

  h1 {
    position: absolute;
    bottom: 100%;
    margin: 0 0 1rem;
    font-size: 0.95rem;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--text-subtle);
  }

  ol {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Les textes occupent la même case : seul celui de l'étape atteinte est visible. */
  li {
    grid-area: 1 / 1;
    align-self: end;
    opacity: 0;
    transform: translateY(0.8rem);
    transition:
      opacity 0.4s ease,
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  li[data-on] {
    opacity: 1;
    transform: none;
  }

  /* Pendant la marche, le texte s'efface : il revient à l'arrivée. */
  .diorama[data-walking] li[data-on] {
    opacity: 0.25;
  }

  .work {
    margin: 0 0 0.5rem;
    font-size: 0.82rem;
    color: var(--text-subtle);
  }

  h2 {
    margin: 0;
    font-size: clamp(1.7rem, 3.4vw, 2.8rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.045em;
    color: var(--heading);
    text-wrap: balance;
  }

  li p:last-child {
    margin: 0.8rem 0 0;
    font-size: 1rem;
    line-height: 1.45;
    color: var(--text-muted);
    text-wrap: pretty;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
    pointer-events: auto;
  }

  nav > button {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--heading);
    color: var(--surface);
    cursor: pointer;
    transition:
      background 0.2s ease,
      color 0.2s ease,
      opacity 0.2s ease;
  }

  nav > button:hover {
    background: var(--color-brand-500);
    color: #fff;
  }

  nav > button:disabled {
    opacity: 0.25;
    pointer-events: none;
  }

  nav svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentcolor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ticks {
    display: flex;
    margin-left: 0.75rem;
  }

  .ticks button {
    position: relative;
    width: 1.1rem;
    height: 2rem;
    cursor: pointer;
  }

  .ticks button::before {
    content: '';
    position: absolute;
    bottom: 0.5rem;
    left: 50%;
    width: 1.5px;
    height: 0.5rem;
    background: var(--text-subtle);
    transition:
      height 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      background 0.2s ease;
  }

  .ticks button[aria-current]::before {
    height: 1.1rem;
    background: var(--heading);
  }

  .hint {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    margin: 0;
    font-size: 0.78rem;
    color: var(--text-subtle);
    pointer-events: none;
  }

  @media (min-width: 1024px) {
    .panel {
      inset: auto auto 3.5rem 4rem;
    }

    .hint {
      top: 2rem;
      right: 4rem;
    }
  }

  /* Sans JavaScript : pas de maquette, les étapes à la suite. */
  :global(html:not(.js)) .diorama {
    height: auto;
    padding: 3rem 1.25rem;
  }

  :global(html:not(.js)) canvas,
  :global(html:not(.js)) nav,
  :global(html:not(.js)) .hint {
    display: none;
  }

  :global(html:not(.js)) .panel,
  :global(html:not(.js)) h1 {
    position: static;
  }

  :global(html:not(.js)) li {
    grid-area: auto;
    margin-top: 2rem;
    opacity: 1;
    transform: none;
  }
</style>

<script>
  import type { Diorama, DioramaLabels } from '../../scripts/diorama';

  let diorama: Diorama | null = null;
  let onKey: ((event: KeyboardEvent) => void) | null = null;

  const stop = () => {
    diorama?.destroy();
    diorama = null;
    if (onKey) window.removeEventListener('keydown', onKey);
    onKey = null;
  };

  const init = async () => {
    stop();
    const root = document.querySelector<HTMLElement>('[data-diorama]');
    const canvas = root?.querySelector('canvas');
    if (!root || !canvas) return;

    const texts = [...root.querySelectorAll<HTMLElement>('[data-step-text]')];
    const ticks = [...root.querySelectorAll<HTMLButtonElement>('[data-tick]')];
    const moves = [...root.querySelectorAll<HTMLButtonElement>('[data-move]')];
    const last = texts.length - 1;
    let current = 0;

    const show = (step: number) => {
      root.removeAttribute('data-walking');
      texts.forEach((text, index) => text.toggleAttribute('data-on', index === step));
    };
    const goTo = (step: number) => {
      const next = Math.max(0, Math.min(last, step));
      if (next === current) return;
      current = next;
      root.dataset.step = String(current);
      root.setAttribute('data-walking', '');
      ticks.forEach((tick, index) => tick.toggleAttribute('aria-current', index === current));
      moves[0].disabled = current === 0;
      moves[1].disabled = current === last;
      // Sans maquette, le texte change tout de suite.
      if (diorama) diorama.goTo(current);
      else show(current);
    };

    ticks[0]?.setAttribute('aria-current', 'true');
    moves[0].disabled = true;
    moves.forEach((button) =>
      button.addEventListener('click', () => goTo(current + Number(button.dataset.move))),
    );
    ticks.forEach((tick) => tick.addEventListener('click', () => goTo(Number(tick.dataset.tick))));
    onKey = (event) => {
      if (event.key === 'ArrowRight') goTo(current + 1);
      if (event.key === 'ArrowLeft') goTo(current - 1);
    };
    window.addEventListener('keydown', onKey);

    // three.js n'est chargé que sur cette page, et seulement une fois la page affichée.
    const { mountDiorama } = await import('../../scripts/diorama');
    const labels = JSON.parse(root.dataset.labels ?? '{}') as DioramaLabels;
    diorama = mountDiorama(canvas, labels, show);
  };

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', stop);
</script>
