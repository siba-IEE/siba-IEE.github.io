---
/**
 * Film 3D de la page Travaux et son lecteur : lecture et pause, barre de progression par
 * chapitre, sous-titres, cartons de titre, graphiques d'explication, plein écran, clavier.
 * L'image vient de src/scripts/film.ts ; les textes sont ici.
 * Sans WebGL ou sans JavaScript, les chapitres se lisent à la suite.
 */
import { getLangFromUrl } from '../../lib/i18n';

const lang = getLangFromUrl(Astro.url);
const isFr = lang === 'fr';

/** Un plan du film : son titre et ses trois sous-titres, de six secondes chacun. */
type Chapter = [title: string, first: string, second: string, third: string];

const chapters: Chapter[] = isFr
  ? [
      [
        'Mesurer au sol',
        'En Afrique de l’Ouest, 31 stations ont mesuré le rayonnement solaire au sol.',
        'Un pyranomètre mesure le rayonnement global ; un second, ombré, le rayonnement diffus.',
        'Une valeur chaque minute, pendant deux ans.',
      ],
      [
        'Le réseau',
        'Le réseau couvre 13 pays, de la Gambie au Nigeria.',
        'C’est la campagne ESMAP/WAPP, menée de 2021 à 2024.',
        'Ses mesures sont publiques.',
      ],
      [
        'Le satellite',
        'Partout ailleurs, on dépend des estimations par satellite.',
        'Le service CAMS calcule le rayonnement au sol à partir des images et de l’état de l’atmosphère.',
        'Il surestime le rayonnement annuel de 6,6 % en moyenne, davantage vers le sud.',
      ],
      [
        'Corriger sur place',
        'Avec un an de mesure sur le site, on compare le satellite au sol.',
        'On en tire une correction, appliquée ensuite à toute la série du satellite.',
        'L’erreur passe de 6,6 % à 1,1 % l’année suivante.',
      ],
      [
        'Corriger sans station',
        'Conakry n’a pas de station de mesure.',
        'La correction vient alors des autres stations du réseau.',
        'Suivre la tendance nord-sud laisse 1,8 % d’erreur. Copier la station la plus proche, 2,9 %.',
      ],
      [
        'Dimensionner',
        'La méthode a corrigé les séries de 340 localités de Guinée.',
        'Une ressource surestimée, c’est une centrale qui produit moins que prévu.',
        'Les séries corrigées servent à dimensionner les installations solaires.',
      ],
      [
        'En cours : la maille',
        'Kindia et Mamou sont à 92 km l’une de l’autre.',
        'NASA POWER leur donne exactement la même série : elles partagent une maille d’un degré.',
        'Reste à vérifier que les produits à maille fine les séparent.',
      ],
    ]
  : [
      [
        'Measuring on the ground',
        'In West Africa, 31 stations measured solar radiation on the ground.',
        'One pyranometer measures global irradiance; a second, shaded one measures diffuse irradiance.',
        'One value every minute, for two years.',
      ],
      [
        'The network',
        'The network spans 13 countries, from The Gambia to Nigeria.',
        'This is the ESMAP/WAPP campaign, run from 2021 to 2024.',
        'Its measurements are public.',
      ],
      [
        'The satellite',
        'Everywhere else, we depend on satellite estimates.',
        'The CAMS service computes surface irradiance from imagery and the state of the atmosphere.',
        'It overestimates annual irradiation by 6.6% on average, more so towards the south.',
      ],
      [
        'Correcting on site',
        'With one year of measurement on site, the satellite is compared with the ground.',
        'This gives a correction, then applied to the whole satellite series.',
        'The error goes from 6.6% to 1.1% the following year.',
      ],
      [
        'Correcting without a station',
        'Conakry has no measurement station.',
        'The correction then comes from the other stations of the network.',
        'Following the north–south trend leaves 1.8% of error. Copying the nearest station, 2.9%.',
      ],
      [
        'Sizing',
        'The method corrected the series of 340 localities in Guinea.',
        'An overestimated resource means a plant that produces less than planned.',
        'The corrected series are used to size solar installations.',
      ],
      [
        'In progress: the grid cell',
        'Kindia and Mamou are 92 km apart.',
        'NASA POWER gives them exactly the same series: they share a one-degree grid cell.',
        'What remains is to check that fine-grid products separate them.',
      ],
    ];

/**
 * Graphiques posés sur l'image pendant le dernier sous-titre d'un plan : l'erreur annuelle
 * du rayonnement global, en pourcentage (tableau 3 de la prépublication).
 */
const charts: { chapter: number; title: string; rows: [label: string, value: number][] }[] = isFr
  ? [
      {
        chapter: 3,
        title: 'Erreur annuelle',
        rows: [
          ['Satellite brut', 6.63],
          ['Corrigé sur place', 1.11],
        ],
      },
      {
        chapter: 4,
        title: 'Erreur annuelle',
        rows: [
          ['Station la plus proche', 2.85],
          ['Tendance nord-sud', 1.83],
          ['Mesure sur place', 1.11],
        ],
      },
    ]
  : [
      {
        chapter: 3,
        title: 'Annual error',
        rows: [
          ['Raw satellite', 6.63],
          ['Corrected on site', 1.11],
        ],
      },
      {
        chapter: 4,
        title: 'Annual error',
        rows: [
          ['Nearest station', 2.85],
          ['North–south trend', 1.83],
          ['On-site measurement', 1.11],
        ],
      },
    ];
const percent = (value: number) =>
  `${new Intl.NumberFormat(isFr ? 'fr-FR' : 'en-US', { minimumFractionDigits: 1, maximumFractionDigits: 1 }).format(value)}${isFr ? ' %' : '%'}`;

const ui = isFr
  ? {
      title: 'Travaux',
      play: 'Lire',
      pause: 'Pause',
      full: 'Plein écran',
      credit:
        'Satellite : modèle NASA. Images : NASA Blue Marble et MODIS. Paysage : Poly Haven. Frontières : Natural Earth.',
    }
  : {
      title: 'Research',
      play: 'Play',
      pause: 'Pause',
      full: 'Full screen',
      credit:
        'Satellite: NASA model. Imagery: NASA Blue Marble and MODIS. Landscape: Poly Haven. Borders: Natural Earth.',
    };

const assets = {
  panorama: '/images/film/paysage.webp',
  earth: '/images/terre/jour.webp',
  satellite: '/models/satellite.glb',
  draco: '/draco/',
  region: '/images/terre/afrique-ouest.webp',
  cell: '/images/film/guinee-modis.webp',
};

const labels = {
  kindia: 'Kindia',
  mamou: 'Mamou',
  conakry: 'Conakry',
  countries: isFr
    ? [
        'Gambie',
        'Guinée-Bissau',
        'Guinée',
        'Sierra Leone',
        'Libéria',
        'Mali',
        'Côte d’Ivoire',
        'Burkina Faso',
        'Ghana',
        'Togo',
        'Bénin',
        'Niger',
        'Nigeria',
      ]
    : [
        'The Gambia',
        'Guinea-Bissau',
        'Guinea',
        'Sierra Leone',
        'Liberia',
        'Mali',
        'Côte d’Ivoire',
        'Burkina Faso',
        'Ghana',
        'Togo',
        'Benin',
        'Niger',
        'Nigeria',
      ],
  station: isFr
    ? ['Rayonnement global', 'Rayonnement diffus', 'Acquisition']
    : ['Global irradiance', 'Diffuse irradiance', 'Data logger'],
  distance: '92 km',
};
---

<section
  class="film"
  data-film
  data-assets={JSON.stringify(assets)}
  data-labels={JSON.stringify(labels)}
  data-state="loading"
>
  <canvas aria-hidden="true"></canvas>
  <div class="fade" data-fade aria-hidden="true"></div>

  <header>
    <h1>{ui.title}</h1>
    <p data-chapter-title>{chapters[0][0]}</p>
  </header>

  {/* Carton de titre, affiché à l'ouverture de chaque plan */}
  <p class="card" data-card aria-hidden="true">{chapters[0][0]}</p>

  {
    charts.map((chart) => (
      <figure class="chart" data-chart={chart.chapter} aria-hidden="true">
        <figcaption>{chart.title}</figcaption>
        {chart.rows.map(([label, value]) => (
          <div>
            <span>{label}</span>
            <i style={`--w:${(value / Math.max(...chart.rows.map((row) => row[1]))).toFixed(3)}`} />
            <b>{percent(value)}</b>
          </div>
        ))}
      </figure>
    ))
  }

  <ol class="captions">
    {
      chapters.map(([title, ...lines], index) => (
        <li data-chapter={index}>
          <h2>{title}</h2>
          {lines.map((line, n) => (
            <p data-cue={`${index}-${n}`}>{line}</p>
          ))}
        </li>
      ))
    }
  </ol>

  <button type="button" class="big" data-toggle aria-label={ui.play}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"></path></svg>
  </button>

  <div class="bar">
    <button
      type="button"
      data-toggle
      aria-label={ui.play}
      data-label-play={ui.play}
      data-label-pause={ui.pause}
    >
      <svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true"
        ><path d="M8 5.5v13l11-6.5z"></path></svg
      >
      <svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true"
        ><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z"></path></svg
      >
    </button>
    <div class="track" data-track>
      {
        chapters.map(([title], index) => (
          <span class="segment" title={title}>
            <i data-fill={index} />
          </span>
        ))
      }
    </div>
    <span class="time" data-time>0:00</span>
    <button type="button" data-fullscreen aria-label={ui.full} title={ui.full}>
      <svg class="stroke" viewBox="0 0 24 24" aria-hidden="true"
        ><path d="M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5"></path></svg
      >
    </button>
  </div>
  <p class="credit">{ui.credit}</p>
</section>

<style>
  /* Un écran de cinéma : noir, dans les deux thèmes. */
  .film {
    --nav: 4rem;

    position: relative;
    height: calc(100svh - var(--nav));
    min-height: 34rem;
    overflow: hidden;
    background: #050505;
    color: #fff;
  }

  canvas,
  .fade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .fade {
    pointer-events: none;
  }

  /* Bandeau sombre en bas, pour que sous-titres et commandes restent lisibles sur toute image. */
  .film::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 45%;
    background: linear-gradient(to top, rgb(0 0 0 / 70%), transparent);
    pointer-events: none;
  }

  header,
  .captions,
  .bar,
  .credit,
  .big {
    z-index: 1;
  }

  header {
    position: absolute;
    top: 1.25rem;
    left: 1.25rem;
    display: flex;
    gap: 1.5rem;
    font-size: 0.85rem;
    text-shadow: 0 0 12px rgb(0 0 0 / 60%);
  }

  h1,
  header p {
    margin: 0;
    font-size: inherit;
    font-weight: 400;
    letter-spacing: 0;
    color: #fff;
  }

  h1 {
    color: rgb(255 255 255 / 60%);
    animation: none !important;
  }

  /* Sous-titres */
  .captions {
    position: absolute;
    inset: auto 1.25rem 5.25rem;
    display: grid;
    justify-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
    text-align: center;
    pointer-events: none;
  }

  .captions li,
  .captions p {
    grid-area: 1 / 1;
  }

  .captions li {
    display: grid;
    justify-items: center;
  }

  .captions h2 {
    display: none;
  }

  .captions p {
    max-width: 44rem;
    margin: 0;
    font-size: clamp(1.15rem, 2.3vw, 1.9rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.03em;
    text-shadow: 0 1px 18px rgb(0 0 0 / 75%);
    text-wrap: balance;
    opacity: 0;
    transform: translateY(0.6rem);
    transition:
      opacity 0.5s ease,
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .captions p[data-on] {
    opacity: 1;
    transform: none;
  }

  /* Bouton central : visible tant que le film est à l'arrêt. */
  .big {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 5rem;
    height: 5rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 92%);
    color: #050505;
    cursor: pointer;
    translate: -50% -50%;
    transition:
      opacity 0.3s ease,
      scale 0.3s ease;
  }

  .big:hover {
    scale: 1.06;
  }

  .big svg {
    width: 1.8rem;
    height: 1.8rem;
    fill: currentcolor;
    translate: 2px 0;
  }

  .film[data-state='playing'] .big,
  .film[data-state='loading'] .big {
    opacity: 0;
    pointer-events: none;
  }

  /* Chargement : un trait qui pulse au centre. */
  .film[data-state='loading']::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 1;
    width: 6rem;
    height: 1.5px;
    background: #fff;
    translate: -50% 0;
    animation: load 1.2s ease-in-out infinite;
  }

  @keyframes load {
    0%,
    100% {
      scale: 0.2 1;
      opacity: 0.4;
    }

    50% {
      scale: 1 1;
      opacity: 1;
    }
  }

  /* Barre de lecture */
  .bar {
    position: absolute;
    inset: auto 1.25rem 2.25rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .bar button {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    color: #fff;
    cursor: pointer;
  }

  .bar svg {
    width: 1.4rem;
    height: 1.4rem;
    fill: currentcolor;
  }

  .icon-pause,
  .film[data-state='playing'] .icon-play {
    display: none;
  }

  .film[data-state='playing'] .icon-pause {
    display: block;
  }

  .track {
    display: flex;
    flex: 1;
    gap: 4px;
    padding-block: 0.75rem;
    cursor: pointer;
    touch-action: none;
  }

  .segment {
    flex: 1;
    height: 3px;
    overflow: hidden;
    background: rgb(255 255 255 / 28%);
    transition: height 0.2s ease;
  }

  .track:hover .segment {
    height: 5px;
  }

  .segment i {
    display: block;
    height: 100%;
    background: #fff;
    transform: scaleX(0);
    transform-origin: left;
  }

  .time {
    min-width: 2.6rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  .credit {
    position: absolute;
    inset: auto 1.25rem 0.9rem;
    margin: 0;
    font-size: 0.7rem;
    color: rgb(255 255 255 / 50%);
  }

  @media (min-width: 1024px) {
    header {
      top: 2rem;
      left: 4rem;
    }

    .captions {
      inset: auto 4rem 6rem;
    }

    .bar {
      inset: auto 4rem 2.5rem;
    }

    .credit {
      inset: auto 4rem 1rem;
    }
  }

  /* Sans JavaScript : pas de film, les chapitres à la suite. */
  :global(html:not(.js)) .film {
    height: auto;
    padding: 4rem 1.25rem;
  }

  :global(html:not(.js)) canvas,
  :global(html:not(.js)) .fade,
  :global(html:not(.js)) .big,
  :global(html:not(.js)) .bar,
  :global(html:not(.js)) .film::before {
    display: none;
  }

  :global(html:not(.js)) header,
  :global(html:not(.js)) .captions {
    position: static;
    display: block;
    text-align: left;
  }

  :global(html:not(.js)) .captions li {
    display: block;
    margin-top: 2rem;
  }

  :global(html:not(.js)) .captions h2 {
    display: block;
    font-size: 1rem;
    color: #fff;
  }

  :global(html:not(.js)) .captions p {
    margin-top: 0.5rem;
    opacity: 1;
    transform: none;
  }

  /* Vignette : les bords s'assombrissent, comme dans un objectif. */
  .fade {
    box-shadow: inset 0 0 14rem rgb(0 0 0 / 55%);
  }

  /* Carton de titre */
  .card {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    place-content: center;
    margin: 0;
    padding-inline: 1.25rem;
    font-size: clamp(2.2rem, 7vw, 6.5rem);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.055em;
    text-align: center;
    text-wrap: balance;
    opacity: 0;
    scale: 1.04;
    transition:
      opacity 0.7s ease,
      scale 1.6s cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
  }

  .card[data-on] {
    opacity: 1;
    scale: 1;
  }

  /* Graphiques d'explication */
  .chart {
    position: absolute;
    top: 5.5rem;
    right: 1.25rem;
    z-index: 1;
    display: grid;
    gap: 0.7rem;
    width: min(21rem, calc(100% - 2.5rem));
    margin: 0;
    padding: 1.1rem 1.2rem 1.25rem;
    background: rgb(8 8 8 / 72%);
    backdrop-filter: blur(14px);
    font-size: 0.85rem;
    opacity: 0;
    translate: 0 0.8rem;
    transition:
      opacity 0.5s ease,
      translate 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
  }

  .chart[data-on] {
    opacity: 1;
    translate: 0;
  }

  .chart figcaption {
    color: rgb(255 255 255 / 60%);
  }

  .chart div {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.3rem 1rem;
  }

  .chart i {
    grid-column: 1 / -1;
    grid-row: 2;
    height: 0.45rem;
    background: #fff;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 1.1s cubic-bezier(0.22, 1, 0.36, 1) 0.3s;
  }

  .chart div:first-of-type i {
    background: #f50;
  }

  .chart[data-on] i {
    transform: scaleX(var(--w));
  }

  .chart b {
    font-family: var(--font-mono);
    font-weight: 400;
    font-variant-numeric: tabular-nums;
  }

  .bar .stroke {
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: currentcolor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* En plein écran, le film occupe tout l'écran. */
  .film:fullscreen {
    height: 100vh;
  }

  @media (min-width: 1024px) {
    .chart {
      top: 6rem;
      right: 4rem;
    }
  }

  :global(html:not(.js)) .card,
  :global(html:not(.js)) .chart {
    display: none;
  }
</style>

<script>
  import type { Film, FilmAssets, FilmLabels } from '../../scripts/film';

  let film: Film | null = null;
  let observer: IntersectionObserver | null = null;
  let onKey: ((event: KeyboardEvent) => void) | null = null;

  const stop = () => {
    film?.destroy();
    film = null;
    observer?.disconnect();
    observer = null;
    if (onKey) window.removeEventListener('keydown', onKey);
    onKey = null;
  };

  const init = async () => {
    stop();
    const root = document.querySelector<HTMLElement>('[data-film]');
    const canvas = root?.querySelector('canvas');
    if (!root || !canvas) return;

    const fade = root.querySelector<HTMLElement>('[data-fade]')!;
    const title = root.querySelector<HTMLElement>('[data-chapter-title]')!;
    const card = root.querySelector<HTMLElement>('[data-card]')!;
    const time = root.querySelector<HTMLElement>('[data-time]')!;
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const fills = [...root.querySelectorAll<HTMLElement>('[data-fill]')];
    const cues = [...root.querySelectorAll<HTMLElement>('[data-cue]')];
    const charts = [...root.querySelectorAll<HTMLElement>('[data-chart]')];
    const titles = [...root.querySelectorAll<HTMLElement>('.captions h2')].map(
      (heading) => heading.textContent ?? '',
    );
    const toggles = [...root.querySelectorAll<HTMLButtonElement>('[data-toggle]')];

    // three.js n'est chargé que sur cette page, une fois celle-ci affichée.
    const { mountFilm, CHAPTER_SECONDS } = await import('../../scripts/film');
    // Un plan : le carton de titre, puis trois sous-titres qui se partagent le reste du temps.
    const CARD_SECONDS = 1.8;
    const cueSeconds = (CHAPTER_SECONDS - CARD_SECONDS - 0.4) / 3;

    const setState = (state: 'loading' | 'paused' | 'playing') => {
      root.dataset.state = state;
      const bar = toggles[1];
      const label = (state === 'playing' ? bar.dataset.labelPause : bar.dataset.labelPlay) ?? '';
      toggles.forEach((button) => button.setAttribute('aria-label', label));
    };

    const onFrame = (seconds: number, chapter: number, fadeAmount: number) => {
      const local = seconds - chapter * CHAPTER_SECONDS;
      fade.style.backgroundColor = `rgb(5 5 5 / ${fadeAmount.toFixed(3)})`;
      title.textContent = titles[chapter];
      card.textContent = titles[chapter];
      card.toggleAttribute('data-on', local < CARD_SECONDS);
      time.dataset.seconds = String(seconds);
      time.textContent = `${Math.floor(seconds / 60)}:${String(Math.floor(seconds % 60)).padStart(2, '0')}`;
      fills.forEach((fill, index) => {
        const progress = index < chapter ? 1 : index > chapter ? 0 : local / CHAPTER_SECONDS;
        fill.style.transform = `scaleX(${progress.toFixed(4)})`;
      });
      const since = local - CARD_SECONDS;
      const line = since < 0 ? -1 : Math.min(2, Math.floor(since / cueSeconds));
      // Chaque sous-titre s'efface un peu avant le suivant.
      const showing = since >= 0 && since - line * cueSeconds < cueSeconds - 0.5;
      cues.forEach((cue) =>
        cue.toggleAttribute('data-on', showing && cue.dataset.cue === `${chapter}-${line}`),
      );
      // Le graphique accompagne le dernier sous-titre du plan.
      charts.forEach((chart) =>
        chart.toggleAttribute('data-on', Number(chart.dataset.chart) === chapter && line === 2),
      );
      if (film && !film.playing && root.dataset.state === 'playing') setState('paused');
    };

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const assets = JSON.parse(root.dataset.assets ?? '{}') as FilmAssets;
    const labels = JSON.parse(root.dataset.labels ?? '{}') as FilmLabels;
    film = mountFilm(canvas, assets, labels, onFrame, () => {
      // Prêt : la lecture démarre seule, sauf si le visiteur a demandé moins d'animation.
      if (root.dataset.state !== 'loading') return;
      setState('paused');
      if (!reduced) play();
    });
    if (!film) return;

    const play = () => {
      film?.play();
      setState('playing');
    };
    const pause = () => {
      film?.pause();
      setState('paused');
    };
    const toggle = () => (film?.playing ? pause() : play());
    toggles.forEach((button) => button.addEventListener('click', toggle));
    canvas.addEventListener('click', toggle);

    // Cliquer ou glisser sur la barre déplace la lecture.
    const seek = (seconds: number) => film?.seek(Math.min(film.duration, Math.max(0, seconds)));
    const scrub = (event: PointerEvent) => {
      const rect = track.getBoundingClientRect();
      seek(((event.clientX - rect.left) / rect.width) * (film?.duration ?? 0));
    };
    track.addEventListener('pointerdown', (event) => {
      track.setPointerCapture(event.pointerId);
      scrub(event);
    });
    track.addEventListener('pointermove', (event) => {
      if (event.buttons > 0) scrub(event);
    });

    root.querySelector('[data-fullscreen]')?.addEventListener('click', () => {
      if (document.fullscreenElement) void document.exitFullscreen();
      else void root.requestFullscreen?.();
    });

    // Clavier : espace pour lire ou mettre en pause, flèches pour changer de plan.
    onKey = (event) => {
      if ((event.target as HTMLElement).closest('input, textarea, select')) return;
      const chapter = Math.floor((Number(time.dataset.seconds) || 0) / CHAPTER_SECONDS);
      if (event.key === ' ') {
        event.preventDefault();
        toggle();
      } else if (event.key === 'ArrowRight') seek((chapter + 1) * CHAPTER_SECONDS);
      else if (event.key === 'ArrowLeft') seek(Math.max(0, chapter - 1) * CHAPTER_SECONDS);
    };
    window.addEventListener('keydown', onKey);
    // Hors de l'écran, le film se met en pause.
    observer = new IntersectionObserver(([entry]) => {
      if (!entry.isIntersecting && film?.playing) pause();
    });
    observer.observe(root);
  };

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', stop);
</script>
