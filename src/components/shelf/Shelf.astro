---
/**
 * Pile de volumes en 3D et fiche du volume en cours (dessin : src/scripts/shelf.ts).
 * Le défilement parcourt la pile, une entrée par hauteur d'écran. Sans WebGL ou sans
 * JavaScript, les entrées se lisent à la suite.
 */
interface Entry {
  title: string;
  mention: string;
  text: string;
  color: string;
  href?: string;
  cta?: string;
}

interface Props {
  title: string;
  entries: Entry[];
}

const { title, entries } = Astro.props;
const volumes = entries.map(({ title, mention, color }) => ({ title, mention, color }));
---

<section class="shelf" data-shelf data-volumes={JSON.stringify(volumes)} data-step="0">
  <div class="stage">
    <canvas aria-hidden="true"></canvas>
    <h1>{title}</h1>

    <ol class="rail">
      {
        entries.map((entry, index) => (
          <li>
            <button type="button" data-goto={index} aria-label={entry.title} title={entry.title} />
          </li>
        ))
      }
    </ol>

    <ol class="sheets">
      {
        entries.map((entry, index) => (
          <li data-sheet={index} data-on={index === 0 ? '' : undefined}>
            <p class="mention">{entry.mention}</p>
            <h2>{entry.title}</h2>
            <p>{entry.text}</p>
            {entry.href && (
              <a href={entry.href}>
                {entry.cta}
                <svg viewBox="0 0 16 16" aria-hidden="true">
                  <path d="M3 8h10M8.5 3.5 13 8l-4.5 4.5" />
                </svg>
              </a>
            )}
          </li>
        ))
      }
    </ol>
  </div>

  {/* Piste de défilement : un pas par volume */}
  <div class="track" aria-hidden="true">
    {entries.map(() => <div />)}
  </div>
</section>

<style>
  /* Une bibliothèque dans la pénombre : sombre et chaude, dans les deux thèmes. */
  .shelf {
    --nav: 4rem;
    --stage: calc(100svh - var(--nav));

    position: relative;
    background: radial-gradient(120% 90% at 50% 40%, #2a1b1d 0%, #150d0f 70%);
    color: #f1e6cf;
  }

  .stage {
    position: sticky;
    top: var(--nav);
    height: var(--stage);
    overflow: hidden;
  }

  .track {
    margin-top: calc(-1 * var(--stage));
    pointer-events: none;
  }

  .track div {
    height: calc(var(--stage) * 0.8);
  }

  .track div:last-child {
    height: var(--stage);
  }

  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* Écran étroit : un fondu sombre sous la pile, pour que la fiche reste lisible. */
  @media (max-width: 1023px) {
    .stage::after {
      content: '';
      position: absolute;
      inset: 48% 0 0;
      background: linear-gradient(to bottom, transparent, #150d0f 22%);
      pointer-events: none;
    }

    .sheets {
      z-index: 1;
    }
  }

  h1 {
    position: absolute;
    top: 1.5rem;
    left: 1.25rem;
    margin: 0;
    font-size: 0.9rem;
    font-weight: 400;
    letter-spacing: 0;
    color: rgb(241 230 207 / 60%);
    animation: none !important;
  }

  /* Graduations : une par volume, à gauche. */
  .rail {
    position: absolute;
    top: 50%;
    left: 0.25rem;
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    translate: 0 -50%;
  }

  .rail button {
    display: block;
    width: 2.25rem;
    height: 0.8rem;
    cursor: pointer;
  }

  .rail button::before {
    content: '';
    display: block;
    width: 0.6rem;
    height: 1.5px;
    margin-left: 0.75rem;
    background: rgb(241 230 207 / 40%);
    transition:
      width 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      background 0.2s ease;
  }

  .rail button[aria-current]::before {
    width: 1.4rem;
    background: #f1e6cf;
  }

  /* Fiche du volume en cours */
  .sheets {
    position: absolute;
    inset: auto 1.25rem 1.75rem;
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sheets li {
    grid-area: 1 / 1;
    align-self: end;
    max-width: 30rem;
    opacity: 0;
    translate: 0 0.8rem;
    transition:
      opacity 0.35s ease,
      translate 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
  }

  .sheets li[data-on] {
    opacity: 1;
    translate: 0;
    pointer-events: auto;
    transition-delay: 0.12s;
  }

  .mention {
    margin: 0 0 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    color: rgb(241 230 207 / 60%);
  }

  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.4vw, 3.8rem);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.015em;
    color: #f1e6cf;
  }

  .sheets p:not(.mention) {
    margin: 0.9rem 0 0;
    font-size: 1rem;
    line-height: 1.45;
    color: rgb(241 230 207 / 78%);
    text-wrap: pretty;
  }

  .sheets a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.4rem;
    padding: 0.75rem 1.2rem;
    border-radius: 2rem;
    background: #f1e6cf;
    color: #150d0f;
    font-size: 0.92rem;
    font-weight: 500;
    transition: background 0.25s ease;
  }

  .sheets a:hover {
    background: #fff;
  }

  .sheets svg {
    width: 0.85rem;
    height: 0.85rem;
    fill: none;
    stroke: currentcolor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: translate 0.3s ease;
  }

  .sheets a:hover svg {
    translate: 3px 0;
  }

  @media (min-width: 1024px) {
    h1 {
      top: 2rem;
      left: 4rem;
    }

    .rail {
      left: 1.25rem;
    }

    .sheets {
      inset: auto auto 3.5rem 4rem;
    }
  }

  /* Sans JavaScript ou sans WebGL : la liste, simplement. */
  :global(html:not(.js)) .stage,
  .shelf[data-flat] .stage {
    position: static;
    height: auto;
    padding: 5rem 1.25rem;
  }

  :global(html:not(.js)) canvas,
  :global(html:not(.js)) .rail,
  :global(html:not(.js)) .track,
  .shelf[data-flat] canvas,
  .shelf[data-flat] .rail,
  .shelf[data-flat] .track {
    display: none;
  }

  :global(html:not(.js)) :is(h1, .sheets),
  .shelf[data-flat] :is(h1, .sheets) {
    position: static;
    display: block;
  }

  :global(html:not(.js)) .sheets li,
  .shelf[data-flat] .sheets li {
    margin-top: 3rem;
    opacity: 1;
    translate: 0;
    pointer-events: auto;
  }
</style>

<script>
  import type { Shelf, Volume } from '../../scripts/shelf';

  let shelf: Shelf | null = null;
  let onScroll: (() => void) | null = null;

  const stop = () => {
    shelf?.destroy();
    shelf = null;
    if (onScroll) window.removeEventListener('scroll', onScroll);
    onScroll = null;
  };

  const init = async () => {
    stop();
    const root = document.querySelector<HTMLElement>('[data-shelf]');
    const canvas = root?.querySelector('canvas');
    const track = root?.querySelector<HTMLElement>('.track');
    if (!root || !canvas || !track) return;

    const volumes = JSON.parse(root.dataset.volumes ?? '[]') as Volume[];
    const sheets = [...root.querySelectorAll<HTMLElement>('[data-sheet]')];
    const ticks = [...root.querySelectorAll<HTMLButtonElement>('[data-goto]')];
    const last = volumes.length - 1;

    // Les dos sont composés avec les polices du site : on attend qu'elles soient chargées.
    await Promise.all([
      document.fonts.load('400 96px "Instrument Serif"'),
      document.fonts.load('400 32px "Geist Mono Variable"'),
    ]);
    // three.js n'est chargé que sur les pages qui montrent une pile.
    const { mountShelf } = await import('../../scripts/shelf');
    shelf = mountShelf(canvas, volumes);
    if (!shelf) {
      root.setAttribute('data-flat', '');
      return;
    }

    const stepHeight = () => (track.offsetHeight - window.innerHeight) / Math.max(1, last) || 1;
    const top = () => root.getBoundingClientRect().top + window.scrollY;

    onScroll = () => {
      const progress = Math.min(last, Math.max(0, (window.scrollY - top()) / stepHeight()));
      shelf?.setProgress(progress);
      const step = Math.round(progress);
      if (
        root.dataset.step === String(step) &&
        sheets.some((sheet) => sheet.hasAttribute('data-on'))
      )
        return;
      root.dataset.step = String(step);
      sheets.forEach((sheet, index) => sheet.toggleAttribute('data-on', index === step));
      ticks.forEach((tick, index) => tick.toggleAttribute('aria-current', index === step));
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    ticks.forEach((tick) =>
      tick.addEventListener('click', () =>
        window.scrollTo({
          top: top() + Number(tick.dataset.goto) * stepHeight(),
          behavior: 'smooth',
        }),
      ),
    );
    onScroll();
  };

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', stop);
</script>
