---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, orcidUrl } from '../lib/site';
import { getLangFromUrl, useTranslations } from '../lib/i18n';
import profile from '../content/profile/index.json';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const kindLabels = {
  platform: { fr: 'Plateforme', en: 'Platform' },
  data: { fr: 'Données', en: 'Data' },
  tool: { fr: 'Outil', en: 'Tool' },
} as const;
const statusLabels = {
  live: { fr: 'En ligne', en: 'Live' },
  wip: { fr: 'En cours', en: 'In progress' },
  archived: { fr: 'Archivé', en: 'Archived' },
} as const;

// Profil éditable (Keystatic écrit ce JSON), avec repli sur la config du site.
const role = (lang === 'fr' ? profile.roleFr : profile.roleEn) || SITE.role[lang];
const tagline = (lang === 'fr' ? profile.taglineFr : profile.taglineEn) || SITE.tagline[lang];
const bio = (lang === 'fr' ? profile.bioFr : profile.bioEn) || SITE.bio[lang];

// Projets éditables (Keystatic écrit ces JSON) lus au build via Vite, triés par ordre.
type ProjectData = {
  title: string;
  kind: keyof typeof kindLabels;
  status: keyof typeof statusLabels;
  order: number;
  url: string | null;
  summaryFr: string;
  summaryEn: string;
  stack: string[];
};
const projectModules = import.meta.glob<{ default: ProjectData }>('../content/projects/*.json', {
  eager: true,
});
const projects = Object.entries(projectModules)
  .map(([path, mod]) => {
    const p = mod.default;
    return {
      slug: path.split('/').pop()!.replace(/\.json$/, ''),
      title: p.title,
      kind: p.kind,
      status: p.status,
      order: p.order ?? 0,
      url: p.url,
      summary: (lang === 'fr' ? p.summaryFr : p.summaryEn) || '',
      stack: p.stack ?? [],
    };
  })
  .sort((a, b) => a.order - b.order);
---

<BaseLayout description={tagline}>
  {/* Hero */}
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 -z-10 opacity-70 [mask-image:radial-gradient(70%_60%_at_50%_0%,black,transparent)]"
      aria-hidden="true"
    >
      <div
        class="absolute -top-24 left-1/2 size-[42rem] -translate-x-1/2 rounded-full bg-brand-400/25 blur-3xl"
      >
      </div>
    </div>

    <div class="shell pt-20 pb-16 sm:pt-28">
      <p
        class="inline-flex items-center gap-2 rounded-full border border-border bg-surface-2 px-3 py-1 text-xs font-medium text-text-muted"
      >
        <span class="relative flex size-2">
          <span class="absolute inline-flex size-full animate-ping rounded-full bg-brand-500 opacity-75"
          ></span>
          <span class="relative inline-flex size-2 rounded-full bg-brand-500"></span>
        </span>
        {t('hero.availability')}
      </p>

      <h1 class="mt-6 font-display text-4xl font-bold tracking-tight text-balance sm:text-6xl">
        {SITE.name}
      </h1>
      <p class="mt-3 text-lg font-medium text-brand-700 sm:text-xl">{role}</p>
      <p class="mt-5 max-w-2xl text-lg text-text-muted text-pretty">{tagline}</p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href="#projets"
          class="inline-flex items-center gap-2 rounded-lg bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-brand-700"
        >
          {t('hero.cta.projects')}
        </a>
        <a
          href="#contact"
          class="inline-flex items-center gap-2 rounded-lg border border-border px-5 py-2.5 text-sm font-semibold text-text transition-colors hover:bg-surface-2"
        >
          {t('hero.cta.contact')}
        </a>
      </div>

      <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-text-muted">
        <a href={SITE.github} target="_blank" rel="me noopener" class="hover:text-text">GitHub</a>
        <a href={SITE.linkedin} target="_blank" rel="me noopener" class="hover:text-text">LinkedIn</a>
        <a href={orcidUrl} target="_blank" rel="me noopener" class="hover:text-text">ORCID</a>
      </div>
    </div>
  </section>

  {/* À propos */}
  <section id="a-propos" class="scroll-mt-20 border-t border-border/60">
    <div class="shell py-16">
      <h2 class="font-display text-2xl font-bold tracking-tight">{t('nav.about')}</h2>
      <p class="mt-5 max-w-3xl text-lg leading-relaxed text-text-muted text-pretty">{bio}</p>
    </div>
  </section>

  {/* Projets */}
  <section id="projets" class="scroll-mt-20 border-t border-border/60 bg-surface-2/40">
    <div class="shell py-16">
      <div class="max-w-2xl">
        <h2 class="font-display text-2xl font-bold tracking-tight">{t('section.projects.title')}</h2>
        <p class="mt-3 text-text-muted">{t('section.projects.lede')}</p>
      </div>

      <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          projects.map((project) => (
            <li class="group relative flex flex-col rounded-2xl border border-border bg-surface p-6 transition-colors hover:border-brand-400">
              <div class="flex items-center justify-between gap-3">
                <span class="text-xs font-medium tracking-wide text-text-subtle uppercase">
                  {kindLabels[project.kind][lang]}
                </span>
                <span class="rounded-full bg-brand-100 px-2.5 py-0.5 text-xs font-medium text-brand-800">
                  {statusLabels[project.status][lang]}
                </span>
              </div>
              <h3 class="mt-3 font-display text-lg font-semibold">
                {project.url ? (
                  <a href={project.url} target="_blank" rel="noopener" class="after:absolute after:inset-0">
                    {project.title}
                  </a>
                ) : (
                  project.title
                )}
              </h3>
              <p class="mt-2 flex-1 text-sm text-text-muted text-pretty">{project.summary}</p>
              <ul class="mt-4 flex flex-wrap gap-1.5">
                {project.stack.map((tech) => (
                  <li class="rounded-md bg-surface-3 px-2 py-0.5 font-mono text-xs text-text-muted">
                    {tech}
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* Publications */}
  <section id="publications" class="scroll-mt-20 border-t border-border/60">
    <div class="shell py-16">
      <h2 class="font-display text-2xl font-bold tracking-tight">{t('nav.publications')}</h2>
      <p class="mt-4 max-w-2xl text-text-muted">
        Liste synchronisée depuis ORCID (à brancher en Phase 2).{' '}
        <a href={orcidUrl} target="_blank" rel="me noopener" class="text-brand-700 underline-offset-4 hover:underline">
          Profil ORCID {SITE.orcid}
        </a>.
      </p>
    </div>
  </section>

  {/* Contact */}
  <section id="contact" class="scroll-mt-20 border-t border-border/60 bg-surface-2/40">
    <div class="shell py-16">
      <h2 class="font-display text-2xl font-bold tracking-tight">{t('nav.contact')}</h2>
      <p class="mt-4 max-w-2xl text-text-muted">{SITE.location[lang]}.</p>
      <a
        href={`mailto:${SITE.email}`}
        class="mt-5 inline-flex items-center gap-2 rounded-lg bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brand-700"
      >
        {SITE.email}
      </a>
    </div>
  </section>
</BaseLayout>
